<ui:FluentWindow
    x:Class="DeepVisionSharp.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Views.Controls"
    xmlns:pages="clr-namespace:DeepVisionSharp.Shell.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="1600"
    Height="1000"
    MinWidth="1100"
    MinHeight="720"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <Style
            x:Key="TitleBarActionButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="{x:Type ui:Button}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Path=ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="PressedForeground" Value="{Binding Path=ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="MouseOverBackground" Value="{Binding Path=ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="MouseOverBorderBrush" Value="Transparent" />
            <Setter Property="PressedBackground" Value="{Binding Path=ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="PressedBorderBrush" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="MainTitleBar"
            Grid.Row="0"
            Height="44"
            HorizontalContentAlignment="Center"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="26"
                        Height="26"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="/DeepVisionSharp;component/Resources/logo.png"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}" />
                </StackPanel>
            </ui:TitleBar.Header>

            <ui:TitleBar.CenterContent>
                <TextBlock
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    AutomationProperties.AutomationId="dv.title.project-name"
                    Text="{Binding CurrentProjectName}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentProject}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ui:TitleBar.CenterContent>

            <ui:TitleBar.TrailingContent>
                <StackPanel Margin="0" Orientation="Horizontal">
                    <ui:Button
                        x:Name="ThemeToggleButton"
                        Click="ToggleThemeMode"
                        Style="{StaticResource TitleBarActionButtonStyle}"
                        ToolTipService.ToolTip="切换到深色模式">
                        <ui:SymbolIcon
                            x:Name="ThemeToggleIcon"
                            FontSize="16"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                            Symbol="WeatherMoon24" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleVisible="True"
            OpenPaneLength="160"
            PaneDisplayMode="LeftMinimal">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="dv.nav.dashboard"
                    Content="项目"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="dv.nav.gallery"
                    Content="图库"
                    Icon="{ui:SymbolIcon Image24}"
                    TargetPageType="{x:Type pages:GalleryPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="dv.nav.labeling"
                    Content="标记"
                    Icon="{ui:SymbolIcon TagMultiple24}"
                    TargetPageType="{x:Type pages:LabelingPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="dv.nav.models"
                    Content="模型"
                    Icon="{ui:SymbolIcon Database24}"
                    TargetPageType="{x:Type pages:ModelsPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="dv.nav.training"
                    Content="训练"
                    Icon="{ui:SymbolIcon Play24}"
                    TargetPageType="{x:Type pages:TrainingPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="dv.nav.inference"
                    Content="推理"
                    Icon="{ui:SymbolIcon Flash24}"
                    TargetPageType="{x:Type pages:InferencePage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="dv.nav.settings"
                    Content="设置"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:SnackbarPresenter
            x:Name="RootSnackbarPresenter"
            Grid.RowSpan="2"
            Panel.ZIndex="100" />

        <ui:ContentDialogHost
            x:Name="RootContentDialogHost"
            Grid.RowSpan="2"
            Panel.ZIndex="200" />

        <controls:TaskCenterPanel
            x:Name="ShellTaskCenter"
            Grid.RowSpan="2"
            Panel.ZIndex="90" />
    </Grid>
</ui:FluentWindow>
