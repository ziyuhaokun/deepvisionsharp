<!-- 契约: docs/shell-chrome-contract.md §3/§4（宿主挂载 + MainWindow 命名元素 + 导航表）| 转换: FluentWindow → dvsui:ThemedWindow（自绘 52 标题栏）、原标题栏的中央/尾部内容下移到 40 高工具条行、NavigationView → 168 宽侧栏 ListBox、SnackbarPresenter/ContentDialogHost → SnackbarLayer/DialogLayer -->
<dvsui:ThemedWindow
    x:Class="DeepVisionSharp.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="clr-namespace:DeepVisionSharp.Presentation.Services.Navigation;assembly=DeepVisionSharp.Presentation"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    Title="{Binding Title}"
    Width="1600"
    Height="1000"
    MinWidth="1100"
    MinHeight="720"
    Background="{DynamicResource IvBackgroundBrush}"
    Icon="/DeepVisionSharp;component/Resources/logo.png"
    WindowStartupLocation="CenterScreen"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!--
        三段布局：标题栏（ThemedWindow 模板自绘，52 高）→ 应用工具条（40 高：项目名居中 + 主题切换）→ 主体（侧栏 + 内容区）。
        浮层三层叠在整窗之上：任务中心 90 < 提示条 100 < 对话框 200。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 应用工具条：原标题栏的 CenterContent（项目名）与 TrailingContent（主题切换）落在这里 -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource IvSurface1Brush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="dv.title.project-name"
                    FontSize="{DynamicResource IvFontSizeBodySmall}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource IvText1Brush}"
                    Text="{Binding CurrentProjectName}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentProject}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button
                    x:Name="ThemeToggleButton"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="ToggleThemeMode"
                    Style="{StaticResource IvIconButtonStyle}"
                    ToolTipService.ToolTip="切换到深色模式">
                    <dvsui:Icon
                        x:Name="ThemeToggleIcon"
                        Data="{x:Static dvsui:IvIcons.Sparkles}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        ViewSize="16" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏：固定展开，不做折叠（契约 §5.4）；设置项用 DockPanel 面板停靠到底部 -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource IvSurface1Brush}"
                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                BorderThickness="0,0,1,0">
                <ListBox
                    x:Name="NavList"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="OnNavSelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <DockPanel LastChildFill="False" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBoxItem
                        DockPanel.Dock="Top"
                        AutomationProperties.AutomationId="dv.nav.dashboard"
                        Style="{StaticResource IvSidebarItemStyle}"
                        Tag="{x:Static nav:AppRoute.Dashboard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dvsui:Icon VerticalAlignment="Center" Data="{x:Static dvsui:IvIcons.Home}" ViewSize="16" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="项目"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem
                        DockPanel.Dock="Top"
                        AutomationProperties.AutomationId="dv.nav.gallery"
                        Style="{StaticResource IvSidebarItemStyle}"
                        Tag="{x:Static nav:AppRoute.Gallery}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dvsui:Icon VerticalAlignment="Center" Data="{x:Static dvsui:IvIcons.Images}" ViewSize="16" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="图库"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem
                        DockPanel.Dock="Top"
                        AutomationProperties.AutomationId="dv.nav.labeling"
                        Style="{StaticResource IvSidebarItemStyle}"
                        Tag="{x:Static nav:AppRoute.Labeling}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dvsui:Icon VerticalAlignment="Center" Data="{x:Static dvsui:IvIcons.Bookmark}" ViewSize="16" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="标记"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem
                        DockPanel.Dock="Top"
                        AutomationProperties.AutomationId="dv.nav.models"
                        Style="{StaticResource IvSidebarItemStyle}"
                        Tag="{x:Static nav:AppRoute.Models}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dvsui:Icon VerticalAlignment="Center" Data="{x:Static dvsui:IvIcons.Grid}" ViewSize="16" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="模型"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem
                        DockPanel.Dock="Top"
                        AutomationProperties.AutomationId="dv.nav.training"
                        Style="{StaticResource IvSidebarItemStyle}"
                        Tag="{x:Static nav:AppRoute.Training}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dvsui:Icon VerticalAlignment="Center" Data="{x:Static dvsui:IvIcons.Play}" ViewSize="16" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="训练"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem
                        DockPanel.Dock="Top"
                        AutomationProperties.AutomationId="dv.nav.inference"
                        Style="{StaticResource IvSidebarItemStyle}"
                        Tag="{x:Static nav:AppRoute.Inference}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dvsui:Icon VerticalAlignment="Center" Data="{x:Static dvsui:IvIcons.Bolt}" ViewSize="16" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="推理"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem
                        AutomationProperties.AutomationId="dv.nav.settings"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource IvSidebarItemStyle}"
                        Tag="{x:Static nav:AppRoute.Settings}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dvsui:Icon VerticalAlignment="Center" Data="{x:Static dvsui:IvIcons.Settings}" ViewSize="16" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="设置"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- 页面内容区：IPageHost.Show 把页面实例放进这里。
                 必须是 Frame：页面类型是 Page，WPF 规定 Page 只能由 Window 或 Frame 做父级
                 （旧 WPF-UI 的 NavigationView 内部就是一个 Frame，换成 ContentControl 会抛
                 "Page can have only Window or Frame as parent"）。 -->
            <Frame
                x:Name="PageHost"
                Grid.Column="1"
                Focusable="False"
                JournalOwnership="OwnsJournal"
                NavigationUIVisibility="Hidden"
                SandboxExternalContent="False" />
        </Grid>

        <!-- 任务中心（原样保留：名称与 ZIndex 不变） -->
        <controls:TaskCenterPanel
            x:Name="ShellTaskCenter"
            Grid.RowSpan="2"
            Panel.ZIndex="90" />

        <!-- 提示条浮层：ISnackbarHost，右下角、不参与命中测试 -->
        <Border
            x:Name="SnackbarLayer"
            Grid.RowSpan="2"
            MaxWidth="420"
            Margin="0,0,20,20"
            Padding="14,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="100"
            Background="{DynamicResource IvPopupBrush}"
            BorderBrush="{DynamicResource IvStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusOverlay}"
            Effect="{StaticResource IvPopupShadow}"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <dvsui:Icon
                    x:Name="SnackbarIcon"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    Data="{x:Static dvsui:IvIcons.Info}"
                    Foreground="{DynamicResource IvInfoBrush}"
                    ViewSize="16" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock
                        x:Name="SnackbarTitle"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IvText1Brush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SnackbarMessage"
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource IvText2Brush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 对话框浮层：IDialogHost，遮罩与卡片由 dvsui:Dialog 自己的模板画 -->
        <Grid
            x:Name="DialogLayer"
            Grid.RowSpan="2"
            Panel.ZIndex="200"
            Visibility="Collapsed">
            <dvsui:Dialog x:Name="ShellDialog" />
        </Grid>
    </Grid>
</dvsui:ThemedWindow>
