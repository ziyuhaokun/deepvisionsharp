<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Controls.TaskCenterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DeepVisionSharp.Presentation.ViewModels;assembly=DeepVisionSharp.Presentation"
    xmlns:yu="http://schemas.yu-ui/xaml"
    d:DesignHeight="420"
    d:DesignWidth="400"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="TaskStatusDotStyle" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource IvText3Brush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource IvAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource IvSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource IvDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TaskStatusBadgeStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource IvSurface3Brush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Background" Value="{StaticResource StatusRunningTintBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                        <Setter Property="Background" Value="{StaticResource StatusSucceededTintBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Background" Value="{StaticResource StatusFailedTintBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TaskStatusBadgeTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeSmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource IvAccentTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource IvSuccessTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource IvDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                源 TaskIconButtonStyle 基于 WPF-UI 隐式 Button + Appearance="Transparent"。
                yu-ui 里 Appearance=Transparent 对应 IvSubtleButtonStyle（透明底 + 透明描边，hover 只叠 IvStateHoverBrush 层）。
                底模的 MinHeight=IvControlHeight(30) 会压过显式 Height=28，故显式归零保留原 30×28 占位。
            -->
            <Style
                x:Key="TaskIconButtonStyle"
                BasedOn="{StaticResource IvSubtleButtonStyle}"
                TargetType="{x:Type Button}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Margin="0,0,18,18"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Visibility="{Binding HasVisibleTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
        <!-- 浮层外壳按 HUD 语义：IvPopupBrush 底 + IvStrokeBrush 描边 + IvRadiusOverlay 圆角 + IvPopupShadow 阴影 -->
        <Border
            MinWidth="300"
            MaxWidth="380"
            Background="{DynamicResource IvPopupBrush}"
            BorderBrush="{DynamicResource IvStrokeBrush}"
            BorderThickness="{DynamicResource IvStrokeThickness}"
            CornerRadius="{DynamicResource IvRadiusOverlay}"
            Effect="{StaticResource IvPopupShadow}"
            SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header bar (always visible when tasks exist) -->
                <!--
                    源用 CornerRadius 12,12,0,0 ↔ 12 在展开/收起两态间切换；IvRadiusOverlay=4 两态取值相同
                    （收起态整块就是这条 header，四角本就要圆；展开态下沿紧贴同一底色系的列表，圆角无可见差异），
                    因此这里只留一个令牌值。
                -->
                <Border
                    Grid.Row="0"
                    Padding="12,10"
                    Background="{DynamicResource IvBandBrush}"
                    CornerRadius="{DynamicResource IvRadiusOverlay}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleExpandedCommand}"
                            Cursor="Hand"
                            Focusable="False"
                            HorizontalContentAlignment="Left"
                            Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource IvControlFillBrush}"
                                    CornerRadius="8">
                                    <!-- 源 SymbolIcon TaskListSquareLtr24 → IvIcons.List -->
                                    <yu:Icon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{x:Static yu:IvIcons.List}"
                                        ViewSize="{DynamicResource IvIconSize}" />
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="{DynamicResource IvFontSizeBodySmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource IvText1Brush}"
                                        Text="后台任务" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="{DynamicResource IvFontSizeSmall}"
                                        Foreground="{DynamicResource IvText2Brush}"
                                        Text="{Binding HeaderSummary}" />
                                </StackPanel>

                                <Border
                                    Margin="10,0,0,0"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource StatusRunningTintBrush}"
                                    CornerRadius="10"
                                    Visibility="{Binding HasRunningTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource IvAccentBrush}" />
                                        <TextBlock
                                            FontSize="{DynamicResource IvFontSizeSmall}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource IvAccentTextBrush}"
                                            Text="{Binding RunningTaskCount, StringFormat={}{0} 运行中}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleExpandedCommand}"
                            Style="{StaticResource TaskIconButtonStyle}"
                            ToolTip="{Binding ExpandToggleToolTip}">
                            <!-- 源按钮 Icon 属性（SymbolIcon ChevronUp24，收起态 ChevronDown24）→ yu:Icon 的 Data 触发器 -->
                            <yu:Icon ViewSize="{DynamicResource IvIconSize}">
                                <yu:Icon.Style>
                                    <!-- 元素级 Style 不设 Template，BasedOn 取 yu-ui 的默认样式（Controls/Icon.xaml，随 YuUiTheme 一起 merge） -->
                                    <Style BasedOn="{StaticResource {x:Type yu:Icon}}" TargetType="{x:Type yu:Icon}">
                                        <Setter Property="Data" Value="{x:Static yu:IvIcons.ChevronUp}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Data" Value="{x:Static yu:IvIcons.ChevronDown}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </yu:Icon.Style>
                            </yu:Icon>
                        </Button>
                    </Grid>
                </Border>

                <!-- Task list -->
                <Border
                    Grid.Row="1"
                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer
                        MaxHeight="300"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackgroundTaskRowViewModel}">
                                    <Border
                                        Padding="12,10"
                                        BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <DockPanel LastChildFill="True" Margin="0,0,8,0">
                                                    <Border
                                                        DockPanel.Dock="Left"
                                                        Style="{StaticResource TaskStatusDotStyle}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="{DynamicResource IvFontSizeBodySmall}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource IvText1Brush}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Title}" />
                                                </DockPanel>

                                                <Border
                                                    Grid.Column="1"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource TaskStatusBadgeStyle}">
                                                    <TextBlock
                                                        Style="{StaticResource TaskStatusBadgeTextStyle}"
                                                        Text="{Binding StatusText}" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="2"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        Command="{Binding DataContext.ToggleTaskExpandedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TaskIconButtonStyle}"
                                                        ToolTip="查看日志">
                                                        <!-- 源按钮 Icon 属性（SymbolIcon ChevronDown24，展开态 ChevronUp24）→ yu:Icon 的 Data 触发器 -->
                                                        <yu:Icon ViewSize="{DynamicResource IvIconSize}">
                                                            <yu:Icon.Style>
                                                                <Style BasedOn="{StaticResource {x:Type yu:Icon}}" TargetType="{x:Type yu:Icon}">
                                                                    <Setter Property="Data" Value="{x:Static yu:IvIcons.ChevronDown}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Data" Value="{x:Static yu:IvIcons.ChevronUp}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </yu:Icon.Style>
                                                        </yu:Icon>
                                                    </Button>
                                                    <Button
                                                        Command="{Binding DataContext.DismissTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TaskIconButtonStyle}"
                                                        ToolTip="关闭">
                                                        <!-- 源按钮 Icon 属性（SymbolIcon Dismiss24）→ IvIcons.Close -->
                                                        <yu:Icon Data="{x:Static yu:IvIcons.Close}" ViewSize="{DynamicResource IvIconSize}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <Border
                                                Margin="16,8,0,0"
                                                Padding="10,8"
                                                Background="{DynamicResource IvBandBrush}"
                                                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                                BorderThickness="{DynamicResource IvStrokeThickness}"
                                                CornerRadius="8"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ScrollViewer
                                                    MaxHeight="160"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding LogLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="0,1"
                                                                    FontFamily="{DynamicResource IvMonoFontFamily}"
                                                                    FontSize="{DynamicResource IvFontSizeSmall}"
                                                                    Foreground="{DynamicResource IvText2Brush}"
                                                                    Text="{Binding}"
                                                                    TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
