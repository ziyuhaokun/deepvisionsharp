<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="clr-namespace:DeepVisionSharp.Shell.Views.Labeling.Cards"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 图像分类专用 ToolRail：Edit(导入/移动/自动推理) + ClassList（点选即整图分类） -->
    <DataTemplate x:Key="LabelingToolRail.Classification">
        <ScrollViewer
            Padding="8"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <cards:LabelingEditActionsCard ShowAutoInference="True" />
                <cards:LabelingClassListCard />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- 右栏：分类项目留空（鸟瞰在壳上） -->
    <DataTemplate x:Key="LabelingSideRail.Empty">
        <Grid />
    </DataTemplate>
</ResourceDictionary>
