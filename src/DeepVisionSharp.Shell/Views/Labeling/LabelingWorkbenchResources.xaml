<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Labeling/LabelingWorkbench 资源字典 | 转换: WPF-UI Card→ContentControl+IvCardStyle；WPF-UI Button 的 Appearance 映射（Transparent→IvSubtleButtonStyle，图标按钮→IvIconButtonStyle 派生，Primary→IvPrimaryBrush/IvTextOnPrimaryBrush 触发器）；SymbolIcon→dvsui:Icon+ViewSize；颜色/字号/圆角走 Iv* 令牌；删除 implicit TextBlock 样式（docs/DeepVisionSharp.UI-migration.md §1） -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">

    <!--
      DeepVisionSharp.UI 主题（令牌 + 样式）在本字典自持一份：本字典里的 BasedOn / 刷子引用都要在本字典作用域内可解析。
      各视图根元素另各 merge 一次，作用域仍是各自页面，不影响未迁移的页面。
    -->
    <ResourceDictionary.MergedDictionaries>
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

    <!--
      文字基线（FontFamily / FontSize / Foreground）由各视图根元素声明后靠继承传递。
      这里刻意不写 implicit TextBlock 样式：它会压掉控件级字号与主按钮白字（docs/DeepVisionSharp.UI-migration.md §1）。
    -->

    <!-- 源 WPF-UI Card（工作台卡片壳）：改用 IvCardStyle，内边距/外边距归零交给内容自己控制 -->
    <Style
        x:Key="WorkbenchCardStyle"
        BasedOn="{StaticResource IvCardStyle}"
        TargetType="{x:Type ContentControl}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="PanelHeaderStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="PanelTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
    </Style>

    <Style x:Key="ToolSectionStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
    </Style>

    <Style x:Key="LabelHotkeyBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- 源 CornerRadius=4，与 IvRadiusOverlay(4) 等值 -->
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
    </Style>

    <!-- 源 WPF-UI Button + Appearance=Transparent 的纯图标按钮 → IvIconButtonStyle 派生，尺寸沿用源（38×34） -->
    <Style
        x:Key="IconButtonStyle"
        BasedOn="{StaticResource IvIconButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style
        x:Key="ToolIconButtonStyle"
        BasedOn="{StaticResource IconButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="42" />
    </Style>

    <Style
        x:Key="FloatingIconButtonStyle"
        BasedOn="{StaticResource IconButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="36" />
    </Style>

    <Style x:Key="EmptyAnnotationsStyle" TargetType="{x:Type Border}">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Editor.HasBoxes}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
      源 Appearance="Secondary" + DataTrigger 切 Appearance="Primary"。
      DeepVisionSharp.UI 没有 Appearance 属性，选中态直接落成 Primary 令牌（底/描边 IvPrimaryBrush、字 IvTextOnPrimaryBrush）。
    -->
    <Style
        x:Key="SelectToolButtonStyle"
        BasedOn="{StaticResource ToolIconButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="ToolTip" Value="选择工具：移动 / 缩放已选框" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Editor.IsSelectTool}" Value="True">
                <Setter Property="Background" Value="{DynamicResource IvPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvTextOnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="RectangleToolButtonStyle"
        BasedOn="{StaticResource ToolIconButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="ToolTip" Value="矩形工具：拖拽画框（先在类别列表选类别）" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Editor.IsRectangleTool}" Value="True">
                <Setter Property="Background" Value="{DynamicResource IvPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvTextOnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SampleTileStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IvText3Brush}" />
            </Trigger>
            <!-- 选中色沿用源硬编码的品牌蓝，不走 Iv 令牌（docs/DeepVisionSharp.UI-migration.md §4 组 3） -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="BorderBrush" Value="#3B82F6" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="#0D3B82F6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SampleIndexBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="4,0" />
        <!-- 源 CornerRadius=4，与 IvRadiusOverlay(4) 等值 -->
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
        <Setter Property="Background" Value="#CC0F172A" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#E63B82F6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SampleProgressBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="8,3" />
        <!-- 源 CornerRadius=10 是胶囊形，Iv 令牌里没有对应值，保留字面量 -->
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#2622C55E" />
    </Style>

    <Style
        x:Key="SamplePageNavButtonStyle"
        BasedOn="{StaticResource FloatingIconButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
    </Style>

    <Style
        x:Key="SampleNavButtonStyle"
        BasedOn="{StaticResource FloatingIconButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
    </Style>

    <!--
      源用 Setter Property="Icon" 挂 SymbolIcon 并按 IsSamplePanelExpanded 换图标。
      DeepVisionSharp.UI 的 Button 没有 Icon 属性，图标改由使用处的 dvsui:Icon 自带 DataTrigger 切换；
      本样式只保留随展开状态变化的 ToolTip。
    -->
    <Style
        x:Key="SamplePanelToggleButtonStyle"
        BasedOn="{StaticResource SampleNavButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="ToolTip" Value="展开样本列表" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Samples.IsSamplePanelExpanded}" Value="True">
                <Setter Property="ToolTip" Value="收起样本列表" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
