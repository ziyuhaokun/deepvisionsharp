<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Labeling/Cards/LabelingEditActionsCard.axaml | 转换: WPF-UI Button+SymbolIcon→Button+ToolIconButtonStyle（IvIconButtonStyle 派生）+yu:Icon；Sparkle24→Sparkles；颜色/字号走 Iv* 令牌 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Labeling.Cards.LabelingEditActionsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yu="http://schemas.yu-ui/xaml"
    d:DesignHeight="200"
    d:DesignWidth="280"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource ToolSectionStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="编辑" />
            <WrapPanel Margin="0,6,0,0">
                <Button
                    Margin="0,0,6,6"
                    AutomationProperties.AutomationId="dv.labeling.import-images"
                    Command="{Binding Samples.ImportImagesCommand}"
                    IsEnabled="{Binding Samples.CanImportImages}"
                    Style="{StaticResource ToolIconButtonStyle}"
                    ToolTip="导入图像"
                    Visibility="{Binding ShowImport, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- 源 SymbolIcon ArrowUpload24 在 IvIcons 里没有等价几何，降级为 ArrowUp -->
                    <yu:Icon Data="{x:Static yu:IvIcons.ArrowUp}" ViewSize="{DynamicResource IvIconSize}" />
                </Button>
                <Button
                    Margin="0,0,6,6"
                    Command="{Binding Samples.ShowMoveSamplesDialogCommand}"
                    IsEnabled="{Binding Samples.CanMoveSelectedSamples}"
                    Style="{StaticResource ToolIconButtonStyle}"
                    ToolTip="移动到其他图库（默认当前图；勾选后迁移勾选的样本）"
                    Visibility="{Binding ShowMove, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- 源 SymbolIcon FolderArrowRight24 → IvIcons.FolderOpen（近义降级：少了出向箭头） -->
                    <yu:Icon Data="{x:Static yu:IvIcons.FolderOpen}" ViewSize="{DynamicResource IvIconSize}" />
                </Button>
                <Button
                    Margin="0,0,6,6"
                    Command="{Binding Inference.RunAutoInferenceCommand}"
                    IsEnabled="{Binding Inference.CanOpenInferenceDialog}"
                    ToolTip="{Binding Inference.InferenceButtonToolTip}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource ToolIconButtonStyle}" TargetType="{x:Type Button}">
                            <Setter Property="Visibility" Value="{Binding Inference.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAutoInference, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu
                            DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem
                                Command="{Binding Inference.ShowAutoInferenceDialogCommand}"
                                Header="配置推理参数..." />
                            <MenuItem
                                Command="{Binding Inference.RunInferenceDebugCommand}"
                                Header="调试推理报告..." />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <!-- 源 SymbolIcon Sparkle24 → IvIcons.Sparkles（直接等价） -->
                    <yu:Icon Data="{x:Static yu:IvIcons.Sparkles}" ViewSize="{DynamicResource IvIconSize}" />
                </Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
