<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Labeling.Cards.LabelingEditActionsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="200"
    d:DesignWidth="280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource ToolSectionStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="编辑" />
            <WrapPanel Margin="0,6,0,0">
                <ui:Button
                    Margin="0,0,6,6"
                    Appearance="Secondary"
                    AutomationProperties.AutomationId="dv.labeling.import-images"
                    Command="{Binding Samples.ImportImagesCommand}"
                    Icon="{ui:SymbolIcon ArrowUpload24}"
                    IsEnabled="{Binding Samples.CanImportImages}"
                    Style="{StaticResource ToolIconButtonStyle}"
                    ToolTip="导入图像"
                    Visibility="{Binding ShowImport, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button
                    Margin="0,0,6,6"
                    Appearance="Secondary"
                    Command="{Binding Samples.ShowMoveSamplesDialogCommand}"
                    Icon="{ui:SymbolIcon FolderArrowRight24}"
                    IsEnabled="{Binding Samples.CanMoveSelectedSamples}"
                    Style="{StaticResource ToolIconButtonStyle}"
                    ToolTip="移动到其他图库（默认当前图；勾选后迁移勾选的样本）"
                    Visibility="{Binding ShowMove, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button
                    Margin="0,0,6,6"
                    Appearance="Secondary"
                    Command="{Binding Inference.RunAutoInferenceCommand}"
                    Icon="{ui:SymbolIcon Sparkle24}"
                    IsEnabled="{Binding Inference.CanOpenInferenceDialog}"
                    ToolTip="{Binding Inference.InferenceButtonToolTip}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource ToolIconButtonStyle}" TargetType="{x:Type ui:Button}">
                            <Setter Property="Visibility" Value="{Binding Inference.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAutoInference, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:Button.ContextMenu>
                        <ContextMenu
                            DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem
                                Command="{Binding Inference.ShowAutoInferenceDialogCommand}"
                                Header="配置推理参数..." />
                            <MenuItem
                                Command="{Binding Inference.RunInferenceDebugCommand}"
                                Header="调试推理报告..." />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
