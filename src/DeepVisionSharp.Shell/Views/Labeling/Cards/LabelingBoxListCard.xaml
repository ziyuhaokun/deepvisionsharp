<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Labeling/Cards/LabelingBoxListCard.axaml | 转换: WPF-UI Button+SymbolIcon→Button+yu:Icon（纯图标走 IconButtonStyle）；Square24→Shape、Eraser24→Close；颜色/字号/圆角走 Iv* 令牌（选中态品牌蓝沿用源硬编码常量） -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Labeling.Cards.LabelingBoxListCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yu="http://schemas.yu-ui/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    d:DesignHeight="600"
    d:DesignWidth="340"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + count + clear -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="标注列表" />
            <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="7,2"
                VerticalAlignment="Center"
                Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                CornerRadius="{DynamicResource IvRadiusOverlay}">
                <TextBlock
                    AutomationProperties.AutomationId="dv.labeling.box-count"
                    FontSize="{DynamicResource IvFontSizeSmall}"
                    FontWeight="SemiBold"
                    Text="{Binding Editor.BoxCount, StringFormat={}{0} 个}" />
            </Border>
            <Button
                Grid.Column="2"
                Margin="4,0,0,0"
                AutomationProperties.AutomationId="dv.labeling.box.clear-top"
                Command="{Binding Editor.ClearBoxesCommand}"
                IsEnabled="{Binding Editor.HasBoxes}"
                Style="{StaticResource IconButtonStyle}"
                ToolTip="清空当前样本的所有框">
                <!-- 源 SymbolIcon Eraser24 在 IvIcons 里没有等价几何，降级为 Close -->
                <yu:Icon Data="{x:Static yu:IvIcons.Close}" ViewSize="{DynamicResource IvIconSize}" />
            </Button>
        </Grid>

        <!-- List -->
        <Border
            Grid.Row="1"
            Padding="6"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource IvRadiusOverlay}">
            <Grid>
                <ScrollViewer
                    CanContentScroll="True"
                    HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalOnly"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding Editor.HasBoxes, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl
                        AutomationProperties.AutomationId="dv.labeling.box-list"
                        ItemsSource="{Binding Editor.Boxes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnRowClicked">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1A3B82F6" />
                                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="4"
                                            Margin="0,1,0,1"
                                            Background="{Binding Color}"
                                            CornerRadius="{DynamicResource IvRadiusSmall}" />

                                        <Border
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding Color}"
                                            CornerRadius="10">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource IvFontSizeMini}"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding NumberText}" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IvText1Brush}"
                                                Text="{Binding Label}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="{DynamicResource IvFontSizeSmall}"
                                                Foreground="{DynamicResource IvText2Brush}"
                                                Text="{Binding CoordinatesText}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="dv.labeling.box.remove"
                                            Command="{Binding DataContext.Editor.DeleteBoxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="删除此目标">
                                            <yu:Icon Data="{x:Static yu:IvIcons.Delete}" ViewSize="{DynamicResource IvIconSize}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border
                    Padding="16"
                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource IvRadiusOverlay}"
                    Style="{StaticResource EmptyAnnotationsStyle}">
                    <Border BorderBrush="Transparent" BorderThickness="0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 源 SymbolIcon Square24 → IvIcons.Shape（近义降级：实心方块变四角点框） -->
                            <yu:Icon
                                HorizontalAlignment="Center"
                                Data="{x:Static yu:IvIcons.Shape}"
                                Foreground="{DynamicResource IvText3Brush}"
                                ViewSize="26" />
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource MutedTextStyle}"
                                Text="还没有标注" />
                            <TextBlock
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource IvFontSizeSmall}"
                                Foreground="{DynamicResource IvText3Brush}"
                                TextWrapping="Wrap"
                                Text="在左侧选择类别后，拖拽画框"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- Footer: review state -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource MutedTextStyle}"
                Text="滚轮缩放 · 中键平移 · Delete 键删除" />
            <TextBlock
                Grid.Column="1"
                AutomationProperties.AutomationId="dv.labeling.box.review-state"
                FontSize="{DynamicResource IvFontSizeSmall}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource IvText2Brush}"
                Text="{Binding Editor.DetectionStatusText}" />
        </Grid>
    </Grid>
</UserControl>
