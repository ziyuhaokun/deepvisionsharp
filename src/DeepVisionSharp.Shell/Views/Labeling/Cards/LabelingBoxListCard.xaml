<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Labeling.Cards.LabelingBoxListCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    d:DesignHeight="500"
    d:DesignWidth="340"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8">
        <Grid Margin="0,0,0,8">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="目标列表" />
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource MutedTextStyle}"
                Text="{Binding Editor.BoxCount, StringFormat={}{0} 个}" />
        </Grid>

        <TextBlock
            Margin="2,4,2,8"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="画框后在此查看；点击行可选中，Delete 删除。"
            TextWrapping="Wrap"
            Visibility="{Binding Editor.HasBoxes, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <ItemsControl AutomationProperties.AutomationId="dv.labeling.box-list" ItemsSource="{Binding Editor.Boxes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,4"
                        Padding="6"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="4"
                                Margin="0,2,0,2"
                                Background="{Binding Color}"
                                CornerRadius="2" />

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Label}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="{Binding CoordinatesText}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Transparent"
                                    AutomationProperties.AutomationId="dv.labeling.box.select"
                                    Command="{Binding DataContext.Editor.SelectBoxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon Checkmark24}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="选中此目标" />
                                <ui:Button
                                    Margin="4,0,0,0"
                                    Appearance="Transparent"
                                    AutomationProperties.AutomationId="dv.labeling.box.remove"
                                    Command="{Binding DataContext.Editor.DeleteBoxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="删除此目标" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
