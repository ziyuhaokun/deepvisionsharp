<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Labeling/Cards/LabelingDetectionToolsCard.axaml | 转换: WPF-UI Button+SymbolIcon→Button+dvsui:Icon（图标按钮走 IconButtonStyle/IvIconButtonStyle 派生，主按钮走 IvPrimaryButtonStyle）；CursorHover24→Pointer、Square24→Shape；颜色/字号走 Iv* 令牌 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Labeling.Cards.LabelingDetectionToolsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    d:DesignHeight="300"
    d:DesignWidth="280"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Drawing mode -->
        <Border Style="{StaticResource ToolSectionStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="标注模式" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <Button
                        AutomationProperties.AutomationId="dv.labeling.tool.select"
                        Command="{Binding Editor.SetSelectToolCommand}"
                        Style="{StaticResource SelectToolButtonStyle}">
                        <dvsui:Icon Data="{x:Static dvsui:IvIcons.Pointer}" ViewSize="{DynamicResource IvIconSize}" />
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="dv.labeling.tool.rectangle"
                        Command="{Binding Editor.SetRectangleToolCommand}"
                        Style="{StaticResource RectangleToolButtonStyle}">
                        <!-- 源 SymbolIcon Square24 → IvIcons.Shape（近义降级：实心方块变四角点框） -->
                        <dvsui:Icon Data="{x:Static dvsui:IvIcons.Shape}" ViewSize="{DynamicResource IvIconSize}" />
                    </Button>
                </StackPanel>
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource MutedTextStyle}"
                    Text="矩形：拖拽画框；选择：移动/缩放已选框。滚轮缩放，中键平移。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Editing actions -->
        <Border Style="{StaticResource ToolSectionStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="标注操作" />
                    <Border
                        Grid.Column="1"
                        Padding="6,2"
                        Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                        CornerRadius="{DynamicResource IvRadiusOverlay}">
                        <TextBlock
                            AutomationProperties.AutomationId="dv.labeling.detection.status"
                            FontSize="{DynamicResource IvFontSizeSmall}"
                            FontWeight="SemiBold"
                            Text="{Binding Editor.DetectionStatusText}" />
                    </Border>
                </Grid>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button
                        AutomationProperties.AutomationId="dv.labeling.box.undo"
                        Command="{Binding Editor.UndoBoxEditCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="撤销 (Ctrl+Z)">
                        <!-- 源 SymbolIcon ArrowUndo24 在 IvIcons 里没有等价几何，降级为 ChevronLeft -->
                        <dvsui:Icon Data="{x:Static dvsui:IvIcons.ChevronLeft}" ViewSize="{DynamicResource IvIconSize}" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="dv.labeling.box.redo"
                        Command="{Binding Editor.RedoBoxEditCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="重做 (Ctrl+Y)">
                        <!-- 源 SymbolIcon ArrowRedo24 在 IvIcons 里没有等价几何，降级为 ChevronRight -->
                        <dvsui:Icon Data="{x:Static dvsui:IvIcons.ChevronRight}" ViewSize="{DynamicResource IvIconSize}" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="dv.labeling.box.delete"
                        Command="{Binding Editor.DeleteSelectedBoxCommand}"
                        IsEnabled="{Binding Editor.HasSelectedBox}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="删除选中框 (Delete)">
                        <dvsui:Icon Data="{x:Static dvsui:IvIcons.Delete}" ViewSize="{DynamicResource IvIconSize}" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="dv.labeling.box.clear"
                        Command="{Binding Editor.ClearBoxesCommand}"
                        IsEnabled="{Binding Editor.HasBoxes}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="清空当前样本的所有框">
                        <!-- 源 SymbolIcon Eraser24 在 IvIcons 里没有等价几何，降级为 Close（与相邻的删除按钮区分开） -->
                        <dvsui:Icon Data="{x:Static dvsui:IvIcons.Close}" ViewSize="{DynamicResource IvIconSize}" />
                    </Button>
                </StackPanel>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button
                        Padding="10,4"
                        AutomationProperties.AutomationId="dv.labeling.mark.no-objects"
                        BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                        BorderThickness="1"
                        Command="{Binding Editor.MarkNoObjectsCommand}"
                        Content="标记无目标"
                        IsEnabled="{Binding Editor.IsBoxEditingEnabled}" />
                    <Button
                        Margin="6,0,0,0"
                        Padding="10,4"
                        AutomationProperties.AutomationId="dv.labeling.mark.reviewed"
                        Command="{Binding Editor.MarkReviewedCommand}"
                        IsEnabled="{Binding Editor.IsBoxEditingEnabled}"
                        Style="{StaticResource IvPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <dvsui:Icon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{x:Static dvsui:IvIcons.Check}"
                                ViewSize="{DynamicResource IvIconSize}" />
                            <TextBlock VerticalAlignment="Center" Text="完成标注" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Data import -->
        <Border Style="{StaticResource ToolSectionStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="数据" />
                <Button
                    Margin="0,8,0,0"
                    Padding="10,4"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="dv.labeling.import-images"
                    Command="{Binding Samples.ImportImagesCommand}"
                    IsEnabled="{Binding Samples.CanImportImages}">
                    <StackPanel Orientation="Horizontal">
                        <!-- 源 SymbolIcon ArrowUpload24 在 IvIcons 里没有等价几何，降级为 ArrowUp -->
                        <dvsui:Icon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="{x:Static dvsui:IvIcons.ArrowUp}"
                            ViewSize="{DynamicResource IvIconSize}" />
                        <TextBlock VerticalAlignment="Center" Text="导入图像" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="0,6,0,0"
                    Padding="10,4"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="dv.labeling.import-yolo"
                    Command="{Binding ImportYoloDatasetCommand}"
                    IsEnabled="{Binding Workspace.IsNotBusy}">
                    <StackPanel Orientation="Horizontal">
                        <dvsui:Icon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="{x:Static dvsui:IvIcons.FolderOpen}"
                            ViewSize="{DynamicResource IvIconSize}" />
                        <TextBlock VerticalAlignment="Center" Text="导入 YOLO 数据集" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="0,6,0,0"
                    Padding="10,4"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="dv.labeling.move-samples"
                    Command="{Binding Samples.ShowMoveSamplesDialogCommand}"
                    IsEnabled="{Binding Samples.CanMoveSelectedSamples}">
                    <StackPanel Orientation="Horizontal">
                        <!-- 源 SymbolIcon FolderArrowRight24 → IvIcons.FolderOpen（近义降级：少了出向箭头） -->
                        <dvsui:Icon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="{x:Static dvsui:IvIcons.FolderOpen}"
                            ViewSize="{DynamicResource IvIconSize}" />
                        <TextBlock VerticalAlignment="Center" Text="移动样本到其他图库" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
