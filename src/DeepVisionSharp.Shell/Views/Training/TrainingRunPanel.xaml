<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Training.TrainingRunPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Training.Sections">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="0" VerticalAlignment="Stretch">
        <sections:TrainingConfigPreviewSection Grid.Row="0" />
        <sections:TrainingResultsSection Grid.Row="0" />
        <sections:TrainingPreviewSection Grid.Row="0" />
        <sections:TrainingMetricsSection Grid.Row="0" />
        <sections:TrainingResourcesSection Grid.Row="0" />

        <controls:ImageLightboxOverlay
            Panel.ZIndex="1000"
            CloseCommand="{Binding Monitor.Preview.ClosePreviewLightboxCommand}"
            ImageSource="{Binding Monitor.Preview.PreviewLightboxImagePath, Converter={StaticResource FilePathToImageConverter}}"
            Visibility="{Binding Monitor.Preview.IsPreviewLightboxOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
