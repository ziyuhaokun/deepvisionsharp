<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Training.Sections.TrainingSettingsDatasetSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                                    <Border
                                        Margin="0,4,0,12"
                                        Style="{StaticResource FormSectionStyle}"
                                        VerticalAlignment="Stretch"
                                        Visibility="{Binding Monitor.IsDatasetSectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid MinHeight="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" MinHeight="120" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Style="{StaticResource AutoSplitRatioCardStyle}"
                                                Visibility="{Binding Config.Dataset.IsAutoSplitMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource FieldLabelStyle}"
                                                            Margin="0"
                                                            Text="验证集比例" />
                                                        <StackPanel
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                FontFamily="Sarasa Mono SC, Cascadia Mono, Consolas"
                                                                Text="{Binding Config.Dataset.ValidationRatioPercent, StringFormat={}{0:0}}" />
                                                            <TextBlock
                                                                Margin="2,0,0,1"
                                                                VerticalAlignment="Bottom"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="%" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Height="22" Margin="0,8,0,0">
                                                        <Border
                                                            Height="8"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            IsHitTestVisible="False"
                                                            SnapsToDevicePixels="True">
                                                            <Grid ClipToBounds="True">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding Config.Dataset.TrainRatioPercent, Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                                                    <ColumnDefinition Width="{Binding Config.Dataset.ValidationRatioPercent, Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{StaticResource DatasetRoleTrainingSolidBrush}" />
                                                                <Border Grid.Column="1" Background="{StaticResource DatasetRoleValidationSolidBrush}" />
                                                            </Grid>
                                                        </Border>
                                                        <Slider
                                                            AutomationProperties.AutomationId="dv.training.validation-ratio"
                                                            AutomationProperties.Name="验证集比例"
                                                            Style="{StaticResource AutoSplitRatioSliderStyle}"
                                                            Value="{Binding Config.Dataset.TrainRatioPercent, Mode=TwoWay}" />
                                                    </Grid>
                                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                        <Border
                                                            Background="{StaticResource DatasetRoleTrainingSolidBrush}"
                                                            Style="{StaticResource AutoSplitLegendMarkStyle}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Config.Dataset.TrainRatioPercent, StringFormat=训练 {0:0}%}" />
                                                        <Border
                                                            Margin="12,0,5,0"
                                                            Background="{StaticResource DatasetRoleValidationSolidBrush}"
                                                            Style="{StaticResource AutoSplitLegendMarkStyle}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Config.Dataset.ValidationRatioPercent, StringFormat=验证 {0:0}%}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Interactive gallery picker (OD / supervised); hidden for unsupervised anomaly. -->
                                            <Border
                                                Grid.Row="1"
                                                MinHeight="0"
                                                Margin="0,0,0,6"
                                                Padding="8"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding Config.Dataset.ShowsInteractiveGalleryPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl
                                                        AutomationProperties.AutomationId="dv.training.galleries"
                                                        ItemsSource="{Binding DataContext.JobList.Galleries, RelativeSource={RelativeSource AncestorType=Page}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel
                                                                    AutomationProperties.AutomationId="{Binding SelectAutomationId}"
                                                                    AutomationProperties.Name="{Binding Name}">
                                                                    <!--
                                                                      Keep CheckBox always in the tree for AutoSplit (default Visible).
                                                                      Purpose mode collapses it; role chips remain for that mode.
                                                                    -->
                                                                    <Border
                                                                        Style="{StaticResource AutoSplitGalleryRowStyle}"
                                                                        Visibility="{Binding DataContext.Config.Dataset.IsAutoSplitMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <CheckBox
                                                                            VerticalAlignment="Center"
                                                                            AutomationProperties.AutomationId="{Binding SelectAutomationId}"
                                                                            AutomationProperties.Name="{Binding Name}"
                                                                            Content="{Binding DisplayText}"
                                                                            FontWeight="SemiBold"
                                                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                    </Border>
                                                                    <Border
                                                                        Style="{StaticResource GalleryPurposeRowStyle}"
                                                                        Visibility="{Binding DataContext.Config.Dataset.IsPurposeAssignmentMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock
                                                                                VerticalAlignment="Center"
                                                                                FontWeight="SemiBold"
                                                                                Text="{Binding DisplayText}" />
                                                                            <Border
                                                                                Grid.Column="1"
                                                                                Style="{StaticResource GalleryRoleSegmentHostStyle}">
                                                                                <StackPanel
                                                                                    Orientation="Horizontal"
                                                                                    Visibility="{Binding DataContext.Config.Dataset.ShowsStandardGalleryRoles, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Button
                                                                                        Command="{Binding DataContext.Config.Dataset.SetGalleryTrainingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="训练"
                                                                                        Style="{StaticResource GalleryRoleTrainingChipStyle}" />
                                                                                    <Button
                                                                                        Margin="4,0,0,0"
                                                                                        Command="{Binding DataContext.Config.Dataset.SetGalleryValidationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="验证"
                                                                                        Style="{StaticResource GalleryRoleValidationChipStyle}" />
                                                                                    <Button
                                                                                        Margin="4,0,0,0"
                                                                                        Command="{Binding DataContext.Config.Dataset.SetGalleryTrainingAndValidationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="训&amp;验"
                                                                                        Style="{StaticResource GalleryRoleDualChipStyle}"
                                                                                        ToolTip="训&amp;验会让同一批样本同时进入训练集和验证集，验证指标存在数据重合，仅建议用于小样本训练。" />
                                                                                    <Button
                                                                                        Margin="4,0,0,0"
                                                                                        Command="{Binding DataContext.Config.Dataset.SetGalleryNoneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                        CommandParameter="{Binding}"
                                                        Content="无"
                                                        Style="{StaticResource GalleryRoleNoneChipStyle}" />
                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>

                                            <!-- Fixed system galleries for unsupervised anomaly (no picker). -->

                                            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Text="{Binding Config.Dataset.DatasetSummaryText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                     <TextBlock
                                                         Margin="0,2,0,0"
                                                         FontSize="11"
                                                         Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                         Text="{Binding Config.Dataset.DatasetValidationMessage}"
                                                         TextWrapping="Wrap"
                                                         Visibility="{Binding Config.Dataset.HasDatasetValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                     <TextBlock
                                                         Margin="0,3,0,0"
                                                         FontSize="11"
                                                         Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                         Text="训&amp;验会让同一批样本同时进入训练集和验证集，验证指标存在数据重合，仅建议用于小样本训练。"
                                                         TextWrapping="Wrap"
                                                         Visibility="{Binding Config.Dataset.ShowsStandardGalleryRoles, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>

                                                <Border
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Config.ShowDatasetSplitControls, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource GalleryRoleSegmentHostStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button
                                                            Command="{Binding Config.Dataset.SwitchToPurposeAssignmentModeCommand}"
                                                            Content="按用途分配"
                                                            Style="{StaticResource DatasetSplitModePurposeChipStyle}" />
                                                        <Button
                                                            Margin="3,0,0,0"
                                                            Command="{Binding Config.Dataset.SwitchToAutoSplitModeCommand}"
                                                            Content="自动分割"
                                                            Style="{StaticResource DatasetSplitModeAutoChipStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
</UserControl>
