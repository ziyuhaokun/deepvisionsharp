<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Training.Sections.TrainingPreviewSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls"
    xmlns:trainingControls="clr-namespace:DeepVisionSharp.Shell.Views.Training.Controls"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                            <ScrollViewer
                                x:Name="PreviewScrollViewer"
                                Grid.Row="0"
                                Margin="16,6,16,0"
                                HorizontalScrollBarVisibility="Disabled"
                                MinHeight="0"
                                VerticalAlignment="Stretch"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding Monitor.IsPreviewSectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,4,0,12" MinHeight="{Binding ViewportHeight, ElementName=PreviewScrollViewer}">
                                    <StackPanel VerticalAlignment="Top">
                                        <Border
                                            Margin="0,0,0,12"
                                            Padding="12"
                                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding Monitor.Preview.HasPreviewPollingError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                Text="{Binding Monitor.Preview.PreviewPollingError}"
                                                TextWrapping="Wrap" />
                                        </Border>

                                        <Grid>
                                    <ItemsControl
                                        VerticalAlignment="Top"
                                        ItemTemplate="{StaticResource TrainingPreviewImageTemplate}"
                                        ItemsSource="{Binding Monitor.Preview.PreviewImagePaths}"
                                        Visibility="{Binding Monitor.Preview.HasPreviewImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <StackPanel
                                        Style="{StaticResource EmptyStatePanelStyle}"
                                        Visibility="{Binding Monitor.Preview.ShowPreviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:SymbolIcon
                                            HorizontalAlignment="Center"
                                            FontSize="36"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Symbol="Image24" />
                                        <TextBlock
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Monitor.Preview.PreviewEmptyTitle}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Monitor.Preview.PreviewEmptyHint}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
</UserControl>
