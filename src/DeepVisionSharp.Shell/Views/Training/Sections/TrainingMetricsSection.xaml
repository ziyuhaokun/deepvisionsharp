<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Training.Sections.TrainingMetricsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls"
    xmlns:trainingControls="clr-namespace:DeepVisionSharp.Shell.Views.Training.Controls"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                            <ScrollViewer
                                x:Name="MetricsScrollViewer"
                                Grid.Row="0"
                                Margin="16,6,16,0"
                                HorizontalScrollBarVisibility="Disabled"
                                MinHeight="0"
                                VerticalAlignment="Stretch"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding Monitor.IsMetricsSectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,4,0,12" MinHeight="{Binding ViewportHeight, ElementName=MetricsScrollViewer}">
                                    <StackPanel VerticalAlignment="Top">
                                        <Border
                                            Margin="0,0,0,12"
                                            Padding="12"
                                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding Monitor.Metrics.HasMetricsPollingError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                Text="{Binding Monitor.Metrics.MetricsPollingError}"
                                                TextWrapping="Wrap" />
                                        </Border>

                                        <Grid>
                                    <StackPanel
                                        VerticalAlignment="Top"
                                        Visibility="{Binding Monitor.Metrics.ShowMetricsContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontWeight="SemiBold"
                                            Text="{Binding Monitor.Metrics.CurrentMetricEpochText}" />

                                        <!-- MetricProfile 四宫格：模板 + 值分离，停止 ValMap 槽位换标题 -->
                                        <ItemsControl
                                            Margin="0,0,0,10"
                                            ItemsSource="{Binding Monitor.Metrics.MetricCards}"
                                            Visibility="{Binding Monitor.Metrics.ShowMetricCards, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,0" Style="{StaticResource TrainingMetricCardStyle}">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Title}" />
                                                            <TextBlock
                                                                FontSize="22"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding ValueText}" />
                                                            <TextBlock
                                                                Margin="0,6,0,0"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding DeltaText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Margin="0,2,0,0"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding BestEpochText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding Footnote}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding HasFootnote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 次级：训练损失 / profile 说明 / 学习率 -->
                                        <Border
                                            Margin="0,0,0,12"
                                            Padding="12,10"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel
                                                    Grid.Column="0"
                                                    Visibility="{Binding Monitor.Metrics.ShowSecondaryTrainLossRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="训练损失" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Monitor.Metrics.CurrentTrainLossText}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding Monitor.Metrics.TrainLossDeltaText}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="0"
                                                    Visibility="{Binding Monitor.Metrics.ShowMetricsFooterHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="主指标说明" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="13"
                                                        TextWrapping="Wrap"
                                                        Text="{Binding Monitor.Metrics.MetricsFooterHint}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="学习率" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Monitor.Metrics.CurrentLrText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 分类：准确率 / 损失 / 学习率 -->
                                        <Grid
                                            Margin="0,0,0,16"
                                            Visibility="{Binding Monitor.Metrics.ShowClassificationMetricsCards, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource TrainingMetricCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Monitor.Metrics.QualityChartTitle}" />
                                                    <trainingControls:MetricLineChart
                                                        Height="280"
                                                        EmptyText="{Binding Monitor.Metrics.QualityChartEmptyText}"
                                                        MaximumY="1"
                                                        MinimumY="0"
                                                        SeriesSource="{Binding Monitor.Metrics.QualityChartSeries, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource TrainingMetricCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="损失变化" />
                                                    <trainingControls:MetricLineChart
                                                        Height="280"
                                                        EmptyText="等待损失指标"
                                                        YScale="Logarithmic"
                                                        SeriesSource="{Binding Monitor.Metrics.LossChartSeries, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource TrainingMetricCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="学习率" />
                                                    <trainingControls:MetricLineChart
                                                        Height="280"
                                                        EmptyText="等待学习率"
                                                        YScale="Logarithmic"
                                                        SeriesSource="{Binding Monitor.Metrics.LrChartSeries, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontWeight="SemiBold"
                                            Text="历史记录" />

                                        <!-- 分类历史列 -->
                                        <DataGrid
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            EnableRowVirtualization="True"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Monitor.Metrics.MetricHistory}"
                                            MaxHeight="280"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Visibility="{Binding Monitor.Metrics.ShowClassificationMetricsCards, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding Epoch}" Header="轮次" Width="60" />
                                                <DataGridTextColumn Binding="{Binding AccuracyTop1Text}" Header="Top-1" Width="*" />
                                                <DataGridTextColumn Binding="{Binding AccuracyTop5Text}" Header="Top-5" Width="*" />
                                                <DataGridTextColumn Binding="{Binding TrainLossText}" Header="训练损失" Width="*" />
                                                <DataGridTextColumn Binding="{Binding ValLossText}" Header="验证损失" Width="*" />
                                                <DataGridTextColumn Binding="{Binding LrText}" Header="学习率" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- 分类：最新一轮的每类指标，暴露"全判 OK"这类退化 -->
                                        <TextBlock
                                            Margin="0,16,0,10"
                                            FontWeight="SemiBold"
                                            Text="分类指标（最新一轮）"
                                            Visibility="{Binding Monitor.Metrics.HasPerClassRows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <DataGrid
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            EnableRowVirtualization="True"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Monitor.Metrics.PerClassRows}"
                                            MaxHeight="220"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Visibility="{Binding Monitor.Metrics.HasPerClassRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding ClassName}" Header="类别" Width="*" />
                                                <DataGridTextColumn Binding="{Binding PrecisionText}" Header="Precision" Width="*" />
                                                <DataGridTextColumn Binding="{Binding RecallText}" Header="Recall" Width="*" />
                                                <DataGridTextColumn Binding="{Binding F1Text}" Header="F1" Width="*" />
                                                <DataGridTextColumn Binding="{Binding SupportText}" Header="样本数" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>

                                    <StackPanel
                                        Style="{StaticResource EmptyStatePanelStyle}"
                                        Visibility="{Binding Monitor.Metrics.ShowMetricsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:SymbolIcon
                                            HorizontalAlignment="Center"
                                            FontSize="36"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Symbol="ChartMultiple24" />
                                        <TextBlock
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="暂无指标" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="训练开始后将显示实时指标"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
</UserControl>
