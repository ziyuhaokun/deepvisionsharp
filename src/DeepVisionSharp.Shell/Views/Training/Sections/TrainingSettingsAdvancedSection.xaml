<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Training.Sections.TrainingSettingsAdvancedSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                                    <ScrollViewer
                                        Margin="0,4,0,12"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="{Binding Monitor.IsAdvancedSectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Margin="0" Style="{StaticResource FormSectionStyle}">
                                        <StackPanel>
                                            <Grid Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="优化器" />
                                                    <ComboBox
                                                        ItemsSource="{Binding Config.OptimizerOptions}"
                                                        SelectedItem="{Binding Config.Optimizer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel
                                                Margin="0,12,0,0"
                                                Visibility="{Binding Config.Spatial.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Margin="0"
                                                        Text="网络输入宽×高" />
                                                    <controls:ParamHelpButton
                                                        Title="网络输入宽×高"
                                                        HelpText="{Binding Config.Spatial.NetworkInputSizeHint}" />
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="180" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" MinWidth="180" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:NumberBox
                                                        Grid.Column="0"
                                                        Style="{StaticResource TrainingConfigNumberBoxStyle}"
                                                        MinWidth="180"
                                                        Tag="NetworkInputWidth"
                                                        Minimum="{Binding Config.Spatial.NetworkInputSizeMin}"
                                                        Maximum="{Binding Config.Spatial.NetworkInputSizeMax}"
                                                        SmallChange="{Binding Config.Spatial.NetworkInputSizeStep}"
                                                        IsEnabled="{Binding Config.IsFormEditable}"
                                                        Value="{Binding Config.Spatial.NetworkInputWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="12,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Text="×" />
                                                    <ui:NumberBox
                                                        Grid.Column="2"
                                                        Style="{StaticResource TrainingConfigNumberBoxStyle}"
                                                        MinWidth="180"
                                                        Tag="NetworkInputHeight"
                                                        Minimum="{Binding Config.Spatial.NetworkInputSizeMin}"
                                                        Maximum="{Binding Config.Spatial.NetworkInputSizeMax}"
                                                        SmallChange="{Binding Config.Spatial.NetworkInputSizeStep}"
                                                        IsEnabled="{Binding Config.IsFormEditable}"
                                                        Value="{Binding Config.Spatial.NetworkInputHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </StackPanel>


                                            <StackPanel
                                                Margin="0,18,0,0"
                                                Visibility="{Binding Config.IsClassificationModelSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="数据增强（Classification）" />
                                                    <controls:ParamHelpButton
                                                        Title="数据增强（Classification）"
                                                        HelpText="0-1，默认关闭。当前仅支持左右翻转和上下翻转。" />
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap"
                                                    Text="左右翻转和上下翻转，概率 0-1，默认关闭。" />
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource FieldLabelStyle}"
                                                                Margin="0"
                                                                Text="水平翻转概率" />
                                                            <controls:ParamHelpButton Title="水平翻转概率" HelpText="0–1，默认 0" />
                                                        </StackPanel>
                                                        <ui:NumberBox
                                                            Maximum="1"
                                                            Minimum="0"
                                                            SmallChange="0.05"
                                                            Value="{Binding Config.Cls.FlipLeftRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource FieldLabelStyle}"
                                                                Margin="0"
                                                                Text="垂直翻转概率" />
                                                            <controls:ParamHelpButton Title="垂直翻转概率" HelpText="0–1，默认 0" />
                                                        </StackPanel>
                                                        <ui:NumberBox
                                                            Maximum="1"
                                                            Minimum="0"
                                                            SmallChange="0.05"
                                                            Value="{Binding Config.Cls.FlipUpDown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                        </StackPanel>
                                        </Border>
                                    </ScrollViewer>
</UserControl>
