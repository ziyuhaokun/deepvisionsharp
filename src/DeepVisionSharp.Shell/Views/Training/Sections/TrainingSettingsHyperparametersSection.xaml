<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Training.Sections.TrainingSettingsHyperparametersSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                                    <ScrollViewer
                                        Margin="0,4,0,12"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="{Binding Monitor.IsHyperparametersSectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Style="{StaticResource FormSectionStyle}" Margin="0">
                                        <StackPanel>
                                            <!-- Shared training hyperparameters -->
                                            <Grid Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource FieldLabelStyle}"
                                                            Margin="0"
                                                            Text="Epochs" />
                                                        <controls:ParamHelpButton Title="Epochs" HelpText="范围 1–100000" />
                                                    </StackPanel>
                                                    <ui:NumberBox
                                                        Style="{StaticResource TrainingConfigNumberBoxStyle}"
                                                        Tag="Epochs"
                                                        Minimum="1"
                                                        Value="{Binding Config.Epochs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource FieldLabelStyle}"
                                                            Margin="0"
                                                            Text="Batch Size" />
                                                        <controls:ParamHelpButton Title="Batch Size" HelpText="范围 1–32" />
                                                    </StackPanel>
                                                    <ui:NumberBox
                                                        Style="{StaticResource TrainingConfigNumberBoxStyle}"
                                                        Tag="BatchSize"
                                                        Minimum="1"
                                                        Value="{Binding Config.BatchSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    
                                                </StackPanel>

                                                <StackPanel Grid.Column="4">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource FieldLabelStyle}"
                                                            Margin="0"
                                                            Text="学习率" />
                                                        <controls:ParamHelpButton Title="学习率" HelpText="范围 0.00005–0.005" />
                                                    </StackPanel>
                                                    <ui:NumberBox
                                                        Style="{StaticResource TrainingConfigNumberBoxStyle}"
                                                        Tag="LearningRate"
                                                        Maximum="0.005"
                                                        Minimum="0.00005"
                                                        SmallChange="0.0001"
                                                        Value="{Binding Config.LearningRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource FieldLabelStyle}"
                                                            Margin="0"
                                                            Text="早停耐心" />
                                                        <controls:ParamHelpButton Title="早停耐心" HelpText="连续多少轮验证集无提升就停止；0 表示关闭（跑满 Epochs）" />
                                                    </StackPanel>
                                                    <ui:NumberBox
                                                        Style="{StaticResource TrainingConfigNumberBoxStyle}"
                                                        Tag="EarlyStoppingPatience"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding Config.EarlyStoppingPatience, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        </Border>
                                    </ScrollViewer>
</UserControl>
