<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Training.Sections.TrainingConfigPreviewSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls"
    xmlns:trainingControls="clr-namespace:DeepVisionSharp.Shell.Views.Training.Controls"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                            <ScrollViewer
                                x:Name="ConfigPreviewScrollViewer"
                                Grid.Row="0"
                                Margin="16,6,16,0"
                                HorizontalScrollBarVisibility="Disabled"
                                MinHeight="0"
                                VerticalAlignment="Stretch"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding Monitor.IsConfigPreviewSectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Margin="0,4,0,12" Width="{Binding ViewportWidth, ElementName=ConfigPreviewScrollViewer}">
                                    <Border Style="{StaticResource TrainingResultCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="108" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 基础信息 -->
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="实验名称" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Text="{Binding Config.ModelName}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="数据集" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Text="{Binding Config.Dataset.DatasetSummaryText}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="模型" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Text="{Binding Config.InferredModelTypeDisplay}"
                                                TextWrapping="Wrap" />

                                            <!-- 训练超参（分类模型显示 Epochs / 学习率） -->
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="Epochs"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Text="{Binding Config.Epochs}"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="Batch Size"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="2"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Text="{Binding Config.BatchSize}"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="学习率"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Grid.Row="5"
                                                Grid.Column="2"
                                                Margin="0,0,0,12"
                                                VerticalAlignment="Top"
                                                Text="{Binding Config.LearningRate}"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="优化器"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Grid.Row="6"
                                                Grid.Column="2"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="{Binding Config.Optimizer}" />
                                            </TextBlock>

                                            <TextBlock
                                                Grid.Row="7"
                                                Grid.Column="0"
                                                Margin="0,12,0,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="数据增强"
                                                Visibility="{Binding Config.ShowsClassificationAugmentation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Grid.Row="7"
                                                Grid.Column="2"
                                                Margin="0,12,0,0"
                                                VerticalAlignment="Top"
                                                Text="{Binding Config.ClassificationAugmentationSummary}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding Config.ShowsClassificationAugmentation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
</UserControl>
