<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Resources/StatusPalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style
            x:Key="ModelCardStyle"
            BasedOn="{StaticResource {x:Type ui:Card}}"
            TargetType="{x:Type ui:Card}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Width" Value="360" />
            <Setter Property="MinHeight" Value="280" />
        </Style>

        <Style x:Key="ModelCardTitleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ModelDescriptionTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="ModelCardMetaTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ModelCardBadgeTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="创建中">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="待训练">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="训练中">
                    <Setter Property="Foreground" Value="{StaticResource ModelStatusTrainingTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="训练完成">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已发布">
                    <Setter Property="Foreground" Value="{StaticResource ModelStatusPublishedTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="归档">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact status chip: hug content, soft tint by status -->
        <Style x:Key="ModelStatusBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="创建中">
                    <Setter Property="Background" Value="{StaticResource ModelStatusCreatingTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="待训练">
                    <Setter Property="Background" Value="{StaticResource ModelStatusPendingTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="训练中">
                    <Setter Property="Background" Value="{StaticResource ModelStatusTrainingTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="训练完成">
                    <Setter Property="Background" Value="{StaticResource ModelStatusCompletedTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已发布">
                    <Setter Property="Background" Value="{StaticResource ModelStatusPublishedTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="归档">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModelCardPathTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Align with Dashboard project meta pills -->
        <Style x:Key="ModelMetaPillStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
</ResourceDictionary>
