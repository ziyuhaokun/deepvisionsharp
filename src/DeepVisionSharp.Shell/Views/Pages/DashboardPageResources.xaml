<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/DashboardPage.axaml（UserControl.Resources + UserControl.Styles，512 行） | 转换: ControlTheme→Style(x:Key)，源的样式类（Border.projectCard / Border.typeChip / TextBlock.projectTitle / TextBlock.projectDescription / TextBlock.projectMeta / TextBlock.typeChipText / Border.overlayCard）→ 具名 Style；字号能对上 Iv 令牌的走令牌，源里的 12.5 / 17 / 28 等无同值令牌的值按源字面值照抄 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">

    <ResourceDictionary.MergedDictionaries>
        <!-- DvToolbarButtonStyle 的 BasedOn 是 IvButtonBaseStyle：WPF 的 StaticResource 不跨同级 merge 的字典，
             所以本字典自带按钮底模（各视图根部另有同样的 merge，WPF 允许重复合并）。 -->
        <ResourceDictionary Source="pack://application:,,,/yu-ui;component/Styles/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <converters:ProjectTypeVisualConverter x:Key="ProjectTypeVisualConverter" />

    <!-- 源 ControlTheme x:Key="DvToolbarButtonStyle" TargetType=Button BasedOn IvButtonBaseStyle：
         Height=34 / Padding=13,0 / FontSize=13 / 表面底 + 描边，:pointerover 换成悬停底色 + 悬停描边 -->
    <Style x:Key="DvToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource IvButtonBaseStyle}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
        <Style.Triggers>
            <!-- 源 ^:pointerover 的 Background/BorderBrush 切换；禁用态不参与（WPF 禁用元素仍会报 IsMouseOver） -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource IvStateHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderHoverBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- 源 Border.projectCard（Avalonia 是 Border，WPF 保留 ContentControl 以便保留卡片级 AutomationId）：
         Padding=0 / Margin=0,0,12,12 / Height=212 / ClipToBounds / 表面底 + 细描边 + 1px / 圆角 6；
         悬停只换描边（源 Border.projectCard:pointerover → IvAccentBorderBrush），源卡片没有位移或投影 -->
    <Style x:Key="ProjectCardStyle" TargetType="ContentControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Height" Value="212" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- 圆角 6 是源的硬编码值（令牌表最大到 IvRadiusOverlay=4），照抄常量 -->
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 源 Border.typeChip：Height=20 / Padding=6,0 / 左对齐 / 圆角 3 -->
    <Style x:Key="TypeChipStyle" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- 源 TextBlock.typeChipText：FontSize=11 / IvText2Brush -->
    <Style x:Key="TypeChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>

    <!-- 源 TextBlock.projectTitle：FontSize=15 / SemiBold / IvText1Brush -->
    <Style x:Key="ProjectTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
    </Style>

    <!-- 源 TextBlock.projectDescription：FontSize=12.5 / IvText2Brush / Wrap / CharacterEllipsis -->
    <Style x:Key="ProjectDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 源 TextBlock.projectMeta：FontSize=12 / IvText2Brush -->
    <Style x:Key="ProjectMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>

    <!-- 源 Border.overlayCard：Padding=28 / MinWidth=480 / MaxWidth=520 / 圆角 8 / 表面底 + 细描边 -->
    <Style x:Key="OverlayCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="28" />
        <Setter Property="MinWidth" Value="480" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
