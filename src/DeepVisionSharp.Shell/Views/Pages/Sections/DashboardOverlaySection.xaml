<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardOverlaySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Border
            Grid.RowSpan="3"
            Panel.ZIndex="90"
            Background="{DynamicResource IvOverlayBrush}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding List.IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding List.IsProjectOperationInProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Editor.IsSavingProject}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentControl
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource IvCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar
                        Width="32"
                        Height="6"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource IvFontSizeSubtitle}"
                        FontWeight="SemiBold"
                        Text="正在处理项目…" />
                </StackPanel>
            </ContentControl>
        </Border>

        <Border
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Background="{DynamicResource IvOverlayBrush}"
            Visibility="{Binding Transfer.IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource TransferOverlayCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar
                            Width="40"
                            Height="6"
                            VerticalAlignment="Center"
                            IsIndeterminate="True" />

                        <StackPanel Grid.Column="1" Margin="16,0,12,0">
                            <TextBlock
                                FontSize="{DynamicResource IvFontSizeHeading}"
                                FontWeight="SemiBold"
                                Text="{Binding Transfer.TransferStage}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontFamily="{DynamicResource IvMonoFontFamily}"
                                FontSize="{DynamicResource IvFontSizeBodySmall}"
                                Foreground="{DynamicResource IvText2Brush}"
                                Text="{Binding Transfer.TransferCurrentFileDisplay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Transfer.TransferCurrentFile}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            FontSize="{DynamicResource IvFontSizeDisplay}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource IvAccentBrush}"
                            Text="{Binding Transfer.TransferProgressPercentText}" />
                    </Grid>

                    <ProgressBar
                        Margin="0,24,0,0"
                        Maximum="1"
                        Style="{StaticResource TransferProgressBarStyle}"
                        Value="{Binding Transfer.TransferProgressValue, Mode=OneWay}" />

                    <Grid Margin="0,10,0,0">
                        <TextBlock
                            FontSize="{DynamicResource IvFontSizeBodySmall}"
                            Foreground="{DynamicResource IvText2Brush}"
                            Text="{Binding Transfer.TransferProgressText}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="{DynamicResource IvFontSizeBodySmall}"
                            Foreground="{DynamicResource IvText3Brush}"
                            Text="请勿关闭应用" />
                    </Grid>
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
