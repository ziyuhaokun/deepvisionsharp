<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardOverlaySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Border
            Grid.RowSpan="3"
            Panel.ZIndex="90"
            Background="#80000000">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding List.IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding List.IsProjectOperationInProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Editor.IsSavingProject}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ui:Card
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="32"
                        Height="32"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="正在处理项目…" />
                </StackPanel>
            </ui:Card>
        </Border>

        <Border
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Background="#B3000000"
            Visibility="{Binding Transfer.IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource TransferOverlayCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:ProgressRing
                            Width="40"
                            Height="40"
                            VerticalAlignment="Top"
                            IsIndeterminate="True" />

                        <StackPanel Grid.Column="1" Margin="16,0,12,0">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding Transfer.TransferStage}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontFamily="Cascadia Mono, Consolas, Courier New"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Transfer.TransferCurrentFileDisplay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Transfer.TransferCurrentFile}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{Binding Transfer.TransferProgressPercentText}" />
                    </Grid>

                    <ProgressBar
                        Margin="0,24,0,0"
                        Maximum="1"
                        Style="{StaticResource TransferProgressBarStyle}"
                        Value="{Binding Transfer.TransferProgressValue, Mode=OneWay}" />

                    <Grid Margin="0,10,0,0">
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Transfer.TransferProgressText}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="请勿关闭应用" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Border>
    </Grid>
</UserControl>
