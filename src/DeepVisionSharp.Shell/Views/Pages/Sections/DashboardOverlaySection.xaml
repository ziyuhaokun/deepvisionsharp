<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/DashboardPage.axaml（加载 / 项目操作遮罩 + 导入导出遮罩） | 转换: MultiBinding+AnyTrueConverter→多个 DataTrigger（等价「任一为真即显示」）；dv:BusyRing→不定量 ProgressBar（本仓库无 BusyRing 控件）；源另有 ZIndex=95 的删除进度遮罩，本仓库 Dashboard VM 无删除进度成员，故不添加 -->
<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardOverlaySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- 加载 / 项目操作遮罩（源 ZIndex=90）：表面底 + 细描边 + 圆角 6 + Padding 20,16，30px 转圈 + 14 号半粗字 -->
        <Border Panel.ZIndex="90" Background="{DynamicResource IvOverlayBrush}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding List.IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding List.IsProjectOperationInProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Editor.IsSavingProject}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border
                Padding="20,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource IvSurface2Brush}"
                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar
                        Width="30"
                        Height="6"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource IvFontSizeBody}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IvText1Brush}"
                        Text="正在处理项目…" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 导入 / 导出遮罩（源 ZIndex=100）：Border.overlayCard（Padding 28 / MinWidth 480 / MaxWidth 520 / 圆角 8） -->
        <Border
            Panel.ZIndex="100"
            Background="{DynamicResource IvOverlayBrush}"
            Visibility="{Binding Transfer.IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource OverlayCardStyle}">
                <StackPanel>
                    <!-- 源 ColumnDefinitions="Auto,*,Auto"：40px 转圈 / 阶段与当前文件 / 28 号百分比 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar
                            Width="40"
                            Height="6"
                            VerticalAlignment="Top"
                            IsIndeterminate="True" />

                        <StackPanel Grid.Column="1" Margin="16,0,12,0">
                            <TextBlock
                                FontSize="{DynamicResource IvFontSizeHeading}"
                                FontWeight="SemiBold"
                                Text="{Binding Transfer.TransferStage}" />
                            <!-- 源 FontSize=13 / IvMonoFontFamily / Margin=0,6,0,0 -->
                            <TextBlock
                                Margin="0,6,0,0"
                                FontFamily="{DynamicResource IvMonoFontFamily}"
                                FontSize="{DynamicResource IvFontSizeBodySmall}"
                                Foreground="{DynamicResource IvText2Brush}"
                                Text="{Binding Transfer.TransferCurrentFileDisplay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Transfer.TransferCurrentFile}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource IvAccentBrush}"
                            Text="{Binding Transfer.TransferProgressPercentText}" />
                    </Grid>

                    <!-- 源 Margin=0,24,0,0 / Height=6 / Maximum=1 -->
                    <ProgressBar
                        Height="6"
                        Margin="0,24,0,0"
                        Maximum="1"
                        Value="{Binding Transfer.TransferProgressValue, Mode=OneWay}" />

                    <!-- 源 Margin=0,10,0,0 / 13 号字：进度文本 + 「请勿关闭应用」 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="{DynamicResource IvFontSizeBodySmall}"
                            Foreground="{DynamicResource IvText2Brush}"
                            Text="{Binding Transfer.TransferProgressText}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="{DynamicResource IvFontSizeBodySmall}"
                            Foreground="{DynamicResource IvText2Brush}"
                            Text="请勿关闭应用" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
