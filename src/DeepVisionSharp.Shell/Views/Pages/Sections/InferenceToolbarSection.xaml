<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.InferenceToolbarSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:yu="http://schemas.yu-ui/xaml"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/InferencePageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10,8"
            Background="{DynamicResource IvSurface2Brush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusOverlay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="{DynamicResource IvFontSizeSubtitle}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IvText1Brush}"
                        Text="{Binding ProjectTitle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="{DynamicResource IvFontSizeCaption}"
                        Foreground="{DynamicResource IvText2Brush}"
                        Text="{Binding ImageSourceSummary}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        AutomationProperties.AutomationId="dv.inference.image-source"
                        Command="{Binding ShowImageSourceDialogCommand}"
                        IsEnabled="{Binding HasProjectContext}">
                        <StackPanel Orientation="Horizontal">
                            <yu:Icon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{x:Static yu:IvIcons.FolderOpen}"
                                ViewSize="{DynamicResource IvIconSize}" />
                            <TextBlock VerticalAlignment="Center" Text="配置来源" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="dv.inference.run-selected"
                        Command="{Binding RunSelectedCommand}"
                        IsEnabled="{Binding CanRun}"
                        Style="{StaticResource IvPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <yu:Icon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{x:Static yu:IvIcons.Play}"
                                ViewSize="{DynamicResource IvIconSize}" />
                            <TextBlock VerticalAlignment="Center" Text="推理当前" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="dv.inference.run-all"
                        Command="{Binding RunAllCommand}"
                        IsEnabled="{Binding HasProjectContext}">
                        <StackPanel Orientation="Horizontal">
                            <yu:Icon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{x:Static yu:IvIcons.Bolt}"
                                ViewSize="{DynamicResource IvIconSize}" />
                            <TextBlock VerticalAlignment="Center" Text="推理全部" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding ShowLastBatchReportCommand}"
                        ToolTip="查看最近一次「推理全部」的分析报告">
                        <StackPanel Orientation="Horizontal">
                            <yu:Icon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{x:Static yu:IvIcons.Document}"
                                ViewSize="{DynamicResource IvIconSize}" />
                            <TextBlock VerticalAlignment="Center" Text="分析报告" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="dv.inference.stop"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <!-- 源 SymbolIcon Stop24 在 IvIcons 里没有等价几何，降级为 Close -->
                            <yu:Icon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{x:Static yu:IvIcons.Close}"
                                ViewSize="{DynamicResource IvIconSize}" />
                            <TextBlock VerticalAlignment="Center" Text="停止" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
</UserControl>
