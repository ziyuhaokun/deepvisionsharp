<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/GalleryPage.axaml（顶栏按钮组） | 转换: WPF-UI Button→Button（Appearance 映射见 docs/yu-ui-migration.md §2.1）；SymbolIcon→yu:Icon；颜色/字号走 Iv* 令牌 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.GalleryHeaderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yu="http://schemas.yu-ui/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/yu-ui;component/YuUiTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <!-- 行 0：固定顶栏 -->
        <Grid Grid.Row="0" Margin="28,24,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource IvFontSizeDisplay}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource IvText1Brush}"
                Text="图库" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding List.ShowProjectLabelStatisticsDialogCommand}"
                    IsEnabled="{Binding Transfer.IsNotImporting}"
                    Visibility="{Binding List.ShowsGalleryLabelStatistics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <yu:Icon
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="{x:Static yu:IvIcons.Calculator}"
                            ViewSize="15" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="标签统计" />
                    </Grid>
                </Button>

                <Button
                    Margin="0,0,10,0"
                    Command="{Binding List.SelectAllGalleriesCommand}"
                    IsEnabled="{Binding Transfer.IsNotImporting}"
                    Visibility="{Binding List.IsGallerySelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    全选
                </Button>

                <Button
                    Margin="0,0,10,0"
                    Command="{Binding List.DeselectAllGalleriesCommand}"
                    IsEnabled="{Binding Transfer.IsNotImporting}"
                    Visibility="{Binding List.IsGallerySelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    取消全选
                </Button>

                <Button
                    Margin="0,0,10,0"
                    Command="{Binding List.ToggleGallerySelectionModeCommand}"
                    IsEnabled="{Binding Transfer.IsNotImporting}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                            <Setter Property="Content" Value="多选" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding List.IsGallerySelectionMode}" Value="True">
                                    <Setter Property="Content" Value="退出多选" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button
                    Margin="0,0,10,0"
                    Command="{Binding Reorganize.ShowMergeGalleriesDialogCommand}"
                    IsEnabled="{Binding Reorganize.CanMergeGalleries}">
                    合并图库
                </Button>

                <Button
                    Margin="0,0,10,0"
                    AutomationProperties.AutomationId="dv.gallery.import"
                    Command="{Binding Transfer.ImportGalleryCommand}"
                    IsEnabled="{Binding Transfer.IsNotImporting}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <yu:Icon
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="{x:Static yu:IvIcons.ArrowUp}"
                            ViewSize="15" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="导入图库" />
                    </Grid>
                </Button>

                <Button
                    AutomationProperties.AutomationId="dv.gallery.create"
                    Command="{Binding Editor.ShowCreateGalleryDialogCommand}"
                    IsEnabled="{Binding Transfer.IsNotImporting}"
                    Style="{StaticResource IvPrimaryButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <yu:Icon
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="{x:Static yu:IvIcons.Add}"
                            ViewSize="15" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="新建图库" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

</UserControl>
