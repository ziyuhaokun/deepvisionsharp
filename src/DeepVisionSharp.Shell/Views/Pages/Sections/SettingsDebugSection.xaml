<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.SettingsDebugSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:yu="http://schemas.yu-ui/xaml"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/SettingsPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                    <StackPanel Visibility="{Binding IsAdvancedSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="数据完整性" />
                        <ContentControl Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="数据检查与修复" />
                                    <TextBlock
                                        Style="{StaticResource RowSubtitleStyle}"
                                        Text="检查并修复项目、图库和样本索引。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!-- 源 WPF-UI ProgressRing（18×18 环）→ 不确定态 ProgressBar（条形） -->
                                    <ProgressBar
                                        Width="48"
                                        Height="6"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsRunningDataRepair, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        Command="{Binding CheckAndRepairDataCommand}"
                                        IsEnabled="{Binding IsNotRunningDataRepair}"
                                        Style="{StaticResource IvPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 源 SymbolIcon Wrench24 → IvIcons.Settings（近义降级） -->
                                            <yu:Icon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static yu:IvIcons.Settings}"
                                                ViewSize="{DynamicResource IvIconSize}" />
                                            <TextBlock VerticalAlignment="Center" Text="执行检查修复" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ContentControl>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="最近结果" />
                        <ContentControl Style="{StaticResource SettingsCardStyle}">
                            <TextBlock
                                Foreground="{DynamicResource IvText2Brush}"
                                Text="{Binding DataRepairSummary}"
                                TextWrapping="Wrap" />
                        </ContentControl>
                    </StackPanel>
</UserControl>
