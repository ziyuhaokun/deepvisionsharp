<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.SettingsDebugSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/SettingsPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                    <StackPanel Visibility="{Binding IsAdvancedSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="数据完整性" />
                        <ui:Card Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="数据检查与修复" />
                                    <TextBlock
                                        Style="{StaticResource RowSubtitleStyle}"
                                        Text="检查并修复项目、图库和样本索引。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ui:ProgressRing
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,10,0"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsRunningDataRepair, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding CheckAndRepairDataCommand}"
                                        Icon="{ui:SymbolIcon Wrench24}"
                                        IsEnabled="{Binding IsNotRunningDataRepair}">
                                        执行检查修复
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="最近结果" />
                        <ui:Card Style="{StaticResource SettingsCardStyle}">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DataRepairSummary}"
                                TextWrapping="Wrap" />
                        </ui:Card>
                    </StackPanel>
</UserControl>
