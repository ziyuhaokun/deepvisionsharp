<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.InferenceCanvasSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/InferencePageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Grid.Column="1"
            Margin="0,0,4,0"
            Padding="4"
            MinHeight="0"
            MinWidth="0"
            VerticalAlignment="Stretch"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="8">
            <Grid MinHeight="0" ClipToBounds="True">
                <Border
                    Margin="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Grid>
                        <Image
                            x:Name="InferenceSurface"
                            Source="{Binding PreviewImage}"
                            Stretch="Uniform" />
                        <controls:BoxOverlayCanvas
                            AutomationProperties.AutomationId="dv.inference.box-layer"
                            Boxes="{Binding Canvas.BoxOverlays}"
                            ImageHeight="{Binding Canvas.ImageHeight}"
                            ImageWidth="{Binding Canvas.ImageWidth}"
                            IsReadOnly="True"
                            Visibility="{Binding Canvas.HasBoxOverlays, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <!-- Top-left: compact status float + pin -->
                <controls:CanvasCornerFloat
                    Panel.ZIndex="12"
                    PinId="inference-result-tl"
                    Placement="TopLeft"
                    UseOpaqueBackground="True">
                    <controls:CanvasCornerFloat.Body>
                        <Border Padding="8,6" Background="Transparent">
                            <StackPanel MaxWidth="200">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ActiveFileName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ImageSizeText}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border
                                        Padding="5,1"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding ResultHeadline}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Text="{Binding SelectedImage.EvaluationTag}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:CanvasCornerFloat.Body>
                </controls:CanvasCornerFloat>

                <!-- Empty hint only when no image. -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    IsHitTestVisible="False"
                    Text="选择或导入图片后在此预览">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreviewImage}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
</UserControl>
