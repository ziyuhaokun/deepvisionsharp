<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardProjectListSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <!-- 列表滚动区：摘要 + 空状态 + 卡片墙 -->
                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,8">
                        <TextBlock
                            Margin="2,8,2,0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="当前项目 · 图像分类" />
                        <!-- 列表摘要 -->
                        <TextBlock
                            Margin="2,8,2,0"
                            HorizontalAlignment="Right"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding List.ResultSummary}" />

                        <!-- 空状态 -->
                        <Border
                            MinHeight="280"
                            Margin="0,12,0,0"
                            Padding="24"
                            d:Visibility="Hidden"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding List.HasEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="42"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="FolderOpen24" />
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding List.EmptyStateTitle}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding List.EmptyStateDescription}" />
                    </StackPanel>
                </Border>

                <sections:DashboardProjectCardWallSection />

            </StackPanel>
        </ScrollViewer>
</UserControl>
