<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/GalleryPage.axaml（指标卡 + 搜索框） | 转换: WPF-UI Card→ContentControl+IvCardStyle；SymbolIcon→dvsui:Icon；输入框的 Icon/PlaceholderText→叠层 dvsui:Icon + dvsui:IvPlaceholder.Text；颜色/字号走 Iv* 令牌 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.GalleryMetricsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <!-- 行 1：指标卡片与搜索框 -->
        <StackPanel Grid.Row="1" Margin="28,14,28,0">
            <UniformGrid Columns="3" Rows="1">
                <ContentControl Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTileStyle}">
                            <dvsui:Icon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{x:Static dvsui:IvIcons.Folder}"
                                Foreground="{DynamicResource IvText2Brush}"
                                ViewSize="18" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontSize="{DynamicResource IvFontSizeHeading}"
                                FontWeight="SemiBold"
                                Text="{Binding List.GalleryCount}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="{DynamicResource IvFontSizeSmall}"
                                Foreground="{DynamicResource IvText2Brush}"
                                Text="总图库数" />
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <ContentControl Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTileStyle}">
                            <dvsui:Icon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{x:Static dvsui:IvIcons.Image}"
                                Foreground="{DynamicResource IvText2Brush}"
                                ViewSize="18" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontSize="{DynamicResource IvFontSizeHeading}"
                                FontWeight="SemiBold"
                                Text="{Binding List.SampleCount}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="{DynamicResource IvFontSizeSmall}"
                                Foreground="{DynamicResource IvText2Brush}"
                                Text="总样本数" />
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <ContentControl Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTileStyle}">
                            <dvsui:Icon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{x:Static dvsui:IvIcons.Success}"
                                Foreground="{DynamicResource IvText2Brush}"
                                ViewSize="18" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontSize="{DynamicResource IvFontSizeHeading}"
                                FontWeight="SemiBold"
                                Text="{Binding List.ProjectProgressText}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="{DynamicResource IvFontSizeSmall}"
                                Foreground="{DynamicResource IvText2Brush}"
                                Text="整体标注进度" />
                        </StackPanel>
                    </Grid>
                </ContentControl>
            </UniformGrid>

            <!-- 搜索框：占位文本走 dvsui:IvPlaceholder.Text，左侧放大镜用叠层 dvsui:Icon（源同款写法） -->
            <Grid Margin="0,10,0,0">
                <TextBox
                    AutomationProperties.AutomationId="dv.gallery.search"
                    Padding="34,0,10,0"
                    Text="{Binding List.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    dvsui:IvPlaceholder.Text="搜索图库名称或描述…" />
                <dvsui:Icon
                    Margin="11,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Data="{x:Static dvsui:IvIcons.Search}"
                    Foreground="{DynamicResource IvText3Brush}"
                    IsHitTestVisible="False"
                    ViewSize="15" />
            </Grid>
        </StackPanel>

</UserControl>
