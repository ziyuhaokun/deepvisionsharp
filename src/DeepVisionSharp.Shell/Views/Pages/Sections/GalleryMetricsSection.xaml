<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.GalleryMetricsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <!-- 行 1：指标卡片与搜索框 -->
        <StackPanel Grid.Row="1" Margin="28,14,28,0">
            <UniformGrid Columns="3" Rows="1">
                <ui:Card Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTileStyle}">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Folder24" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding List.GalleryCount}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="总图库数" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTileStyle}">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Image24" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding List.SampleCount}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="总样本数" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTileStyle}">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="CheckmarkCircle24" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding List.ProjectProgressText}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="整体标注进度" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </UniformGrid>

            <ui:TextBox
                Margin="0,10,0,0"
                AutomationProperties.AutomationId="dv.gallery.search"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="搜索图库名称或描述…"
                Text="{Binding List.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

</UserControl>
