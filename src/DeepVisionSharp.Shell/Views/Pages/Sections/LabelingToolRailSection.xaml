<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.LabelingToolRailSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingRailTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Margin="12,12,4,12"
            Padding="4"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="标注工具" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Appearance="Transparent"
                                AutomationProperties.AutomationId="dv.labeling.shortcuts-help"
                                Click="OnShortcutsHelpClicked"
                                Icon="{ui:SymbolIcon QuestionCircle24}"
                                ToolTip="快捷键指南">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="常用快捷键速查" IsEnabled="False" FontWeight="Bold" />
                                        <Separator />
                                        <MenuItem Header="Ctrl + S：保存当前标注" IsEnabled="False" />
                                        <MenuItem Header="← / →：切换上一张 / 下一张样本" IsEnabled="False" />
                                        <MenuItem Header="数字键 1~9：快速选择对应序号的标签类别" IsEnabled="False" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button
                                VerticalAlignment="Center"
                                Appearance="Transparent"
                                AutomationProperties.AutomationId="dv.labeling.back-to-gallery"
                                Command="{Binding BackToGalleryCommand}"
                                Icon="{ui:SymbolIcon ArrowLeft24}"
                                ToolTip="返回图库" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl
                    x:Name="ToolRailHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource LabelingToolRail.Classification}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Workspace.IsDetectionProject}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource LabelingToolRail.Detection}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Border>
</UserControl>
