<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/Sections/LabelingToolRailSection.axaml（左栏壳 + 快捷键按钮） | 转换: WPF-UI Button+SymbolIcon→Button+IvIconButtonStyle+yu:Icon；QuestionCircle24→Help、ArrowLeft24→ChevronLeft（近义降级）；颜色/圆角走 Iv* 令牌 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.LabelingToolRailSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:yu="http://schemas.yu-ui/xaml"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/yu-ui;component/YuUiTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingRailTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Margin="12,12,4,12"
            Padding="4"
            Background="{DynamicResource IvSurface2Brush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusOverlay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="标注工具" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="dv.labeling.shortcuts-help"
                                Click="OnShortcutsHelpClicked"
                                Style="{StaticResource IvIconButtonStyle}"
                                ToolTip="快捷键指南">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="常用快捷键速查" IsEnabled="False" FontWeight="Bold" />
                                        <Separator />
                                        <MenuItem Header="Ctrl + S：保存当前标注" IsEnabled="False" />
                                        <MenuItem Header="Ctrl + Z / Y：撤销 / 重做" IsEnabled="False" />
                                        <MenuItem Header="Delete：删除选中的框" IsEnabled="False" />
                                        <MenuItem Header="滚轮：缩放画布；中键拖动：平移" IsEnabled="False" />
                                        <MenuItem Header="← / →：切换上一张 / 下一张样本" IsEnabled="False" />
                                        <MenuItem Header="数字键 1~9：快速选择对应序号的标签类别" IsEnabled="False" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <!-- 源 SymbolIcon QuestionCircle24 → IvIcons.Help（直接等价） -->
                                <yu:Icon Data="{x:Static yu:IvIcons.Help}" ViewSize="{DynamicResource IvIconSize}" />
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="dv.labeling.back-to-gallery"
                                Command="{Binding BackToGalleryCommand}"
                                Style="{StaticResource IvIconButtonStyle}"
                                ToolTip="返回图库">
                                <!-- 源 SymbolIcon ArrowLeft24 → IvIcons.ChevronLeft（近义降级：长箭头变尖角） -->
                                <yu:Icon Data="{x:Static yu:IvIcons.ChevronLeft}" ViewSize="{DynamicResource IvIconSize}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl
                    x:Name="ToolRailHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource LabelingToolRail.Classification}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Workspace.IsDetectionProject}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource LabelingToolRail.Detection}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Border>
</UserControl>
