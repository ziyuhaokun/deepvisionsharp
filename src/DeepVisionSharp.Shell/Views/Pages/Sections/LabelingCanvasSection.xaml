<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/Sections/LabelingCanvasSection.axaml（画布 + 检测视图工具条） | 转换: 自绘工具条单元格按钮→IvIconButtonStyle 派生（去掉本地模板）；SymbolIcon→dvsui:Icon+ViewSize；颜色/字号/圆角走 Iv* 令牌 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.LabelingCanvasSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingRailTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              源是 28×28 自绘单元格按钮（透明底 + 悬停填充 + 禁用 0.4 透明度）。
              DeepVisionSharp.UI 的 IvIconButtonStyle 已覆盖同一套语义（28×28、透明描边、悬停叠加层、禁用态令牌），
              这里只保留键名，外观全部下沉到库样式。
            -->
            <Style x:Key="ViewToolbarCellButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IvIconButtonStyle}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border
            Margin="6"
            Background="{DynamicResource IvSurface2Brush}"
            BorderBrush="{Binding Labels.CurrentImageClassColor}"
            CornerRadius="{DynamicResource IvRadiusOverlay}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Labels.HasCurrentImageClass}" Value="True">
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Image
                    AutomationProperties.AutomationId="dv.labeling.canvas"
                    Source="{Binding Workspace.ImageSource}"
                    Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Workspace.IsDetectionProject}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <controls:BoxOverlayCanvas
                    x:Name="BoxLayer"
                    AutomationProperties.AutomationId="dv.labeling.box-layer"
                    ActiveLabel="{Binding Editor.ActiveBoxLabel}"
                    Boxes="{Binding Editor.Boxes}"
                    ImageSource="{Binding Workspace.ImageSource}"
                    EditCompletedCommand="{Binding Editor.NotifyBoxesEditedCommand}"
                    EditStartingCommand="{Binding Editor.BeginBoxEditCommand}"
                    ImageHeight="{Binding Workspace.ImageHeight}"
                    ImageWidth="{Binding Workspace.ImageWidth}"
                    IsReadOnly="{Binding Editor.IsEditorReadOnly}"
                    RedoCommand="{Binding Editor.RedoBoxEditCommand}"
                    SelectedBox="{Binding Editor.SelectedBox, Mode=TwoWay}"
                    ShowBoxNumbers="{Binding Editor.ShowBoxNumbers}"
                    ShowLabelNames="{Binding Editor.ShowLabelNames}"
                    Tool="{Binding Editor.ActiveToolMode}"
                    UndoCommand="{Binding Editor.UndoBoxEditCommand}"
                    ViewportRect="{Binding Editor.ViewportRect, Mode=OneWayToSource}"
                    Visibility="{Binding Workspace.IsDetectionProject, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ZoomScale="{Binding Editor.ZoomScale, Mode=TwoWay}" />
            </Grid>
        </Border>

        <controls:CanvasCornerFloat
            Panel.ZIndex="10"
            PinId="tl"
            Placement="TopLeft">
            <controls:CanvasCornerFloat.Body>
                <StackPanel>
                    <TextBlock
                        MaxWidth="380"
                        FontSize="{DynamicResource IvFontSizeBodySmall}"
                        FontWeight="SemiBold"
                        Text="{Binding Workspace.ActiveFileName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="{DynamicResource IvFontSizeSmall}"
                        Foreground="{DynamicResource IvText2Brush}"
                        Text="{Binding Workspace.ImageSizeText}" />
                </StackPanel>
            </controls:CanvasCornerFloat.Body>
        </controls:CanvasCornerFloat>

        <!-- Detection view toolbar: undo/redo, zoom, fit -->
        <Border
            Panel.ZIndex="10"
            Margin="12"
            Padding="2,2,3,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{DynamicResource IvSurface2Brush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusOverlay}"
            Visibility="{Binding Workspace.IsDetectionProject, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Direction="270"
                    Opacity="0.18"
                    ShadowDepth="2"
                    Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button
                    AutomationProperties.AutomationId="dv.labeling.view.undo"
                    Command="{Binding Editor.UndoBoxEditCommand}"
                    Style="{StaticResource ViewToolbarCellButtonStyle}"
                    ToolTip="撤销 (Ctrl+Z)">
                    <!-- 源 SymbolIcon ArrowUndo24 在 IvIcons 里没有等价几何，降级为 ChevronLeft -->
                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.ChevronLeft}" ViewSize="14" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="dv.labeling.view.redo"
                    Command="{Binding Editor.RedoBoxEditCommand}"
                    Style="{StaticResource ViewToolbarCellButtonStyle}"
                    ToolTip="重做 (Ctrl+Y)">
                    <!-- 源 SymbolIcon ArrowRedo24 在 IvIcons 里没有等价几何，降级为 ChevronRight -->
                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.ChevronRight}" ViewSize="14" />
                </Button>

                <Border
                    Width="1"
                    Height="16"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource IvStrokeSubtleBrush}" />

                <Button
                    AutomationProperties.AutomationId="dv.labeling.view.zoom-out"
                    Click="OnZoomOutClicked"
                    Style="{StaticResource ViewToolbarCellButtonStyle}"
                    ToolTip="缩小 (滚轮)">
                    <!-- 源 SymbolIcon Subtract24 在 IvIcons 里没有等价几何，降级为 WindowMinimize（同为一条横杠） -->
                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.WindowMinimize}" ViewSize="14" />
                </Button>
                <TextBlock
                    Width="44"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="dv.labeling.view.zoom"
                    FontSize="{DynamicResource IvFontSizeCaption}"
                    FontWeight="SemiBold"
                    Text="{Binding Editor.ZoomText}"
                    TextAlignment="Center" />
                <Button
                    AutomationProperties.AutomationId="dv.labeling.view.zoom-in"
                    Click="OnZoomInClicked"
                    Style="{StaticResource ViewToolbarCellButtonStyle}"
                    ToolTip="放大 (滚轮)">
                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.Add}" ViewSize="14" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="dv.labeling.view.fit"
                    Click="OnFitClicked"
                    Style="{StaticResource ViewToolbarCellButtonStyle}"
                    ToolTip="适应窗口">
                    <!-- 源 SymbolIcon FullScreenMaximize24 在 IvIcons 里没有等价几何，降级为 WindowMaximize（方框轮廓） -->
                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.WindowMaximize}" ViewSize="14" />
                </Button>
            </StackPanel>
        </Border>

        <controls:CanvasCornerFloat
            Panel.ZIndex="10"
            PinId="bl"
            Placement="BottomLeft"
            Visibility="{Binding Workspace.IsDetectionProject, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:CanvasCornerFloat.Body>
                <CheckBox
                    AutomationProperties.AutomationId="dv.labeling.show-label-names"
                    Content="显示标签名称"
                    FontSize="{DynamicResource IvFontSizeSmall}"
                    IsChecked="{Binding Editor.ShowLabelNames, Mode=TwoWay}" />
            </controls:CanvasCornerFloat.Body>
        </controls:CanvasCornerFloat>

        <Border
            Panel.ZIndex="10"
            Margin="0,0,18,18"
            Padding="10,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="dv.labeling.current-class"
            Background="{Binding Labels.CurrentImageClassColor}"
            CornerRadius="{DynamicResource IvRadiusOverlay}"
            Visibility="{Binding Workspace.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource IvFontSizeSmall}"
                    Foreground="White"
                    Opacity="0.85"
                    Text="当前标注" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource IvFontSizeBodySmall}"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding Labels.CurrentImageClassDisplay}"
                    Visibility="{Binding Workspace.IsClassificationProject, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource IvFontSizeBodySmall}"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding Editor.DetectionStatusText}"
                    Visibility="{Binding Workspace.IsDetectionProject, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
