<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.GalleryCardWallSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <!-- 行 2：独立滚动卡片墙 -->
        <ScrollViewer
            Grid.Row="2"
            Margin="28,14,28,10"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <!-- 空状态 -->
                <Border
                    Padding="36"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding List.HasEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="42"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="FolderOpen24" />
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding List.EmptyStateTitle}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding List.EmptyStateDescription}" />
                    </StackPanel>
                </Border>

                <!-- 响应式卡片网格 -->
                <ItemsControl
                    x:Name="GalleryCardsHost"
                    AutomationProperties.AutomationId="dv.gallery.cards"
                    ItemsSource="{Binding List.FilteredGalleries}"
                    Visibility="{Binding List.HasFilteredGalleries, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CardColumns}" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                Style="{StaticResource GalleryCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- 行 0: 封面图与顶层悬浮按钮 -->
                                        <RowDefinition Height="130" />
                                        <!-- 行 1: 标题与描述 -->
                                        <RowDefinition Height="Auto" />
                                        <!-- 行 2: 标注进度条 -->
                                        <RowDefinition Height="Auto" />
                                        <!-- 行 3: 元数据与底部操作栏 -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 行 0: 封面缩略图 -->
                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <Grid.Clip>
                                            <MultiBinding Converter="{StaticResource RoundedClipConverter}">
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                <Binding Source="8,8,0,0" />
                                            </MultiBinding>
                                        </Grid.Clip>

                                        <!-- 占位底色与图标 -->
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="36"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Symbol="Folder24" />
                                        </Border>

                                        <!-- 实际缩略图 -->
                                        <Image
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding Thumbnail}"
                                            Stretch="UniformToFill"
                                            Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <!-- 封面半透遮罩渐变 -->
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0.0" Color="#55000000" />
                                                    <GradientStop Offset="0.4" Color="#00000000" />
                                                    <GradientStop Offset="1.0" Color="#44000000" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- 顶层悬浮信息与操作按钮 -->
                                        <Grid Margin="8,8,8,0" VerticalAlignment="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 多选 CheckBox -->
                                            <CheckBox
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                Visibility="{Binding DataContext.List.IsGallerySelectionMode, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <!-- 编辑图库按钮 -->
                                            <ui:Button
                                                Grid.Column="2"
                                                Padding="6,4"
                                                Appearance="Transparent"
                                                AutomationProperties.AutomationId="{Binding EditAutomationId}"
                                                Background="#80000000"
                                                Command="{Binding DataContext.Editor.ShowEditGalleryDialogCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                CommandParameter="{Binding Id}"
                                                Icon="{ui:SymbolIcon Edit24}"
                                                ToolTip="编辑图库"
                                                Visibility="{Binding DataContext.List.ShowsGalleryEdit, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <!-- 打开目录按钮 -->
                                            <ui:Button
                                                Grid.Column="3"
                                                Margin="6,0,0,0"
                                                Padding="6,4"
                                                Appearance="Transparent"
                                                Background="#80000000"
                                                Command="{Binding DataContext.List.OpenGalleryFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                CommandParameter="{Binding Id}"
                                                Icon="{ui:SymbolIcon FolderOpen24}"
                                                ToolTip="打开目录" />
                                        </Grid>
                                    </Grid>

                                    <!-- 行 1: 标题与描述 -->
                                    <StackPanel Grid.Row="1" Margin="14,12,14,0">
                                        <TextBlock
                                            Style="{StaticResource GalleryCardTitleTextStyle}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource GalleryCardDescriptionTextStyle}"
                                            MaxHeight="36"
                                            Margin="0,4,0,0"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 行 2: 标注进度条 -->
                                    <StackPanel Grid.Row="2" Margin="14,10,14,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource GalleryCardMetaTextStyle}" Text="标注进度" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource GalleryCardBadgeTextStyle}"
                                                Text="{Binding ProgressText}" />
                                        </Grid>
                                        <ProgressBar
                                            Height="5"
                                            Margin="0,6,0,0"
                                            Maximum="1"
                                            Value="{Binding Progress, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 行 3: 元数据与底部操作栏 -->
                                    <Grid Grid.Row="3" Margin="14,12,14,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GalleryCardMetaTextStyle}" Text="{Binding SampleCountText}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource GalleryCardMetaTextStyle}"
                                                    Text="{Binding AnnotatedCountText}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource GalleryCardMetaTextStyle}"
                                                Text="{Binding LastUpdatedText}" />
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:Button
                                                Grid.Column="1"
                                                Margin="0,0,8,0"
                                                Appearance="Secondary"
                                                AutomationProperties.AutomationId="{Binding MoreAutomationId}"
                                                Click="OnGalleryActionsClicked"
                                                Icon="{ui:SymbolIcon MoreHorizontal24}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                                                ToolTip="更多操作">
                                                <ui:Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="dv.gallery.menu.import-images"
                                                            Command="{Binding PlacementTarget.Tag.Transfer.ImportImagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="导入图像" />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="dv.gallery.menu.import-folder"
                                                            Command="{Binding PlacementTarget.Tag.Transfer.ImportFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="导入目录" />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="dv.gallery.menu.export"
                                                            Command="{Binding PlacementTarget.Tag.Transfer.ExportGalleryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="导出图库" />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="dv.gallery.menu.batch-inference"
                                                            Command="{Binding PlacementTarget.Tag.BatchInference.ShowDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="图库推理…"
                                                            Visibility="{Binding PlacementTarget.Tag.List.ShowsGalleryBatchInference, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Separator />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="dv.gallery.menu.label-stats"
                                                            Command="{Binding PlacementTarget.Tag.List.ShowGalleryLabelStatisticsDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="标签统计"
                                                            Visibility="{Binding PlacementTarget.Tag.List.ShowsGalleryLabelStatistics, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="dv.gallery.menu.split"
                                                            Command="{Binding PlacementTarget.Tag.Reorganize.ShowSplitGalleryDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="拆分图库"
                                                            Visibility="{Binding PlacementTarget.Tag.List.ShowsGallerySplit, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="dv.gallery.menu.delete"
                                                            Command="{Binding PlacementTarget.Tag.Editor.ConfirmDeleteGalleryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="删除图库"
                                                            Visibility="{Binding PlacementTarget.DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </ContextMenu>
                                                </ui:Button.ContextMenu>
                                            </ui:Button>

                                            <ui:Button
                                                Grid.Column="2"
                                                Appearance="Primary"
                                                AutomationProperties.AutomationId="{Binding EnterAutomationId}"
                                                Command="{Binding DataContext.List.EnterGalleryCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                CommandParameter="{Binding Id}"
                                                Icon="{ui:SymbolIcon ArrowRight24}">
                                                进入
                                            </ui:Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

</UserControl>
