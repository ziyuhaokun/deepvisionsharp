<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.InferenceImageListSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/InferencePageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border
            x:Name="LeftListPanel"
            Margin="0,0,4,0"
            Padding="4"
            MinHeight="0"
            MinWidth="0"
            VerticalAlignment="Stretch"
            Background="{DynamicResource IvSurface2Brush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource IvRadiusOverlay}">
            <DockPanel LastChildFill="True" MinHeight="0">
                <Border
                    DockPanel.Dock="Top"
                    Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource PanelTitleStyle}"
                            Text="待推理列表" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{Binding ImageCount, StringFormat={}{0} 张}" />
                    </Grid>
                </Border>

                <!--
                  Explicit MaxHeight is refreshed in code-behind from LeftListPanel.ActualHeight.
                  ListBox will not expand the page even if host measure is unbounded.
                -->
                <ListBox
                    x:Name="ImageList"
                    Margin="4,4,4,0"
                    MinHeight="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    ItemContainerStyle="{StaticResource ImageListBoxItemStyle}"
                    ItemsSource="{Binding Images}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.PanningMode="VerticalOnly"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.SetExpectedOkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="预计：OK" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.SetExpectedNgCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="预计：NG" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.ClearExpectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="清除预计标记" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Border
                                    Width="44"
                                    Height="44"
                                    Background="{DynamicResource IvControlFillBrush}"
                                    ClipToBounds="True"
                                    CornerRadius="{DynamicResource IvRadiusOverlay}">
                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource IvText1Brush}"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                        <Border
                                            Margin="0,0,4,0"
                                            Padding="5,1"
                                            Background="{DynamicResource IvControlFillBrush}"
                                            CornerRadius="{DynamicResource IvRadiusControl}">
                                            <TextBlock
                                                FontSize="{DynamicResource IvFontSizeMini}"
                                                Foreground="{DynamicResource IvText2Brush}"
                                                Text="{Binding ExpectedLabelText}" />
                                        </Border>
                                        <Border
                                            Margin="0,0,4,0"
                                            Padding="5,1"
                                            Background="{DynamicResource IvControlFillBrush}"
                                            CornerRadius="{DynamicResource IvRadiusControl}">
                                            <TextBlock
                                                FontSize="{DynamicResource IvFontSizeMini}"
                                                Foreground="{DynamicResource IvText2Brush}"
                                                Text="{Binding PredictedLabelText}" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource IvFontSizeMini}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource IvAccentBrush}"
                                            Text="{Binding EvaluationTag}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
</UserControl>
