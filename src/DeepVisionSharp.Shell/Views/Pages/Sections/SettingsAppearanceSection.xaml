<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.SettingsAppearanceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:services="clr-namespace:DeepVisionSharp.Shell.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/SettingsPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                    <StackPanel Visibility="{Binding IsAppearanceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观" />
                        <ui:Card Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTileStyle}">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Symbol="PaintBrush24" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="主题模式" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <UniformGrid
                                    Margin="12,4,12,8"
                                    Columns="3"
                                    Rows="1">
                                    <RadioButton
                                        Margin="0,0,8,0"
                                        Command="{Binding SelectThemeCommand}"
                                        CommandParameter="{x:Static services:ShellThemePreference.System}"
                                        Content="自动"
                                        GroupName="ThemeMode"
                                        IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                                        Style="{StaticResource ThemeOptionButtonStyle}" />
                                    <RadioButton
                                        Margin="0,0,8,0"
                                        Command="{Binding SelectThemeCommand}"
                                        CommandParameter="{x:Static services:ShellThemePreference.Light}"
                                        Content="浅色"
                                        GroupName="ThemeMode"
                                        IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                                        Style="{StaticResource ThemeOptionButtonStyle}" />
                                    <RadioButton
                                        Command="{Binding SelectThemeCommand}"
                                        CommandParameter="{x:Static services:ShellThemePreference.Dark}"
                                        Content="深色"
                                        GroupName="ThemeMode"
                                        IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                                        Style="{StaticResource ThemeOptionButtonStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </ui:Card>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="通知" />
                        <ui:Card Style="{StaticResource SettingsCardStyle}">
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <ui:SymbolIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Symbol="Alert24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="启用通知" />
                                        <TextBlock
                                            Style="{StaticResource RowSubtitleStyle}"
                                            Text="任务完成与系统消息" />
                                    </StackPanel>
                                    <ui:ToggleSwitch
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding ShowNotifications, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </ui:Card>
                    </StackPanel>
</UserControl>
