<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.SettingsStorageSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:yu="http://schemas.yu-ui/xaml"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/SettingsPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                    <StackPanel Visibility="{Binding IsStorageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="本地占用" />
                        <UniformGrid
                            Margin="0,0,0,14"
                            Columns="2"
                            Rows="2">
                            <ContentControl
                                Margin="0,0,10,10"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource IvCardStyle}">
                                <DockPanel LastChildFill="True">
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding OpenAppDataFolderCommand}"
                                        DockPanel.Dock="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <yu:Icon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static yu:IvIcons.FolderOpen}"
                                                ViewSize="{DynamicResource IvIconSize}" />
                                            <TextBlock VerticalAlignment="Center" Text="打开" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <!-- 源 SymbolIcon Database24 → IvIcons.Tray（近义降级） -->
                                                <yu:Icon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{x:Static yu:IvIcons.Tray}"
                                                    ViewSize="{DynamicResource IvIconSize}" />
                                            </Border>
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IvText1Brush}"
                                                Text="应用数据" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MetricSizeStyle}" Text="{Binding AppDataSize}" />
                                        <TextBlock
                                            Style="{StaticResource PathCaptionStyle}"
                                            Text="{Binding AppDataDirectory}"
                                            ToolTip="{Binding AppDataDirectory}" />
                                    </StackPanel>
                                </DockPanel>
                            </ContentControl>

                            <ContentControl
                                Margin="0,0,0,10"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource IvCardStyle}">
                                <DockPanel LastChildFill="True">
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding OpenModelsFolderCommand}"
                                        DockPanel.Dock="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <yu:Icon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static yu:IvIcons.FolderOpen}"
                                                ViewSize="{DynamicResource IvIconSize}" />
                                            <TextBlock VerticalAlignment="Center" Text="打开" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <yu:Icon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{x:Static yu:IvIcons.Cube}"
                                                    ViewSize="{DynamicResource IvIconSize}" />
                                            </Border>
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IvText1Brush}"
                                                Text="预训练权重" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MetricSizeStyle}" Text="{Binding ModelsSize}" />
                                        <TextBlock
                                            Style="{StaticResource PathCaptionStyle}"
                                            Text="{Binding ModelsDirectory}"
                                            ToolTip="{Binding ModelsDirectory}" />
                                    </StackPanel>
                                </DockPanel>
                            </ContentControl>

                            <ContentControl
                                Margin="0,0,10,0"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource IvCardStyle}">
                                <DockPanel LastChildFill="True">
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding OpenLogsFolderCommand}"
                                        DockPanel.Dock="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <yu:Icon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static yu:IvIcons.FolderOpen}"
                                                ViewSize="{DynamicResource IvIconSize}" />
                                            <TextBlock VerticalAlignment="Center" Text="打开" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <yu:Icon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{x:Static yu:IvIcons.Document}"
                                                    ViewSize="{DynamicResource IvIconSize}" />
                                            </Border>
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IvText1Brush}"
                                                Text="日志文件" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MetricSizeStyle}" Text="{Binding LogsSize}" />
                                        <TextBlock
                                            Style="{StaticResource PathCaptionStyle}"
                                            Text="{Binding LogsDirectory}"
                                            ToolTip="{Binding LogsDirectory}" />
                                        <TextBlock
                                            Style="{StaticResource PathCaptionStyle}"
                                            Text="{Binding LogRetentionText}" />
                                    </StackPanel>
                                </DockPanel>
                            </ContentControl>

                            <ContentControl VerticalAlignment="Stretch" Style="{StaticResource IvCardStyle}">
                                <DockPanel LastChildFill="True">
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding OpenCrashDumpsFolderCommand}"
                                        DockPanel.Dock="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <yu:Icon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static yu:IvIcons.FolderOpen}"
                                                ViewSize="{DynamicResource IvIconSize}" />
                                            <TextBlock VerticalAlignment="Center" Text="打开" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <!-- 源 SymbolIcon Bug24 在 IvIcons 里没有等价几何，降级为 Warning -->
                                                <yu:Icon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{x:Static yu:IvIcons.Warning}"
                                                    ViewSize="{DynamicResource IvIconSize}" />
                                            </Border>
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IvText1Brush}"
                                                Text="崩溃转储" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MetricSizeStyle}" Text="{Binding CrashDumpsSize}" />
                                        <TextBlock
                                            Style="{StaticResource PathCaptionStyle}"
                                            Text="{Binding CrashDumpsDirectory}"
                                            ToolTip="{Binding CrashDumpsDirectory}" />
                                    </StackPanel>
                                </DockPanel>
                            </ContentControl>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="缓存维护" />
                        <ContentControl Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="缓存与未引用训练数据" />
                                    <TextBlock
                                        Style="{StaticResource RowSubtitleStyle}"
                                        Text="清理缓存和无任务引用的旧训练目录，不影响图库与模型。日志按保留天数自动清理，无需手动操作。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!-- 源 WPF-UI ProgressRing（18×18 环）→ 不确定态 ProgressBar（条形） -->
                                    <ProgressBar
                                        Width="48"
                                        Height="6"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsCleaningCache, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding RefreshStorageInfoCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <yu:Icon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static yu:IvIcons.Refresh}"
                                                ViewSize="{DynamicResource IvIconSize}" />
                                            <TextBlock VerticalAlignment="Center" Text="刷新" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Command="{Binding ClearCacheCommand}"
                                        IsEnabled="{Binding IsNotCleaningCache}">
                                        <StackPanel Orientation="Horizontal">
                                            <yu:Icon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static yu:IvIcons.Delete}"
                                                ViewSize="{DynamicResource IvIconSize}" />
                                            <TextBlock VerticalAlignment="Center" Text="清理缓存" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
</UserControl>
