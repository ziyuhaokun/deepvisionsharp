<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.LabelingWorkbenchSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingRailTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Grid.Column="1"
        Margin="4,12,4,12"
        Padding="4"
        Background="{DynamicResource ControlFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <sections:LabelingCanvasSection Grid.Row="0" />
            <sections:LabelingFilmStripSection Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
