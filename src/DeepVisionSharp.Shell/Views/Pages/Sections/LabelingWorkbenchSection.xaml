<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/Sections/LabelingWorkbenchSection.axaml | 转换: WPF-UI 颜色→Iv* 令牌；面板底色/描边/圆角走 IvSurface2Brush/IvStrokeSubtleBrush/IvRadiusOverlay -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.LabelingWorkbenchSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/yu-ui;component/YuUiTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingRailTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Grid.Column="1"
        Margin="4,12,4,12"
        Padding="4"
        Background="{DynamicResource IvSurface2Brush}"
        BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource IvRadiusOverlay}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <sections:LabelingCanvasSection Grid.Row="0" />
            <sections:LabelingFilmStripSection Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
