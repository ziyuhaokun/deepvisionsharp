<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/GalleryPage.axaml（保存中 / 传输中遮罩） | 转换: WPF-UI Card 的 Padding→ContentControl.Padding（IvCardStyle）；ProgressRing→ProgressBar 不确定态（占位尺寸从 32×32 环重排为 32×6 条）；遮罩色→IvOverlayBrush；字号走 Iv* 令牌 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.GalleryOverlaySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/yu-ui;component/YuUiTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- 保存中全屏遮罩 -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Padding="24"
            Panel.ZIndex="90"
            d:Visibility="Hidden"
            Background="{DynamicResource IvOverlayBrush}"
            Visibility="{Binding Editor.IsSavingGallery, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl
                Padding="24"
                HorizontalAlignment="Center"
                Style="{StaticResource IvCardStyle}"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar
                        Width="32"
                        Height="6"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource IvFontSizeSubtitle}"
                        FontWeight="SemiBold"
                        Text="正在处理图库…" />
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- 传输中全屏遮罩 -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Padding="24"
            Panel.ZIndex="100"
            d:Visibility="Hidden"
            Background="{DynamicResource IvOverlayBrush}"
            Visibility="{Binding Transfer.IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl
                Width="420"
                Padding="24"
                HorizontalAlignment="Center"
                Style="{StaticResource IvCardStyle}"
                VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 源是 40×40 的请转圈；换成不确定态 ProgressBar 后给 6px 高度，否则 44px 高的扫条会整块盖住左列 -->
                        <ProgressBar
                            Width="44"
                            Height="6"
                            VerticalAlignment="Center"
                            IsIndeterminate="True" />

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock
                                FontSize="{DynamicResource IvFontSizeHeading}"
                                FontWeight="SemiBold"
                                Text="{Binding Transfer.ImportStage}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="{DynamicResource IvFontSizeBodySmall}"
                                Foreground="{DynamicResource IvText2Brush}"
                                Text="{Binding Transfer.ImportCurrentFile}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        Height="8"
                        Margin="0,22,0,0"
                        Maximum="1"
                        Value="{Binding Transfer.ImportProgressValue, Mode=OneWay}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        FontSize="{DynamicResource IvFontSizeBodySmall}"
                        Foreground="{DynamicResource IvText2Brush}"
                        Text="{Binding Transfer.ImportProgressText}" />
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
