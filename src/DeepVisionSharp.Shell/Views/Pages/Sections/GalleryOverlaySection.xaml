<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.GalleryOverlaySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- 保存中全屏遮罩 -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Padding="24"
            Panel.ZIndex="90"
            d:Visibility="Hidden"
            Background="#80000000"
            Visibility="{Binding Editor.IsSavingGallery, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="32"
                        Height="32"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="正在处理图库…" />
                </StackPanel>
            </ui:Card>
        </Border>

        <!-- 传输中全屏遮罩 -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Padding="24"
            Panel.ZIndex="100"
            d:Visibility="Hidden"
            Background="#99000000"
            Visibility="{Binding Transfer.IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card
                Width="420"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar
                            Width="44"
                            Height="44"
                            IsIndeterminate="True" />

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding Transfer.ImportStage}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Transfer.ImportCurrentFile}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        Height="8"
                        Margin="0,22,0,0"
                        Maximum="1"
                        Value="{Binding Transfer.ImportProgressValue, Mode=OneWay}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Transfer.ImportProgressText}" />
                </StackPanel>
            </ui:Card>
        </Border>
    </Grid>
</UserControl>
