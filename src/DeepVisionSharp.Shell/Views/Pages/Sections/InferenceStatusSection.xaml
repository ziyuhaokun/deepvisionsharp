<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.InferenceStatusSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/yu-ui;component/YuUiTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/InferencePageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Grid.Row="2"
            Margin="0,8,0,0"
            Padding="10,6"
            MinHeight="32"
            Background="{DynamicResource IvSurface2Brush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusOverlay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource IvControlFillBrush}"
                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource IvRadiusOverlay}">
                    <TextBlock
                        AutomationProperties.AutomationId="dv.inference.status"
                        FontSize="{DynamicResource IvFontSizeSmall}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IvText1Brush}"
                        Text="{Binding StatusBarState}" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource IvFontSizeCaption}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource IvText1Brush}"
                    Text="{Binding StatusBarPerfText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding StatusBarPerfText}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource IvFontSizeSmall}"
                    Foreground="{DynamicResource IvText2Brush}"
                    Text="{Binding StatusBarDeviceText}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
</UserControl>
