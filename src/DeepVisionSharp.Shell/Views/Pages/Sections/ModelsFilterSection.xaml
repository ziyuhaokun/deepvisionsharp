<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.ModelsFilterSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/ModelsPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid MinWidth="320">
                    <TextBox
                        Padding="30,0,8,0"
                        Text="{Binding List.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        dvsui:IvPlaceholder.Text="搜索模型名称或描述..." />
                    <dvsui:Icon
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Data="{x:Static dvsui:IvIcons.Search}"
                        Foreground="{DynamicResource IvText3Brush}"
                        IsHitTestVisible="False"
                        ViewSize="{DynamicResource IvIconSize}" />
                </Grid>

                <ComboBox
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding List.StatusOptions}"
                    SelectedValue="{Binding List.SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value" />

                <TextBlock
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource IvText2Brush}"
                    Text="{Binding List.ResultSummary}" />

                <Button
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    Command="{Binding List.ClearFiltersCommand}">
                    <StackPanel Orientation="Horizontal">
                        <dvsui:Icon
                            VerticalAlignment="Center"
                            Data="{x:Static dvsui:IvIcons.Refresh}"
                            ViewSize="{DynamicResource IvIconSize}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="清除筛选" />
                    </StackPanel>
                </Button>
            </Grid>
</UserControl>
