<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/DashboardPage.axaml（行 1 筛选栏） | 转换: TextBox PlaceholderText→dvsui:IvPlaceholder.Text；iv:Icon→dvsui:Icon（FontSize 15 → ViewSize 15，源的 16×16 命中框保留为 Width/Height）；ComboBox 的 SelectedValueBinding+ItemTemplate → SelectedValuePath+DisplayMemberPath -->
<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardFilterSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 源 StackPanel Margin="0,20,0,0" Orientation="Horizontal"：搜索框固定 420 宽，类型筛选固定 176 宽 -->
    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
        <!-- 源 Grid Width=420：TextBox Height=34 / Padding=34,0,10,0 / 13 号字，图标压在框内左侧 11 -->
        <Grid Width="420">
            <TextBox
                Height="34"
                Padding="34,0,10,0"
                VerticalContentAlignment="Center"
                FontSize="{DynamicResource IvFontSizeBodySmall}"
                Text="{Binding List.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                dvsui:IvPlaceholder.Text="搜索项目名称或描述..." />
            <dvsui:Icon
                Width="16"
                Height="16"
                Margin="11,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Data="{x:Static dvsui:IvIcons.Search}"
                Foreground="{DynamicResource IvText3Brush}"
                IsHitTestVisible="False"
                ViewSize="15" />
        </Grid>

        <!-- 源 ComboBox Width=176 / Height=34 / Margin=10,0,0,0 -->
        <ComboBox
            Width="176"
            Height="34"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            ItemsSource="{Binding List.ProjectTypeOptions}"
            SelectedValue="{Binding List.SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedValuePath="Value">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</UserControl>
