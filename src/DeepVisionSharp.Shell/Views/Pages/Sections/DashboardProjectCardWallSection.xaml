<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/DashboardPage.axaml（卡片墙 ItemsControl + 卡片模板） | 转换: Border.projectCard→ContentControl+ProjectCardStyle（保留卡片级 AutomationId）；ImageBrush/BlurEffect/ScaleTransform/TextTrimming 原生可用；项目类型图标源用 ProjectTypeVisualConverter=Icon，本仓库转换器无 Icon 参数，沿用 DataTrigger 按 TypeKey 取 IvIcons 几何 -->
<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardProjectCardWallSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 源 ItemsControl（无外边距，间距由父级 StackPanel 的 0,16,0,8 负责；列数由页面按可用宽度算出的 CardColumns 决定） -->
    <ItemsControl
        x:Name="ProjectCardsHost"
        HorizontalAlignment="Stretch"
        AutomationProperties.AutomationId="dv.dashboard.project-cards"
        d:ItemsSource="{d:SampleData ItemCount=6}"
        ItemsSource="{Binding List.FilteredProjects}"
        Visibility="{Binding List.HasFilteredProjects, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding CardColumns}" HorizontalAlignment="Stretch" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <ContentControl
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    Style="{StaticResource ProjectCardStyle}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40*" />
                            <ColumnDefinition Width="60*" />
                        </Grid.ColumnDefinitions>

                        <!-- 源左栏 Border：ClipToBounds / 圆角 5,0,0,5 / 类型底色 -->
                        <Border
                            Grid.Column="0"
                            Background="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Tint}"
                            ClipToBounds="True"
                            CornerRadius="5,0,0,5">
                            <Grid>
                                <!-- 模糊放大的封面铺底（源 Opacity=0.55 + BlurEffect 14 + ScaleTransform 1.12） -->
                                <Border
                                    CornerRadius="5,0,0,5"
                                    Opacity="0.55"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- 缩略图不能写成 Border.Background 里的 ImageBrush：
                                         Freezable 不参与 DataContext 继承，绑定会报
                                         "Cannot find governing FrameworkElement"（缩略图永远不显示）。
                                         改成 Border 内放 Image，绑定落在 FrameworkElement 上。 -->
                                    <Image
                                        Source="{Binding Thumbnail}"
                                        Stretch="UniformToFill" />
                                    <Border.Effect>
                                        <BlurEffect Radius="14" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- 源半透明压暗层：硬编码 #66000000，令牌表无同值取色，照抄常量 -->
                                <Border
                                    Background="#66000000"
                                    CornerRadius="5,0,0,5"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- 居中完整封面（源 Margin=9 / 圆角 3 / Stretch=Uniform） -->
                                <Border
                                    Margin="9"
                                    CornerRadius="3"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Image
                                        Source="{Binding Thumbnail}"
                                        Stretch="Uniform" />
                                </Border>

                                <!-- 无封面时的类型图标（源 FontSize=30，居中） -->
                                <dvsui:Icon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Foreground}"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    ViewSize="30">
                                    <dvsui:Icon.Style>
                                        <Style TargetType="{x:Type dvsui:Icon}">
                                            <Setter Property="Data" Value="{x:Static dvsui:IvIcons.Image}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TypeKey}" Value="{x:Static vo:ProjectTypes.Detection}">
                                                    <Setter Property="Data" Value="{x:Static dvsui:IvIcons.Scan}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dvsui:Icon.Style>
                                </dvsui:Icon>
                            </Grid>
                        </Border>

                        <!-- 源右栏 Grid Margin="16,12,14,12"，行 Auto,Auto,Auto,*,Auto,Auto -->
                        <Grid Grid.Column="1" Margin="16,12,14,12">
                            <Grid.RowDefinitions>
                                <!-- 行 0：类型 chip -->
                                <RowDefinition Height="Auto" />
                                <!-- 行 1：标题 -->
                                <RowDefinition Height="Auto" />
                                <!-- 行 2：描述 -->
                                <RowDefinition Height="Auto" />
                                <!-- 行 3：弹性留白 -->
                                <RowDefinition Height="*" />
                                <!-- 行 4：样本数 / 标签数 -->
                                <RowDefinition Height="Auto" />
                                <!-- 行 5：更新时间 + 进入项目 -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 源 Border.typeChip（Height=20 / Padding=6,0 / 圆角 3）+ Margin 0,0,32,0 给右上角操作按钮留位 -->
                            <Border
                                Grid.Row="0"
                                Margin="0,0,32,0"
                                Background="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Tint}"
                                Style="{StaticResource TypeChipStyle}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse
                                        Width="5"
                                        Height="5"
                                        VerticalAlignment="Center"
                                        Fill="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Badge}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource TypeChipTextStyle}"
                                        Text="{Binding TypeLabel}" />
                                </StackPanel>
                            </Border>

                            <!-- 源 Margin=0,5,32,0 + TextBlock.projectTitle + CharacterEllipsis -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,5,32,0"
                                Style="{StaticResource ProjectTitleTextStyle}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- 源 MaxHeight=37 + Margin=0,6,0,0 + TextBlock.projectDescription -->
                            <TextBlock
                                Grid.Row="2"
                                MaxHeight="37"
                                Margin="0,6,0,0"
                                Style="{StaticResource ProjectDescriptionTextStyle}"
                                Text="{Binding Description}" />

                            <!-- 源 Margin=0,10,0,0 的双指标行：样本数（间距 16）+ 标签数 -->
                            <StackPanel
                                Grid.Row="4"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                                <StackPanel
                                    Margin="0,0,16,0"
                                    Orientation="Horizontal">
                                    <dvsui:Icon
                                        VerticalAlignment="Center"
                                        Data="{x:Static dvsui:IvIcons.Image}"
                                        Foreground="{DynamicResource IvText3Brush}"
                                        ViewSize="14" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ProjectMetaTextStyle}"
                                        Text="{Binding SampleCountText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <dvsui:Icon
                                        VerticalAlignment="Center"
                                        Data="{x:Static dvsui:IvIcons.Flag}"
                                        Foreground="{DynamicResource IvText3Brush}"
                                        ViewSize="14" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ProjectMetaTextStyle}"
                                        Text="{Binding LabelCountText}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 源 Margin=0,8,0,0，列 *,Auto：更新时间 + 「进入项目」 -->
                            <Grid Grid.Row="5" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <dvsui:Icon
                                        VerticalAlignment="Center"
                                        Data="{x:Static dvsui:IvIcons.Clock}"
                                        Foreground="{DynamicResource IvText3Brush}"
                                        ViewSize="14" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource IvFontSizeCaption}"
                                        Foreground="{DynamicResource IvText2Brush}"
                                        Text="{Binding LastUpdatedText}"
                                        ToolTip="{Binding CreatedAt, StringFormat=创建于 {0}}" />
                                </StackPanel>

                                <!-- 源顺序：文字在前、箭头在后（Margin 6,0,0,0 / FontSize 14） -->
                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="{Binding EnterAutomationId}"
                                    Command="{Binding DataContext.List.EnterProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                    CommandParameter="{Binding Id}"
                                    Style="{StaticResource IvSubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="进入项目" />
                                        <dvsui:Icon
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Data="{x:Static dvsui:IvIcons.ArrowRight}"
                                            ViewSize="14" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 源 dv:ContextMenuButton：右栏右上角 28×28 溢出菜单；WPF 用 Button+ContextMenu，Click 打开菜单 -->
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="2"
                                Click="OnProjectActionsClicked"
                                Style="{StaticResource IvIconButtonStyle}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                                ToolTip="编辑、导出或删除项目">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.Editor.ShowEditProjectDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="编辑项目" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.Transfer.ExportProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="导出项目" />
                                        <Separator />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.List.ConfirmDeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="删除项目" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <dvsui:Icon Data="{x:Static dvsui:IvIcons.More}" ViewSize="{DynamicResource IvIconSize}" />
                            </Button>
                        </Grid>
                    </Grid>
                </ContentControl>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
