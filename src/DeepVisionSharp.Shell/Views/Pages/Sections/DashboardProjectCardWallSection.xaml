<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardProjectCardWallSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <!-- 项目卡片墙：WrapPanel 自动换行，卡片固定宽度，滚动浏览全部项目 -->
                <ItemsControl
                    x:Name="ProjectCardsHost"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="dv.dashboard.project-cards"
                    d:ItemsSource="{d:SampleData ItemCount=6}"
                    ItemsSource="{Binding List.FilteredProjects}"
                    Visibility="{Binding List.HasFilteredProjects, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CardColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                Style="{StaticResource ProjectCardStyle}">
                                <ui:Card.RenderTransform>
                                    <TranslateTransform />
                                </ui:Card.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42*" />
                                        <ColumnDefinition Width="58*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="Auto"
                                        Height="Auto"
                                        Padding="0"
                                        ClipToBounds="True"
                                        CornerRadius="8,0,0,8"
                                        Background="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Tint}"
                                        Style="{StaticResource ProjectTypeIconBorderStyle}">
                                        <Grid>
                                            <Image
                                                Source="{Binding Thumbnail}"
                                                Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <MultiBinding Converter="{StaticResource RoundedClipConverter}" ConverterParameter="8">
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                    </MultiBinding>
                                                </Image.Clip>
                                                <Image.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                <!-- Setter 兜底：即使 EnterActions 未触发（容器复用/时序竞争），封面也一定可见 -->
                                                                <Setter Property="Opacity" Value="1" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetProperty="Opacity"
                                                                                From="0"
                                                                                To="1"
                                                                                Duration="0:0:0.25">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="34"
                                                Foreground="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Foreground}"
                                                Symbol="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Icon}">
                                                <ui:SymbolIcon.Style>
                                                    <Style
                                                        BasedOn="{StaticResource ProjectTypeIconStyle}"
                                                        TargetType="{x:Type ui:SymbolIcon}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>

                                            <Border
                                                Margin="12"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{Binding TypeKey, Converter={StaticResource ProjectTypeVisualConverter}, ConverterParameter=Badge}"
                                                Style="{StaticResource ProjectTypeBadgeStyle}">
                                                <TextBlock
                                                    Style="{StaticResource ProjectCardBadgeTextStyle}"
                                                    Text="{Binding TypeLabel}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="16,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Title leaves room for the card-level actions button (overlay top-right). -->
                                        <TextBlock
                                            Margin="0,0,44,0"
                                            Style="{StaticResource ProjectCardTitleTextStyle}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="1"
                                            MaxHeight="38"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource ProjectCardDescriptionTextStyle}"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />

                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                            <Border Style="{StaticResource ProjectMetaPillStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon FontSize="14" Symbol="Image24" />
                                                    <TextBlock
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ProjectCardMetaTextStyle}"
                                                        Text="{Binding SampleCountText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource ProjectMetaPillStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon FontSize="14" Symbol="TagMultiple24" />
                                                    <TextBlock
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ProjectCardMetaTextStyle}"
                                                        Text="{Binding LabelCountText}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Symbol="Clock24" />
                                                <TextBlock
                                                    Margin="5,0,0,0"
                                                    Style="{StaticResource ProjectCardMetaTextStyle}"
                                                    Text="{Binding LastUpdatedText, StringFormat=更新于 {0}}"
                                                    ToolTip="{Binding CreatedAt, StringFormat=创建于 {0}}" />
                                            </StackPanel>

                                            <ui:Button
                                                HorizontalAlignment="Right"
                                                Appearance="Secondary"
                                                AutomationProperties.AutomationId="{Binding EnterAutomationId}"
                                                Command="{Binding DataContext.List.EnterProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                CommandParameter="{Binding Id}"
                                                Icon="{ui:SymbolIcon ArrowRight24}">
                                                进入项目
                                            </ui:Button>
                                        </Grid>
                                    </Grid>

                                    <!-- Card-level overflow menu: top-right of the entire project card. -->
                                    <ui:Button
                                        Grid.ColumnSpan="2"
                                        Margin="10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="2"
                                        Appearance="Secondary"
                                        Click="OnProjectActionsClicked"
                                        Icon="{ui:SymbolIcon MoreHorizontal24}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                                        ToolTip="编辑、导出或删除项目">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.Editor.ShowEditProjectDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="编辑项目" />
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.Transfer.ExportProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="导出项目" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.List.ConfirmDeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="删除项目" />
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
</UserControl>
