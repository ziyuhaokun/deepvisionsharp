<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.InferenceToolsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/InferencePageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Grid.Column="2"
            Margin="0"
            Padding="4"
            MinHeight="0"
            MinWidth="0"
            VerticalAlignment="Stretch"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="8">
            <TabControl
                MinHeight="0"
                SelectedIndex="{Binding SelectedRightTabIndex, Mode=TwoWay}"
                Background="Transparent"
                BorderThickness="0">

                <!-- Tab 1: 推理配置 -->
                <TabItem Header="推理配置" FontSize="13" FontWeight="SemiBold">
                    <ScrollViewer
                        Padding="4,8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource ToolSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="模型" />
                                    <ComboBox
                                        AutomationProperties.AutomationId="dv.inference.model"
                                        DisplayMemberPath="DisplayText"
                                        IsEnabled="{Binding HasProjectContext}"
                                        ItemsSource="{Binding Models}"
                                        SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
                                    <StackPanel Visibility="{Binding ShowsInferenceDeviceSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="推理设备" />
                                        <ComboBox
                                            AutomationProperties.AutomationId="dv.inference.device"
                                            DisplayMemberPath="DisplayName"
                                            IsEnabled="{Binding HasProjectContext}"
                                            ItemsSource="{Binding DeviceOptions}"
                                            SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="置信度阈值"
                                        Visibility="{Binding ShowsConfidenceThreshold, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:NumberBox
                                        Maximum="1"
                                        Minimum="0.01"
                                        SmallChange="0.05"
                                        Value="{Binding ConfidenceThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding ShowsConfidenceThreshold, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="二分类下置信度天然不低于 0.5；要拒绝低置信样本，阈值需大于 0.5。"
                                        Visibility="{Binding ShowsConfidenceThreshold, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="最大结果数"
                                        Visibility="{Binding ShowsMaxDetections, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:NumberBox
                                        Maximum="1000"
                                        Minimum="1"
                                        SmallChange="10"
                                        Value="{Binding MaxDetections, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding ShowsMaxDetections, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="NMS IoU"
                                        Visibility="{Binding ShowsNmsIou, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:NumberBox
                                        Maximum="0.95"
                                        Minimum="0.05"
                                        SmallChange="0.05"
                                        Value="{Binding NmsIou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding ShowsNmsIou, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="IoU 越高保留的重叠框越少，检测模型默认 0.45。"
                                        Visibility="{Binding ShowsNmsIou, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: 推理结果明细 -->
                <TabItem Header="推理结果" FontSize="13" FontWeight="SemiBold">
                    <ScrollViewer
                        Padding="4,8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Current Sample Info & Actions -->
                            <Border Style="{StaticResource ToolSectionStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="当前样本信息" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding ActiveFileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ImageSizeText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding EvaluationSummaryText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasEvaluationPairs, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding SelectedImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:Button
                                            Padding="10,3"
                                            Appearance="Secondary"
                                            Command="{Binding SetExpectedOkCommand}"
                                            CommandParameter="{Binding SelectedImage}"
                                            Content="预计 OK"
                                            FontSize="11" />
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="10,3"
                                            Appearance="Secondary"
                                            Command="{Binding SetExpectedNgCommand}"
                                            CommandParameter="{Binding SelectedImage}"
                                            Content="预计 NG"
                                            FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Headline & Detail -->
                            <Border
                                Style="{StaticResource ToolSectionStyle}"
                                Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock
                                        AutomationProperties.AutomationId="dv.inference.result-headline"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding ResultHeadline}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ResultDetail}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultDetail}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ResultDetail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:Button
                                        Margin="0,8,0,0"
                                        Padding="10,3"
                                        HorizontalAlignment="Left"
                                        Appearance="Primary"
                                        AutomationProperties.AutomationId="dv.inference.adopt-boxes"
                                        Command="{Binding AdoptPredictedBoxesCommand}"
                                        Content="采纳预测框为标注"
                                        FontSize="11"
                                        Visibility="{Binding CanAdoptPredictedBoxes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel
                                        Margin="0,6,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding SelectedImage.HasPredicted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border
                                            Padding="6,2"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding SelectedImage.PredictedLabelText}" />
                                        </Border>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            Text="{Binding SelectedImage.EvaluationTag}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Empty Hint when no result -->
                            <TextBlock
                                Margin="0,12,0,12"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"
                                Text="运行后在此显示推理结果与类别明细"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Class result rows -->
                            <Border
                                Style="{StaticResource ToolSectionStyle}"
                                Visibility="{Binding ShowResultRowList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        Margin="0,0,0,8"
                                        Text="结果明细" />
                                    <ListBox
                                        MinHeight="0"
                                        MaxHeight="360"
                                        AutomationProperties.AutomationId="dv.inference.result-rows"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        ItemContainerStyle="{StaticResource ImageListBoxItemStyle}"
                                        ItemsSource="{Binding ResultRows}"
                                        ScrollViewer.CanContentScroll="True"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.PanningMode="VerticalOnly"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedResultRow, Mode=TwoWay}"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Text="{Binding ClassName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding GeometryText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasBox}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding ConfidenceText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
</UserControl>
