<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/Sections/LabelingFilmStripSection.axaml（样本条带） | 转换: WPF-UI Button+SymbolIcon→Button+yu:Icon（导航按钮走 IvIconButtonStyle 派生）；SymbolIcon→yu:Icon+ViewSize；颜色/字号/圆角走 Iv* 令牌；横向条带布局结构不变 -->
<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.LabelingFilmStripSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:yu="http://schemas.yu-ui/xaml"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingWorkbenchResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Labeling/LabelingRailTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="SampleTileTemplate">
                <Border
                    MouseLeftButtonUp="OnSampleTileMouseLeftButtonUp"
                    Style="{StaticResource SampleTileStyle}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="OnSetSampleAnchorMenuItemClicked" Header="设为标注锚点">
                                <MenuItem.Style>
                                    <Style TargetType="{x:Type MenuItem}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Click="OnClearSampleAnchorMenuItemClicked" Header="取消标注锚点">
                                <MenuItem.Style>
                                    <Style TargetType="{x:Type MenuItem}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Click="OnDeleteSampleMenuItemClicked" Header="删除样本" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ClipToBounds="True">
                            <Image
                                Source="{Binding Thumbnail}"
                                Stretch="UniformToFill" />
                            <yu:Icon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource IvText3Brush}"
                                ViewSize="20">
                                <yu:Icon.Style>
                                    <Style TargetType="{x:Type yu:Icon}">
                                        <Setter Property="Data" Value="{x:Static yu:IvIcons.Image}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </yu:Icon.Style>
                            </yu:Icon>

                            <StackPanel
                                Margin="4,4,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    IsHitTestVisible="True" />
                                <Border
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SampleIndexBadgeStyle}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource IvFontSizeMini}"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Index}" />
                                </Border>
                            </StackPanel>

                            <StackPanel
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <yu:Icon
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource IvWarningBrush}"
                                    ToolTip="标注锚点"
                                    ViewSize="12">
                                    <yu:Icon.Style>
                                        <Style TargetType="{x:Type yu:Icon}">
                                            <!-- 源 SymbolIcon Pin24 → IvIcons.Flag（近义降级：图钉变旗） -->
                                            <Setter Property="Data" Value="{x:Static yu:IvIcons.Flag}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </yu:Icon.Style>
                                </yu:Icon>
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Stroke="#66000000"
                                    StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource IvText3Brush}" />
                                            <Setter Property="ToolTip" Value="未标注" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnnotated}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource IvSuccessBrush}" />
                                                    <Setter Property="ToolTip" Value="已标注" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource IvDangerBrush}" />
                                                    <Setter Property="ToolTip" Value="异常" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Padding="4,3"
                            Background="{DynamicResource IvSurface2Brush}">
                            <TextBlock
                                FontSize="{DynamicResource IvFontSizeMini}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource IvText1Brush}"
                                Text="{Binding FileName}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding FileName}" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
    </ResourceDictionary>
    </UserControl.Resources>
                <Border
                    Grid.Row="1"
                    Margin="6,0,6,4"
                    Padding="8,6"
                    Background="{DynamicResource IvSurface2Brush}"
                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource IvRadiusOverlay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar: title + progress | primary sample nav | page nav + collapse -->
                        <Grid MinHeight="32" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource IvFontSizeBodySmall}"
                                    FontWeight="SemiBold"
                                    Text="样本列表" />
                                <Border
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SampleProgressBadgeStyle}">
                                    <TextBlock
                                        FontSize="{DynamicResource IvFontSizeSmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource IvSuccessBrush}"
                                        Text="{Binding Workspace.GalleryProgressText}" />
                                </Border>
                            </StackPanel>

                            <!-- Primary: sample navigation -->
                            <Border
                                Grid.Column="1"
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                                CornerRadius="{DynamicResource IvRadiusOverlay}"
                                Visibility="{Binding Samples.HasSamples, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        AutomationProperties.AutomationId="dv.labeling.sample.prev"
                                        Command="{Binding Samples.NavigatePreviousSampleCommand}"
                                        Style="{StaticResource SampleNavButtonStyle}"
                                        ToolTip="上一张">
                                        <yu:Icon Data="{x:Static yu:IvIcons.ChevronLeft}" ViewSize="{DynamicResource IvIconSize}" />
                                    </Button>
                                    <TextBlock
                                        MinWidth="56"
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="dv.labeling.sample.position"
                                        FontSize="{DynamicResource IvFontSizeBodySmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource IvText1Brush}"
                                        Text="{Binding Samples.ActiveSamplePositionText}"
                                        TextAlignment="Center" />
                                    <Button
                                        AutomationProperties.AutomationId="dv.labeling.sample.next"
                                        Command="{Binding Samples.NavigateNextSampleCommand}"
                                        Style="{StaticResource SampleNavButtonStyle}"
                                        ToolTip="下一张（→；差异分类可用 Tab）">
                                        <yu:Icon Data="{x:Static yu:IvIcons.ChevronRight}" ViewSize="{DynamicResource IvIconSize}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <!-- Secondary: page navigation (A1) -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Samples.IsSamplePanelExpanded}" Value="True" />
                                                        <Condition Binding="{Binding Samples.HasSamples}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource IvFontSizeSmall}"
                                        Foreground="{DynamicResource IvText3Brush}"
                                        Text="页" />
                                    <Button
                                        Command="{Binding Samples.GoToPreviousSamplePageCommand}"
                                        Style="{StaticResource SamplePageNavButtonStyle}"
                                        ToolTip="上一页">
                                        <yu:Icon Data="{x:Static yu:IvIcons.ChevronLeft}" ViewSize="{DynamicResource IvIconSize}" />
                                    </Button>
                                    <TextBlock
                                        MinWidth="40"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource IvFontSizeSmall}"
                                        Foreground="{DynamicResource IvText2Brush}"
                                        Text="{Binding Samples.SamplePageText}"
                                        TextAlignment="Center" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding Samples.GoToNextSamplePageCommand}"
                                        Style="{StaticResource SamplePageNavButtonStyle}"
                                        ToolTip="下一页">
                                        <yu:Icon Data="{x:Static yu:IvIcons.ChevronRight}" ViewSize="{DynamicResource IvIconSize}" />
                                    </Button>
                                </StackPanel>
                                <Button Command="{Binding Samples.ToggleSamplePanelCommand}" Style="{StaticResource SamplePanelToggleButtonStyle}">
                                    <!-- 源在样式里用 Setter Property="Icon" 切换箭头，这里改成 yu:Icon + 同一 DataTrigger -->
                                    <yu:Icon ViewSize="{DynamicResource IvIconSize}">
                                        <yu:Icon.Style>
                                            <Style TargetType="{x:Type yu:Icon}">
                                                <Setter Property="Data" Value="{x:Static yu:IvIcons.ChevronDown}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Samples.IsSamplePanelExpanded}" Value="True">
                                                        <Setter Property="Data" Value="{x:Static yu:IvIcons.ChevronUp}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </yu:Icon.Style>
                                    </yu:Icon>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Empty state (no double border) -->
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,10,0,4"
                            HorizontalAlignment="Center"
                            Text="暂无样本">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource MutedTextStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Samples.IsSamplePanelExpanded}" Value="True" />
                                                <Condition Binding="{Binding Samples.HasNoSamples}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Thumbnail strip -->
                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Samples.IsSamplePanelExpanded}" Value="True" />
                                                <Condition Binding="{Binding Samples.HasSamples}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl
                                HorizontalAlignment="Left"
                                ItemTemplate="{StaticResource SampleTileTemplate}"
                                ItemsSource="{Binding Samples.SamplePageItems}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
</UserControl>
