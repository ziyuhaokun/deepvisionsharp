<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.Sections.DashboardHeaderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yu="http://schemas.yu-ui/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <!-- 标题栏：固定在滚动区外 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource IvDisplayTextStyle}"
                        Text="项目面板" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            AutomationProperties.AutomationId="dv.dashboard.import-project"
                            Command="{Binding Transfer.ImportProjectCommand}"
                            IsEnabled="{Binding Transfer.IsNotTransferring}">
                            <StackPanel Orientation="Horizontal">
                                <yu:Icon
                                    VerticalAlignment="Center"
                                    Data="{x:Static yu:IvIcons.ArrowUp}"
                                    ViewSize="{DynamicResource IvIconSize}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="导入" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="dv.dashboard.create-project"
                            Command="{Binding Editor.ShowCreateProjectDialogCommand}"
                            Style="{StaticResource IvPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <yu:Icon
                                    VerticalAlignment="Center"
                                    Data="{x:Static yu:IvIcons.Add}"
                                    ViewSize="{DynamicResource IvIconSize}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="新建项目" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
</UserControl>
