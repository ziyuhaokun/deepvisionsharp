<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:domain="clr-namespace:DeepVisionSharp.Domain.Entities;assembly=DeepVisionSharp.Domain"
    xmlns:training="clr-namespace:DeepVisionSharp.Shell.Views.Training">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TaskListEmptyHintStyle" TargetType="{x:Type StackPanel}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="TrainingDetailPanelStyle"
                BasedOn="{StaticResource {x:Type ui:Card}}"
                TargetType="{x:Type ui:Card}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <Style
                x:Key="TrainingTaskListPanelStyle"
                BasedOn="{StaticResource {x:Type ui:Card}}"
                TargetType="{x:Type ui:Card}">
                <Setter Property="Padding" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="StatusBadgeStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Style>

        <Style x:Key="TrainingJobListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            x:Name="RootBorder"
                            Padding="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Cursor="Hand">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainingJobListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainingTabStripButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="TabBackground"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabBackground" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TrainingJobItemTemplate">
            <Grid AutomationProperties.AutomationId="{Binding AutomationId}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="1">
                        <Border.Style>
                            <Style BasedOn="{StaticResource StatusBadgeStyle}" TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Draft">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobDraftBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobRunningBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobSucceededBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobFailedBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobCancelledBadgeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding StatusDisplay}" />
                    </Border>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding MetaText}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EmptyTrainingJobDetailTemplate">
            <Grid />
        </DataTemplate>

        <DataTemplate x:Key="TrainingJobDetailTemplate">
            <ui:Card
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource TrainingDetailPanelStyle}">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="0" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Text="{Binding Config.ModelName}" />
                                            <Border Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style BasedOn="{StaticResource StatusBadgeStyle}" TargetType="{x:Type Border}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Draft}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobDraftBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Preparing}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobPreparingBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Running}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobRunningBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Succeeded}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobSucceededBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Failed}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobFailedBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Cancelled}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobCancelledBadgeBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    AutomationProperties.AutomationId="dv.training.job-status"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding Config.SelectedJobStatusDisplay}" />
                                            </Border>
                                            <ui:SymbolIcon
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Symbol="LockClosed24"
                                                Visibility="{Binding Config.IsJobLocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Top"
                                            Appearance="Secondary"
                                            Command="{Binding JobList.DuplicateJobCommand}"
                                            Icon="{ui:SymbolIcon Copy24}"
                                            IsEnabled="{Binding Config.CanDuplicateJob}"
                                            ToolTip="复制为新草稿任务" />
                                        <ui:Button
                                            VerticalAlignment="Top"
                                            Appearance="Secondary"
                                            Command="{Binding ConfirmDeleteJobCommand}"
                                            Icon="{ui:SymbolIcon Delete24}"
                                            IsEnabled="{Binding Config.CanDeleteJob}"
                                            ToolTip="{Binding Config.DeleteJobToolTip}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="16,8,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding Monitor.IsSettingsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            AutomationProperties.AutomationId="dv.training.tab.basic"
                                            Command="{Binding Monitor.ShowBasicSectionCommand}"
                                            Content="基础信息">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsBasicSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            AutomationProperties.AutomationId="dv.training.tab.dataset"
                                            Command="{Binding Monitor.ShowDatasetSectionCommand}"
                                            Content="数据集">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsDatasetSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Command="{Binding Monitor.ShowHyperparametersSectionCommand}"
                                            Content="超参数"
                                            Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsHyperparametersSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Command="{Binding Monitor.ShowAdvancedSectionCommand}"
                                            Content="高级参数"
                                            Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsAdvancedSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding Monitor.IsRunMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding Monitor.ShowOverviewSectionCommand}" Content="概览" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsOverviewSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowConfigPreviewSectionCommand}" Content="配置" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsConfigPreviewSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowPreviewSectionCommand}" Content="预览" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsPreviewSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowMetricsSectionCommand}" Content="指标" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsMetricsSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowLogsSectionCommand}" Content="日志" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsLogsSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowResourcesSectionCommand}" Content="资源">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsResourcesSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ui:ProgressRing
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,8,0"
                                        IsIndeterminate="True"
                                        Visibility="{Binding Monitor.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="训练中…"
                                        Visibility="{Binding Monitor.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <training:TrainingSettingsPanel Grid.Row="2" VerticalAlignment="Stretch" />

                            <training:TrainingRunPanel Grid.Row="2" VerticalAlignment="Stretch" />
                            <Border
                                Grid.Row="3"
                                Padding="16"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0"
                                            AutomationProperties.AutomationId="dv.training.block-reason"
                                            FontSize="12"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Text="{Binding Config.StartTrainingBlockReason}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Config.HasStartTrainingBlockReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                            <ui:Button
                                                Margin="0,0,8,0"
                                                Appearance="Primary"
                                                AutomationProperties.AutomationId="dv.training.start"
                                                Command="{Binding Config.StartTrainingCommand}"
                                                Icon="{ui:SymbolIcon Play24}"
                                                ToolTip="{Binding Config.StartTrainingToolTip}"
                                                Visibility="{Binding Monitor.IsSettingsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                开始训练
                                            </ui:Button>
                                            <ui:Button
                                                Margin="0,0,8,0"
                                                Appearance="Primary"
                                                AutomationProperties.AutomationId="dv.training.resume"
                                                Command="{Binding Config.ResumeTrainingCommand}"
                                                Icon="{ui:SymbolIcon ArrowClockwise24}"
                                                ToolTip="{Binding Config.ResumeTrainingToolTip}"
                                                Visibility="{Binding Config.CanResumeTraining, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                继续训练
                                            </ui:Button>
                                            <ui:Button
                                                Margin="0,0,8,0"
                                                Appearance="Secondary"
                                                AutomationProperties.AutomationId="dv.training.stop"
                                                Command="{Binding Config.StopTrainingCommand}"
                                                Icon="{ui:SymbolIcon Stop24}"
                                                ToolTip="{Binding Config.StopTrainingToolTip}">
                                                停止
                                            </ui:Button>
                                            <ui:Button
                                                Appearance="Secondary"
                                                AutomationProperties.AutomationId="dv.training.save-as-model"
                                                Command="{Binding Config.SaveAsModelCommand}"
                                                Icon="{ui:SymbolIcon Save24}"
                                                ToolTip="{Binding Config.SaveAsModelToolTip}">
                                                保存所选到模型库
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
            </ui:Card>
        </DataTemplate>
</ResourceDictionary>
