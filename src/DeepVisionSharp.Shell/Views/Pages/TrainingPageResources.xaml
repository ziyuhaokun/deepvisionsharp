<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    xmlns:domain="clr-namespace:DeepVisionSharp.Domain.Entities;assembly=DeepVisionSharp.Domain"
    xmlns:training="clr-namespace:DeepVisionSharp.Shell.Views.Training">

    <!-- 本字典里的 BasedOn="{StaticResource IvCardStyle}" 是静态引用，必须在同一字典作用域内可解析，
         所以这里自己也 merge 一次主题（各视图根部另有同样的 merge，WPF 允许重复合并）。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Training/TrainingDetailSharedResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TaskListEmptyHintStyle" TargetType="{x:Type StackPanel}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="TrainingDetailPanelStyle"
                BasedOn="{StaticResource IvCardStyle}"
                TargetType="{x:Type ContentControl}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <Style
                x:Key="TrainingTaskListPanelStyle"
                BasedOn="{StaticResource IvCardStyle}"
                TargetType="{x:Type ContentControl}">
                <Setter Property="Padding" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="StatusBadgeStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusControl}" />
                <Setter Property="Background" Value="{DynamicResource IvSurface3Brush}" />
            </Style>

        <Style x:Key="TrainingJobListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            x:Name="RootBorder"
                            Padding="12"
                            Background="{DynamicResource IvSurface2Brush}"
                            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource IvRadiusControl}"
                            Cursor="Hand">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource IvAccentBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainingJobListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainingTabStripButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="TabBackground"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource IvRadiusControl}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabBackground" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TrainingJobItemTemplate">
            <Grid AutomationProperties.AutomationId="{Binding AutomationId}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IvText1Brush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="1">
                        <Border.Style>
                            <Style BasedOn="{StaticResource StatusBadgeStyle}" TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Draft">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobDraftBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobRunningBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobSucceededBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobFailedBadgeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter Property="Background" Value="{StaticResource TrainingJobCancelledBadgeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="{DynamicResource IvFontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource IvTextOnAccentBrush}"
                            Text="{Binding StatusDisplay}" />
                    </Border>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    FontSize="{DynamicResource IvFontSizeSmall}"
                    Foreground="{DynamicResource IvText2Brush}"
                    Text="{Binding MetaText}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EmptyTrainingJobDetailTemplate">
            <Grid />
        </DataTemplate>

        <DataTemplate x:Key="TrainingJobDetailTemplate">
            <ContentControl
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource TrainingDetailPanelStyle}">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="0" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="16"
                                Background="{DynamicResource IvSurface3Brush}"
                                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="{DynamicResource IvFontSizeTitle}"
                                                FontWeight="SemiBold"
                                                Text="{Binding Config.ModelName}" />
                                            <Border Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style BasedOn="{StaticResource StatusBadgeStyle}" TargetType="{x:Type Border}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Draft}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobDraftBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Preparing}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobPreparingBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Running}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobRunningBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Succeeded}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobSucceededBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Failed}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobFailedBadgeBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding JobList.SelectedJob.Status}" Value="{x:Static domain:TrainingJobStatus.Cancelled}">
                                                                <Setter Property="Background" Value="{StaticResource TrainingJobCancelledBadgeBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    AutomationProperties.AutomationId="dv.training.job-status"
                                                    FontSize="{DynamicResource IvFontSizeSmall}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource IvTextOnAccentBrush}"
                                                    Text="{Binding Config.SelectedJobStatusDisplay}" />
                                            </Border>
                                            <!-- 源 WPF-UI SymbolIcon LockClosed24 在 IvIcons 里没有 lock 几何（源用 DvIcon.LockClosed），降级为 Bookmark -->
                                            <dvsui:Icon
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static dvsui:IvIcons.Bookmark}"
                                                Foreground="{DynamicResource IvText2Brush}"
                                                ViewSize="14"
                                                Visibility="{Binding Config.IsJobLocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding JobList.DuplicateJobCommand}"
                                            IsEnabled="{Binding Config.CanDuplicateJob}"
                                            ToolTip="复制为新草稿任务">
                                            <dvsui:Icon Data="{x:Static dvsui:IvIcons.Copy}" ViewSize="{DynamicResource IvIconSize}" />
                                        </Button>
                                        <Button
                                            VerticalAlignment="Top"
                                            Command="{Binding ConfirmDeleteJobCommand}"
                                            IsEnabled="{Binding Config.CanDeleteJob}"
                                            ToolTip="{Binding Config.DeleteJobToolTip}">
                                            <dvsui:Icon Data="{x:Static dvsui:IvIcons.Delete}" ViewSize="{DynamicResource IvIconSize}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="16,8,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource IvSurface3Brush}"
                                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource IvRadiusControl}"
                                    Visibility="{Binding Monitor.IsSettingsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            AutomationProperties.AutomationId="dv.training.tab.basic"
                                            Command="{Binding Monitor.ShowBasicSectionCommand}"
                                            Content="基础信息">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsBasicSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            AutomationProperties.AutomationId="dv.training.tab.dataset"
                                            Command="{Binding Monitor.ShowDatasetSectionCommand}"
                                            Content="数据集">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsDatasetSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Command="{Binding Monitor.ShowHyperparametersSectionCommand}"
                                            Content="超参数"
                                            Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsHyperparametersSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Command="{Binding Monitor.ShowAdvancedSectionCommand}"
                                            Content="高级参数"
                                            Visibility="{Binding Config.UsesNetworkInputSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsAdvancedSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource IvSurface3Brush}"
                                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource IvRadiusControl}"
                                    Visibility="{Binding Monitor.IsRunMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding Monitor.ShowOverviewSectionCommand}" Content="概览" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsOverviewSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowConfigPreviewSectionCommand}" Content="配置" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsConfigPreviewSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowPreviewSectionCommand}" Content="预览" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsPreviewSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowMetricsSectionCommand}" Content="指标" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsMetricsSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowLogsSectionCommand}" Content="日志" IsEnabled="{Binding Monitor.AreResultTabsEnabled}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsLogsSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding Monitor.ShowResourcesSectionCommand}" Content="资源">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource TrainingTabStripButtonStyle}" TargetType="{x:Type Button}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Monitor.IsResourcesSectionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!-- 源 WPF-UI ProgressRing（20×20 环）→ 不确定态 ProgressBar（条形） -->
                                    <ProgressBar
                                        Width="56"
                                        Height="4"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        IsIndeterminate="True"
                                        Visibility="{Binding Monitor.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource IvText2Brush}"
                                        Text="训练中…"
                                        Visibility="{Binding Monitor.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <training:TrainingSettingsPanel Grid.Row="2" VerticalAlignment="Stretch" />

                            <training:TrainingRunPanel Grid.Row="2" VerticalAlignment="Stretch" />
                            <Border
                                Grid.Row="3"
                                Padding="16"
                                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0"
                                            AutomationProperties.AutomationId="dv.training.block-reason"
                                            FontSize="{DynamicResource IvFontSizeCaption}"
                                            Foreground="{DynamicResource IvWarningTextBrush}"
                                            Text="{Binding Config.StartTrainingBlockReason}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Config.HasStartTrainingBlockReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,8,0"
                                                AutomationProperties.AutomationId="dv.training.start"
                                                Command="{Binding Config.StartTrainingCommand}"
                                                Style="{StaticResource IvPrimaryButtonStyle}"
                                                ToolTip="{Binding Config.StartTrainingToolTip}"
                                                Visibility="{Binding Monitor.IsSettingsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.Play}" ViewSize="{DynamicResource IvIconSize}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="开始训练" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Margin="0,0,8,0"
                                                AutomationProperties.AutomationId="dv.training.resume"
                                                Command="{Binding Config.ResumeTrainingCommand}"
                                                Style="{StaticResource IvPrimaryButtonStyle}"
                                                ToolTip="{Binding Config.ResumeTrainingToolTip}"
                                                Visibility="{Binding Config.CanResumeTraining, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.Refresh}" ViewSize="{DynamicResource IvIconSize}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="继续训练" />
                                                </StackPanel>
                                            </Button>
                                            <!-- 源 WPF-UI SymbolIcon Stop24 在 IvIcons 里没有等价几何，降级为 Close -->
                                            <Button
                                                Margin="0,0,8,0"
                                                AutomationProperties.AutomationId="dv.training.stop"
                                                Command="{Binding Config.StopTrainingCommand}"
                                                ToolTip="{Binding Config.StopTrainingToolTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.Close}" ViewSize="{DynamicResource IvIconSize}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="停止" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.AutomationId="dv.training.save-as-model"
                                                Command="{Binding Config.SaveAsModelCommand}"
                                                ToolTip="{Binding Config.SaveAsModelToolTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <dvsui:Icon Data="{x:Static dvsui:IvIcons.Save}" ViewSize="{DynamicResource IvIconSize}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="保存所选到模型库" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
            </ContentControl>
        </DataTemplate>
</ResourceDictionary>
