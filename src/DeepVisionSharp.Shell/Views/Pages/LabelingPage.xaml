<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/LabelingPage.axaml | 转换: WPF-UI → DeepVisionSharp.UI；页面级 merge DeepVisionSharpUITheme.xaml 提供隐式样式，文字基线在根 Grid 上用 TextElement.* 附加属性声明一次 -->
<Page
    x:Class="DeepVisionSharp.Shell.Views.Pages.LabelingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    Title="标注"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- 文字基线（页面级声明一次，靠属性继承下发到各分区）：Page 不是 Control，没有 FontSize/Foreground，改用 TextElement 附加属性 -->
    <Grid
        TextElement.FontFamily="{DynamicResource IvFontFamily}"
        TextElement.FontSize="{DynamicResource IvFontSizeBody}"
        TextElement.Foreground="{DynamicResource IvText1Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <sections:LabelingToolRailSection Grid.Column="0" />
        <sections:LabelingWorkbenchSection Grid.Column="1" />
        <sections:LabelingSideRailSection Grid.Column="2" />
    </Grid>
</Page>
