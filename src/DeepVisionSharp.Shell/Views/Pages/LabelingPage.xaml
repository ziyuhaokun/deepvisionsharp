<Page
    x:Class="DeepVisionSharp.Shell.Views.Pages.LabelingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    Title="标注"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <sections:LabelingToolRailSection Grid.Column="0" />
        <sections:LabelingWorkbenchSection Grid.Column="1" />
        <sections:LabelingSideRailSection Grid.Column="2" />
    </Grid>
</Page>
