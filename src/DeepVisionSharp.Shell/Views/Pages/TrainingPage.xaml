<Page
    x:Class="DeepVisionSharp.Shell.Views.Pages.TrainingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:training="clr-namespace:DeepVisionSharp.Shell.Views.Training"
    xmlns:domain="clr-namespace:DeepVisionSharp.Domain.Entities;assembly=DeepVisionSharp.Domain"
    xmlns:vo="clr-namespace:DeepVisionSharp.Domain.ValueObjects;assembly=DeepVisionSharp.Domain"
    Title="训练"
    d:DesignHeight="1000"
    d:DesignWidth="1680"
    Loaded="OnLoaded"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/TrainingPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <DockPanel
        x:Name="PageRootDock"
        Margin="28"
        LastChildFill="True"
        VerticalAlignment="Stretch">

        <Grid x:Name="PageHeaderGrid" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="训练" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            AutomationProperties.AutomationId="dv.training.create-job"
                            Command="{Binding JobList.CreateJobCommand}"
                            Icon="{ui:SymbolIcon Add24}"
                            IsEnabled="{Binding JobList.IsTrainingWorkflow}">
                            新建任务
                        </ui:Button>
                        <ui:Button
                            Appearance="Secondary"
                            AutomationProperties.AutomationId="dv.training.refresh"
                            Command="{Binding JobList.LoadCommand}"
                            Icon="{ui:SymbolIcon ArrowClockwise24}">
                            刷新
                        </ui:Button>
                    </StackPanel>
        </Grid>

        <Grid
            x:Name="MainWorkspaceGrid"
            Margin="0,12,0,0"
            MinHeight="240"
            ClipToBounds="True"
            VerticalAlignment="Stretch">
            <Border
                Padding="36"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding JobList.ShowProjectRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Play24" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="未选择项目" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="请先在项目面板选择一个项目，再创建训练任务。" />
                </StackPanel>
            </Border>

            <Grid VerticalAlignment="Stretch" Visibility="{Binding JobList.IsTrainingWorkflow, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="0" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="260" MaxWidth="480" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                    <ui:Card
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource TrainingTaskListPanelStyle}"
                        Visibility="{Binding JobList.IsTrainingWorkflow, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel LastChildFill="True" VerticalAlignment="Stretch">
                            <TextBlock
                                DockPanel.Dock="Top"
                                Margin="0,0,0,12"
                                FontWeight="SemiBold"
                                Text="训练任务" />

                            <Grid VerticalAlignment="Stretch">
                                <ListBox
                                    AutomationProperties.AutomationId="dv.training.jobs"
                                    ItemContainerStyle="{StaticResource TrainingJobListItemStyle}"
                                    ItemTemplate="{StaticResource TrainingJobItemTemplate}"
                                    ItemsSource="{Binding JobList.Jobs}"
                                    SelectedItem="{Binding JobList.SelectedJob}"
                                    Style="{StaticResource TrainingJobListBoxStyle}" />

                                <StackPanel
                                    Margin="16,0"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource TaskListEmptyHintStyle}"
                                    Visibility="{Binding JobList.HasEmptyJobList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:SymbolIcon
                                        HorizontalAlignment="Center"
                                        FontSize="28"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="ClipboardTaskListLtr24" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="暂无任务"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="点击“新建任务”创建第一个训练实验"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </ui:Card>

                    <GridSplitter
                        Grid.Column="1"
                        Width="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        ShowsPreview="True" />


                    <ui:Card
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource TrainingDetailPanelStyle}"
                        Visibility="{Binding JobList.ShowSelectJobPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Symbol="HandRight24" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="请选择任务" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="在左侧选择一个任务，或新建训练任务。" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Shown while form is applied with detail panel still collapsed (avoids NumberBox layout crash). -->
                    <ui:Card
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource TrainingDetailPanelStyle}"
                        Visibility="{Binding JobList.ShowDetailPreparing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                                <ui:ProgressRing
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    IsIndeterminate="True" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="正在加载任务配置…" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Detail panel created only when form is ready (no live NumberBox tree during ApplyForm). -->
                    <ContentControl
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="ContentTemplate" Value="{StaticResource EmptyTrainingJobDetailTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JobList.ShowJobDetail}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TrainingJobDetailTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
                </Grid>

                <Border
                    Panel.ZIndex="10"
                    Background="#66000000"
                    Visibility="{Binding JobList.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ProgressRing
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                </Border>
            </Grid>
    </DockPanel>
</Page>
