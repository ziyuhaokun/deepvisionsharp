<Page
    x:Class="DeepVisionSharp.Shell.Views.Pages.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="图库"
    d:DesignHeight="1000"
    d:DesignWidth="1680"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageRoot" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <!-- 行 0：固定页面标题与操作按钮栏 -->
            <RowDefinition Height="Auto" />
            <!-- 行 1：固定指标卡片与搜索框 -->
            <RowDefinition Height="Auto" />
            <!-- 行 2：自适应独立滚动卡片网格 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sections:GalleryHeaderSection Grid.Row="0" />
        <sections:GalleryMetricsSection Grid.Row="1" />
        <sections:GalleryCardWallSection Grid.Row="2" />
        <sections:GalleryOverlaySection Grid.RowSpan="3" Panel.ZIndex="30" />
    </Grid>
</Page>
