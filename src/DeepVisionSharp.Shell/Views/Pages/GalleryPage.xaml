<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/GalleryPage.axaml | 转换: WPF-UI → DeepVisionSharp.UI；页面级 merge DeepVisionSharpUITheme.xaml 提供隐式样式，文字基线在 PageRoot 上用 TextElement.* 附加属性声明一次 -->
<Page
    x:Class="DeepVisionSharp.Shell.Views.Pages.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    Title="图库"
    d:DesignHeight="1000"
    d:DesignWidth="1680"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/GalleryPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- 文字基线（页面级声明一次，靠属性继承下发到各分区）：Page 不是 Control，没有 FontSize/Foreground，改用 TextElement 附加属性 -->
    <Grid
        x:Name="PageRoot"
        Background="{DynamicResource IvBackgroundBrush}"
        SizeChanged="OnPageSizeChanged"
        TextElement.FontFamily="{DynamicResource IvFontFamily}"
        TextElement.FontSize="{DynamicResource IvFontSizeBody}"
        TextElement.Foreground="{DynamicResource IvText1Brush}">
        <Grid.RowDefinitions>
            <!-- 行 0：固定页面标题与操作按钮栏 -->
            <RowDefinition Height="Auto" />
            <!-- 行 1：固定指标卡片与搜索框 -->
            <RowDefinition Height="Auto" />
            <!-- 行 2：自适应独立滚动卡片网格 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sections:GalleryHeaderSection Grid.Row="0" />
        <sections:GalleryMetricsSection Grid.Row="1" />
        <sections:GalleryCardWallSection Grid.Row="2" />
        <sections:GalleryOverlaySection Grid.RowSpan="3" Panel.ZIndex="30" />
    </Grid>
</Page>
