<!-- 源: Vision.DeepVision.Shell.Avalonia/Views/Pages/GalleryPage.axaml（页面级样式） | 转换: WPF-UI Card→ContentControl+IvCardStyle；TextFillColor*/ControlFillColor*/ControlStrokeColor*/SystemAccentColor* → Iv* 令牌；删除 implicit TextBlock 样式（基线改由 GalleryPage 的 PageRoot 继承） -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">

    <ResourceDictionary.MergedDictionaries>
        <!-- 下面的卡片样式 BasedOn IvCardStyle：WPF 的 StaticResource 不跨同级 merge 的字典，故本字典自带容器样式 -->
        <ResourceDictionary Source="pack://application:,,,/yu-ui;component/Styles/Container.xaml" />
    </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:RoundedClipConverter x:Key="RoundedClipConverter" />

        <!-- 指标卡：IvCardStyle + 更紧的内边距与固定最小高度 -->
        <Style
            x:Key="MetricCardStyle"
            BasedOn="{StaticResource IvCardStyle}"
            TargetType="ContentControl">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- 图库卡：IvCardStyle + 6px 圆角外观（源 Border.galleryCard 硬编码圆角，令牌表无 6/8 对应值，照抄常量）
             + 悬停描边渐显（源 :pointerover 的 BorderBrush 切换，这里用叠加描边层做 150ms 过渡） -->
        <Style
            x:Key="GalleryCardStyle"
            BasedOn="{StaticResource IvCardStyle}"
            TargetType="ContentControl">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="280" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <Grid>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <Border
                                    x:Name="HoverHighlight"
                                    IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource IvAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverHighlight"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverHighlight"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource IvSurface3Brush}" />
        </Style>

        <Style x:Key="GalleryCardTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        </Style>

        <Style x:Key="GalleryCardDescriptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource IvText3Brush}" />
        </Style>

        <Style x:Key="GalleryCardMetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>

        <Style x:Key="GalleryCardBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>
</ResourceDictionary>
