<Page
    x:Class="DeepVisionSharp.Shell.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    xmlns:services="clr-namespace:DeepVisionSharp.Shell.Services"
    xmlns:vm="clr-namespace:DeepVisionSharp.Shell.ViewModels"
    Title="设置"
    d:DesignHeight="1000"
    d:DesignWidth="1680"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/SettingsPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.InputBindings>
        <KeyBinding Key="F12" Command="{Binding ShowDebugAccessCommand}" />
    </Page.InputBindings>

    <!--
      左分类 + 右内容。NavigationView 对 Page 常按无限高测量，用 MaxHeight 约束根布局。
    -->
    <Grid
        AutomationProperties.AutomationId="dv.settings.root"
        x:Name="PageRoot"
        Margin="24"
        MinHeight="0"
        VerticalAlignment="Stretch"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
        </StackPanel>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类 -->
            <ListBox
                Grid.Column="0"
                ItemContainerStyle="{StaticResource CategoryItemContainerStyle}"
                ItemsSource="{Binding Categories}"
                SelectedValue="{Binding SelectedCategory, Mode=TwoWay}"
                SelectedValuePath="Id"
                Style="{StaticResource CategoryListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsCategoryItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="32"
                                Height="32"
                                Style="{StaticResource IconTileStyle}">
                                <ui:SymbolIcon
                                    x:Name="CategoryIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Style="{StaticResource ThemedSymbolIcon}"
                                    Symbol="Code24" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Title}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static vm:SettingsCategory.Appearance}">
                                <Setter TargetName="CategoryIcon" Property="Symbol" Value="PaintBrush24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static vm:SettingsCategory.Storage}">
                                <Setter TargetName="CategoryIcon" Property="Symbol" Value="Folder24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static vm:SettingsCategory.About}">
                                <Setter TargetName="CategoryIcon" Property="Symbol" Value="Info24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static vm:SettingsCategory.Advanced}">
                                <Setter TargetName="CategoryIcon" Property="Symbol" Value="Wrench24" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 右侧内容 -->
            <ScrollViewer
                Grid.Column="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="840" HorizontalAlignment="Left">
                    <!-- 外观与通知 -->
                    <!-- 外观与通知 -->
                    <sections:SettingsAppearanceSection />

                    <!-- 存储 -->
                    <sections:SettingsStorageSection />

                    <!-- 关于 -->
                    <sections:SettingsAboutSection />

                    <!-- DEBUG · 数据维护 -->
                    <sections:SettingsDebugSection />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
