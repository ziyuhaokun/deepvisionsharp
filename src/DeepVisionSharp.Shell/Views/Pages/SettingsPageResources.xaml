<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters">

        <!--
          yu-ui 主题（令牌 + 样式）在本字典自持一份：字典里的 BasedOn / 刷子引用都要在本字典作用域内可解析。
          页面与各 Section 的根元素另各 merge 一次，作用域仍然是各自页面，不影响未迁移的页面。
        -->
        <ResourceDictionary.MergedDictionaries>
        </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!--
          文字基线（FontFamily / FontSize / Foreground）由各视图根元素声明后靠继承传递。
          这里刻意不写 implicit TextBlock 样式：它会压掉控件级字号与主按钮白字（docs/yu-ui-migration.md §1）。
        -->
        <Style x:Key="ThemedTextBlockBase" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style
            x:Key="PageTitleStyle"
            BasedOn="{StaticResource ThemedTextBlockBase}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeDisplay}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style
            x:Key="SectionTitleStyle"
            BasedOn="{StaticResource ThemedTextBlockBase}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 卡片壳：yu-ui 的 IvCardStyle 自带 IvCardPadding 内边距，页面只补间距与前景色 -->
        <Style
            x:Key="SettingsCardStyle"
            BasedOn="{StaticResource IvCardStyle}"
            TargetType="{x:Type ContentControl}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IvText1Brush}" />
        </Style>

        <Style x:Key="IconTileStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
            <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IvText1Brush}" />
        </Style>

        <Style
            x:Key="RowTitleStyle"
            BasedOn="{StaticResource ThemedTextBlockBase}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style
            x:Key="RowSubtitleStyle"
            BasedOn="{StaticResource ThemedTextBlockBase}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>

        <Style
            x:Key="PathCaptionStyle"
            BasedOn="{StaticResource ThemedTextBlockBase}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeSmall}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource IvText3Brush}" />
        </Style>

        <Style
            x:Key="MetricSizeStyle"
            BasedOn="{StaticResource ThemedTextBlockBase}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style
            x:Key="SecondaryLabelStyle"
            BasedOn="{StaticResource ThemedTextBlockBase}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>

        <Style x:Key="CategoryListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="CategoryItemContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            x:Name="Root"
                            Padding="10,8"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{DynamicResource IvRadiusOverlay}"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="AccentBar"
                                    Width="3"
                                    Margin="0,2,10,2"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource IvRadiusSmall}" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource IvAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeOptionButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource IvControlFillBrush}"
                            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource IvRadiusOverlay}"
                            SnapsToDevicePixels="True">
                            <TextBlock
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvAccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IvAccentBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource IvTextOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

</ResourceDictionary>
