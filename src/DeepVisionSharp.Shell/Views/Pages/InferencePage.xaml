<Page
    x:Class="DeepVisionSharp.Shell.Views.Pages.InferencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Controls"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="推理"
    d:DesignHeight="1000"
    d:DesignWidth="1680"
    Loaded="OnLoaded"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/InferencePageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!--
      PageRoot MaxHeight is set from code-behind (same pattern as TrainingPage) so NavigationView
      cannot measure this page at infinite height. List content then scrolls only inside ImageList.
    -->
    <Grid
        x:Name="PageRoot"
        Margin="8"
        ClipToBounds="True"
        MinHeight="0"
        MinWidth="0"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top toolbar: source + run actions -->
        <sections:InferenceToolbarSection Grid.Row="0" />

        <Grid
            Grid.Row="1"
            MinHeight="0"
            MinWidth="0"
            ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="0" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="320" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <sections:InferenceImageListSection
                x:Name="ImageListSection"
                Grid.Column="0" />
            <sections:InferenceCanvasSection Grid.Column="1" />
            <sections:InferenceToolsSection Grid.Column="2" />

            <Border
                Grid.ColumnSpan="3"
                Background="#66000000"
                Panel.ZIndex="20"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:ProgressRing
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
            </Border>
        </Grid>

        <!-- Bottom status bar: performance only (result semantics live on the canvas card). -->
        <sections:InferenceStatusSection Grid.Row="2" />
    </Grid>
</Page>
