<Page
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Pages.Sections"
    Title="项目"
    d:DesignHeight="1000"
    d:DesignWidth="1680"
    Background="{DynamicResource IvBackgroundBrush}"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Pages/DashboardPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- 源 <Grid Margin="32,28" RowDefinitions="Auto,Auto,*">：行 0 标题栏、行 1 筛选栏、行 2 自适应滚动内容区 -->
    <Grid
        x:Name="PageRoot"
        Margin="32,28"
        MinHeight="0"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <!-- 行 0：页面标题 + 工具条按钮 -->
            <RowDefinition Height="Auto" />
            <!-- 行 1：搜索框 + 类型筛选 -->
            <RowDefinition Height="Auto" />
            <!-- 行 2：独立滚动的内容区（空状态 / 卡片墙） -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sections:DashboardHeaderSection Grid.Row="0" />
        <sections:DashboardFilterSection Grid.Row="1" />
        <sections:DashboardProjectListSection Grid.Row="2" />
        <sections:DashboardOverlaySection Grid.RowSpan="3" Panel.ZIndex="90" />
    </Grid>
</Page>
