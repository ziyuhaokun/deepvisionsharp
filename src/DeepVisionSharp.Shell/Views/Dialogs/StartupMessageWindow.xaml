<Window
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.StartupMessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DeepVisionSharp"
    Width="420"
    MinWidth="360"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    KeyDown="OnKeyDown"
    MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Border
        Margin="16"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Direction="270"
                Opacity="0.45"
                ShadowDepth="8"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border
                Grid.Row="0"
                Padding="18,14"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="12,12,0,0">
                <DockPanel LastChildFill="True">
                    <Image
                        Width="24"
                        Height="24"
                        DockPanel.Dock="Left"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="/DeepVisionSharp;component/Resources/logo.png"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="DeepVisionSharp"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Body -->
            <StackPanel
                Grid.Row="1"
                Margin="28,28,28,8"
                HorizontalAlignment="Stretch">
                <Border
                    x:Name="IconContainer"
                    Width="64"
                    Height="64"
                    Margin="0,0,0,18"
                    HorizontalAlignment="Center"
                    CornerRadius="32">
                    <ui:SymbolIcon
                        x:Name="MessageIcon"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="30" />
                </Border>

                <TextBlock
                    x:Name="TitleText"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="MessageText"
                    MaxWidth="340"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    LineHeight="20"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Footer -->
            <Border
                Grid.Row="2"
                Padding="20,16,20,20">
                <ui:Button
                    x:Name="ConfirmButton"
                    MinHeight="40"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Click="OnConfirmClick"
                    Content="知道了"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Padding="0,10" />
            </Border>
        </Grid>
    </Border>
</Window>
