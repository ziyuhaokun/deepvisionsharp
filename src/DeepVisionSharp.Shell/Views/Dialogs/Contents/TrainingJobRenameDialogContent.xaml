<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.TrainingJobRenameDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="420">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock
            FontSize="13"
            FontWeight="SemiBold"
            Text="任务名称" />
        <ui:TextBox
            Margin="0,8,0,0"
            Icon="{ui:SymbolIcon TextT24}"
            PlaceholderText="输入训练任务名称"
            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Margin="0,12,0,0"
            Foreground="#EF4444"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
