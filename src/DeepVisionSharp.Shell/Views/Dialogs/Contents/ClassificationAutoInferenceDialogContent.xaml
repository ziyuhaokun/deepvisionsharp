<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.ClassificationAutoInferenceDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    MinWidth="480"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="DialogHintStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock
            Style="{StaticResource DialogHintStyle}"
            Text="{Binding InferenceDialogDescription}"
            TextWrapping="Wrap" />

        <TextBlock Margin="0,18,0,0" Style="{StaticResource DialogFieldLabelStyle}" Text="选择模型" />
        <ComboBox
            Margin="0,8,0,0"
            DisplayMemberPath="DisplayText"
            IsEnabled="{Binding HasInferenceModels}"
            ItemsSource="{Binding InferenceModels}"
            SelectedItem="{Binding SelectedInferenceModel, Mode=TwoWay}" />

        <Border
            Margin="0,10,0,0"
            Padding="12"
            Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
            CornerRadius="{DynamicResource IvRadiusControl}"
            Visibility="{Binding HasNoInferenceModels, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <dvsui:Icon
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Data="{x:Static dvsui:IvIcons.Warning}"
                    Foreground="{DynamicResource IvText2Brush}"
                    ViewSize="16" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogHintStyle}"
                    Text="{Binding InferenceNoModelsHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel>
            <TextBlock Margin="0,20,0,0" Style="{StaticResource DialogFieldLabelStyle}" Text="推理设备" />
            <ComboBox
                Margin="0,8,0,0"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding InferenceDeviceOptions}"
                SelectedItem="{Binding SelectedInferenceDevice, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Margin="0,20,0,0" Style="{StaticResource DialogFieldLabelStyle}" Text="置信度阈值（top-1）" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Slider
                IsSnapToTickEnabled="True"
                Maximum="0.95"
                Minimum="0.1"
                TickFrequency="0.05"
                Value="{Binding InferenceConfidence, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                Text="{Binding InferenceConfidence, StringFormat={}{0:F2}}" />
        </Grid>
        <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource DialogHintStyle}"
            Text="{Binding ConfidenceThresholdHint}" />

        <Border
            Margin="0,16,0,0"
            Padding="12"
            Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
            CornerRadius="{DynamicResource IvRadiusControl}">
            <StackPanel>
                <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="{Binding InferencePolicySectionTitle}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource DialogHintStyle}"
                    Text="{Binding InferenceSpatialPolicySummary}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,12,0,0"
            Style="{StaticResource DialogHintStyle}"
            Text="{Binding InferenceParametersFooterHint}"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource DialogHintStyle}"
            Text="TorchSharp 分类模型固定单图推理，无批次与最大结果数参数。" />

        <Border
            Margin="0,12,0,0"
            Padding="12"
            Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
            CornerRadius="{DynamicResource IvRadiusControl}"
            Visibility="{Binding ShowInferenceConfigWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <dvsui:Icon
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Data="{x:Static dvsui:IvIcons.Warning}"
                    Foreground="{DynamicResource IvText2Brush}"
                    ViewSize="16" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogHintStyle}"
                    Text="请选择模型并检查参数范围"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,12,0,0"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding InferenceDialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasInferenceDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
