<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.InferenceImageSourceDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yu="http://schemas.yu-ui/xaml"
    MinWidth="480"
    MaxWidth="560"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            </Style>
            <Style x:Key="DialogHintStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock
            FontWeight="SemiBold"
            Text="外部图片" />
        <!-- 源 WPF-UI Button.Icon 无等价物：按钮内容改 Grid[yu:Icon + TextBlock]，图标字色随按钮前景继承 -->
        <Button
            Margin="0,10,0,0"
            Style="{StaticResource IvPrimaryButtonStyle}"
            AutomationProperties.AutomationId="dv.dialog.inference-import-external"
            Command="{Binding ImportExternalImagesCommand}"
            HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <yu:Icon
                    VerticalAlignment="Center"
                    Data="{x:Static yu:IvIcons.FolderOpen}"
                    ViewSize="16" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="导入图片…" />
            </StackPanel>
        </Button>
        <Button
            Margin="0,8,0,0"
            Style="{StaticResource IvSubtleButtonStyle}"
            Command="{Binding ClearExternalImagesCommand}"
            Content="仅清空外部图片"
            HorizontalAlignment="Stretch" />

        <TextBlock
            Margin="0,18,0,0"
            FontWeight="SemiBold"
            Text="图库样本（可多次追加）" />
        <ComboBox
            Margin="0,6,0,0"
            AutomationProperties.AutomationId="dv.dialog.inference-gallery"
            DisplayMemberPath="DisplayText"
            ItemsSource="{Binding Galleries}"
            SelectedItem="{Binding SelectedGallery, Mode=TwoWay}" />
        <Button
            Margin="0,10,0,0"
            Style="{StaticResource IvPrimaryButtonStyle}"
            AutomationProperties.AutomationId="dv.dialog.inference-load-gallery"
            Command="{Binding LoadGallerySamplesCommand}"
            HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <yu:Icon
                    VerticalAlignment="Center"
                    Data="{x:Static yu:IvIcons.Images}"
                    ViewSize="16" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="追加到列表" />
            </StackPanel>
        </Button>
        <Button
            Margin="0,8,0,0"
            Style="{StaticResource IvSubtleButtonStyle}"
            Command="{Binding ClearGalleryImagesCommand}"
            Content="仅清空图库样本"
            HorizontalAlignment="Stretch" />

        <Button
            Margin="0,16,0,0"
            Command="{Binding ClearAllImagesCommand}"
            Content="清空全部列表"
            HorizontalAlignment="Stretch" />

        <Border
            Margin="0,18,0,0"
            Padding="12,10"
            Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
            CornerRadius="{DynamicResource IvRadiusControl}">
            <StackPanel>
                <TextBlock
                    FontSize="{DynamicResource IvFontSizeCaption}"
                    Foreground="{DynamicResource IvText2Brush}"
                    Text="当前列表" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontWeight="SemiBold"
                    Text="{Binding ImageSourceSummary}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
