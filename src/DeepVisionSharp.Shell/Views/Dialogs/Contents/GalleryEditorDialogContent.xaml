<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.GalleryEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yu="http://schemas.yu-ui/xaml"
    MinWidth="460"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="图库名称" />
        <!-- 源 WPF-UI TextBox 的 Icon 无等价物：左侧叠 16px yu:Icon，输入框左侧内边距让出图标位（8 + 16 + 4） -->
        <Grid Margin="0,8,0,16">
            <TextBox
                Padding="28,0,8,0"
                AutomationProperties.AutomationId="dv.dialog.gallery-name"
                IsReadOnly="{Binding IsEditingSystemGallery}"
                yu:IvPlaceholder.Text="输入图库名称"
                Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <yu:Icon
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Data="{x:Static yu:IvIcons.Images}"
                Foreground="{DynamicResource IvText3Brush}"
                IsHitTestVisible="False"
                ViewSize="16" />
        </Grid>

        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="图库描述" />
        <TextBox
            Margin="0,8,0,0"
            MinHeight="72"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="dv.dialog.gallery-description"
            yu:IvPlaceholder.Text="简要描述图库用途（可选）"
            Text="{Binding DraftDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,0"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
