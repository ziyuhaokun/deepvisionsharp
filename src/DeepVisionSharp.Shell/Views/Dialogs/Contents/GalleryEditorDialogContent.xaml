<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.GalleryEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="460">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="图库名称" />
        <ui:TextBox
            Margin="0,8,0,16"
            AutomationProperties.AutomationId="dv.dialog.gallery-name"
            Icon="{ui:SymbolIcon Album24}"
            IsReadOnly="{Binding IsEditingSystemGallery}"
            PlaceholderText="输入图库名称"
            Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="图库描述" />
        <ui:TextBox
            Margin="0,8,0,0"
            MinHeight="72"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="dv.dialog.gallery-description"
            PlaceholderText="简要描述图库用途（可选）"
            Text="{Binding DraftDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,0"
            Foreground="#EF4444"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
