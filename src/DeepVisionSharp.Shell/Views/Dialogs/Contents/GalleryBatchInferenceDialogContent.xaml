<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.GalleryBatchInferenceDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yu="http://schemas.yu-ui/xaml"
    MinWidth="540"
    MaxWidth="640"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="DialogHintStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            </Style>
            <Style x:Key="StatValueStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeTitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeSmall}" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Style="{StaticResource DialogHintStyle}"
                Text="{Binding Subtitle}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,14,0,0"
                Padding="12"
                Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                CornerRadius="{DynamicResource IvRadiusControl}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding GalleryName}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource DialogHintStyle}"
                            Text="{Binding GalleryMetaText}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource IvSurface3Brush}"
                        CornerRadius="999">
                        <TextBlock FontSize="{DynamicResource IvFontSizeSmall}" FontWeight="SemiBold" Text="{Binding ProjectTypeLabel}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Config -->
            <StackPanel Visibility="{Binding IsConfigView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,18,0,0" Style="{StaticResource DialogFieldLabelStyle}" Text="选择模型" />
                <ComboBox
                    Margin="0,8,0,0"
                    DisplayMemberPath="DisplayText"
                    IsEnabled="{Binding IsConfigInteractive}"
                    ItemsSource="{Binding Models}"
                    SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource DialogHintStyle}"
                    Text="{Binding SelectedModel.SpatialPolicySummary, FallbackValue='', TargetNullValue=''}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ShowsSelectedModelSpatialSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border
                    Margin="0,8,0,0"
                    Padding="10"
                    Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                    CornerRadius="{DynamicResource IvRadiusControl}"
                    Visibility="{Binding HasNoModels, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource DialogHintStyle}" Text="{Binding NoModelsHint}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,16,0,0" Style="{StaticResource DialogFieldLabelStyle}" Text="样本范围" />
                <ComboBox
                    Margin="0,8,0,0"
                    DisplayMemberPath="Label"
                    IsEnabled="{Binding IsConfigInteractive}"
                    ItemsSource="{Binding ScopeOptions}"
                    SelectedItem="{Binding SelectedScopeOption, Mode=TwoWay}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource DialogHintStyle}" Text="{Binding ScopeHint}" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="推理设备" />
                        <ComboBox
                            Margin="0,8,0,0"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{Binding IsConfigInteractive}"
                            ItemsSource="{Binding DeviceOptions}"
                            SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="置信度阈值" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Text="{Binding Confidence, StringFormat={}{0:F2}}" />
                        </Grid>
                        <Slider
                            Margin="0,8,0,0"
                            IsEnabled="{Binding IsConfigInteractive}"
                            IsSnapToTickEnabled="True"
                            Maximum="0.95"
                            Minimum="0.1"
                            TickFrequency="0.05"
                            Value="{Binding Confidence, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <StackPanel
                    Margin="0,16,0,0"
                    Visibility="{Binding ShowsMaxDetections, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="最大结果数" />
                    <yu:NumericBox
                        Margin="0,8,0,0"
                        IsEnabled="{Binding IsConfigInteractive}"
                        Maximum="1000"
                        Minimum="1"
                        Step="10"
                        Value="{Binding MaxDetections, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource DialogHintStyle}"
                        Text="单张图片最多保留的结果条数。分类模型固定返回 top-1，此参数不生效。" />
                </StackPanel>

                <TextBlock Margin="0,16,0,0" Style="{StaticResource DialogFieldLabelStyle}" Text="写回策略" />
                <ComboBox
                    Margin="0,8,0,0"
                    DisplayMemberPath="Label"
                    IsEnabled="{Binding IsConfigInteractive}"
                    ItemsSource="{Binding WriteBackOptions}"
                    SelectedItem="{Binding SelectedWriteBackOption, Mode=TwoWay}" />
                <Border
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                    CornerRadius="{DynamicResource IvRadiusControl}">
                    <TextBlock Style="{StaticResource DialogHintStyle}" Text="{Binding WriteBackHint}" TextWrapping="Wrap" />
                </Border>

                <Button
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding StartCommand}"
                    Content="开始推理"
                    IsEnabled="{Binding CanStart}"
                    Style="{StaticResource IvPrimaryButtonStyle}" />
            </StackPanel>

            <!-- Running -->
            <StackPanel Visibility="{Binding IsRunningView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource DialogHintStyle}" Text="{Binding StageText}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Text="{Binding ProgressCountText}" />
                </Grid>
                <ProgressBar
                    Margin="0,8,0,0"
                    Height="8"
                    Maximum="1"
                    Value="{Binding ProgressValue}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="IsIndeterminate" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProgressValue}" Value="0">
                                    <Setter Property="IsIndeterminate" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock
                    Margin="0,8,0,0"
                    FontFamily="{DynamicResource IvMonoFontFamily}"
                    FontSize="{DynamicResource IvFontSizeCaption}"
                    Style="{StaticResource DialogHintStyle}"
                    Text="{Binding CurrentFileText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBox
                    Margin="0,12,0,0"
                    MinHeight="120"
                    MaxHeight="160"
                    AcceptsReturn="True"
                    FontFamily="{DynamicResource IvMonoFontFamily}"
                    FontSize="{DynamicResource IvFontSizeSmall}"
                    IsReadOnly="True"
                    Text="{Binding LogText}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <Button
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelRunCommand}"
                    Content="取消任务" />
            </StackPanel>

            <!-- Done -->
            <StackPanel Visibility="{Binding IsDoneView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource DialogHintStyle}" Text="{Binding StageText}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Text="{Binding ProgressCountText}" />
                </Grid>
                <ProgressBar
                    Margin="0,8,0,0"
                    Height="8"
                    Maximum="1"
                    Value="{Binding ProgressValue}" />
                <UniformGrid Margin="0,14,0,0" Columns="4">
                    <Border Margin="0,0,6,0" Padding="10" Background="{DynamicResource IvSurfaceSubtleHoverBrush}" CornerRadius="{DynamicResource IvRadiusControl}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding ResultTotal}" />
                            <TextBlock Style="{StaticResource StatLabelStyle}" Text="处理" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,0" Padding="10" Background="{DynamicResource IvSurfaceSubtleHoverBrush}" CornerRadius="{DynamicResource IvRadiusControl}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding ResultWritten}" />
                            <TextBlock Style="{StaticResource StatLabelStyle}" Text="写回" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,0" Padding="10" Background="{DynamicResource IvSurfaceSubtleHoverBrush}" CornerRadius="{DynamicResource IvRadiusControl}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding ResultSkipped}" />
                            <TextBlock Style="{StaticResource StatLabelStyle}" Text="跳过" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0,0,0" Padding="10" Background="{DynamicResource IvSurfaceSubtleHoverBrush}" CornerRadius="{DynamicResource IvRadiusControl}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding ResultFailed}" />
                            <TextBlock Style="{StaticResource StatLabelStyle}" Text="失败" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBox
                    Margin="0,12,0,0"
                    MinHeight="100"
                    MaxHeight="140"
                    AcceptsReturn="True"
                    FontFamily="{DynamicResource IvMonoFontFamily}"
                    FontSize="{DynamicResource IvFontSizeSmall}"
                    IsReadOnly="True"
                    Text="{Binding LogText}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

        <!-- Preparing overlay: dialog opens immediately while models/devices load. -->
        <Border
            Panel.ZIndex="20"
            Background="{DynamicResource IvOverlayBrush}"
            Visibility="{Binding IsPreparing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl
                Padding="28,22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="280"
                Style="{StaticResource IvCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar
                        Width="120"
                        Height="6"
                        HorizontalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource IvFontSizeSubtitle}"
                        FontWeight="SemiBold"
                        Text="正在准备图库推理…" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource DialogHintStyle}"
                        Text="{Binding PreparingStatusText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
