<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.InferenceDebugDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="640"
    MaxWidth="900"
    MaxHeight="640"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                FontSize="{DynamicResource IvFontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource IvText1Brush}"
                Text="{Binding InferenceDebugHeadline}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="{DynamicResource IvFontSizeCaption}"
                Foreground="{DynamicResource IvText2Brush}"
                Text="只读调试：不会修改当前样本标注。可对照「引擎返回数」与「可匹配项目标签数」定位类别写回失败的原因。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="0"
            Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusControl}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                MaxHeight="460">
                <TextBox
                    Margin="10"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{DynamicResource IvMonoFontFamily}"
                    FontSize="{DynamicResource IvFontSizeCaption}"
                    Foreground="{DynamicResource IvText1Brush}"
                    IsReadOnly="True"
                    Text="{Binding InferenceDebugReport, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>

        <TextBlock
            Grid.Row="2"
            Margin="0,10,0,0"
            FontSize="{DynamicResource IvFontSizeCaption}"
            Foreground="{DynamicResource IvText2Brush}"
            Text="主按钮「复制报告」会把全文写入剪贴板；关闭不应用任何标注变更。"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
