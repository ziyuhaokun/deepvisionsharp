<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.InferenceDebugDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="640"
    MaxWidth="900"
    MaxHeight="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding InferenceDebugHeadline}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="只读调试：不会修改当前样本标注。可对照「引擎返回数」与「可匹配项目标签数」定位类别写回失败的原因。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="0"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                MaxHeight="460">
                <TextBox
                    Margin="10"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas, Cascadia Mono, Courier New"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    IsReadOnly="True"
                    Text="{Binding InferenceDebugReport, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>

        <TextBlock
            Grid.Row="2"
            Margin="0,10,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="主按钮「复制报告」会把全文写入剪贴板；关闭不应用任何标注变更。"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
