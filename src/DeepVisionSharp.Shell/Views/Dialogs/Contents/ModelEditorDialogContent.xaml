<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.ModelEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    MinWidth="480">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="DialogHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ClassChipStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="ClassChipTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 名称 -->
        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="名称" />
        <ui:TextBox
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="dv.dialog.model-name"
            PlaceholderText="模型名称"
            Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.Style>
                <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="{x:Type ui:TextBox}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingModel}" Value="True">
                            <Setter Property="Icon" Value="{ui:SymbolIcon Edit24}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditingModel}" Value="False">
                            <Setter Property="Icon" Value="{ui:SymbolIcon Add24}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBox.Style>
        </ui:TextBox>

        <!-- 编辑：状态 -->
        <StackPanel
            Margin="0,18,0,0"
            Visibility="{Binding IsEditingModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="状态" />
            <TextBlock
                Margin="0,8,0,0"
                FontWeight="SemiBold"
                Text="{Binding EditingModelStatus}" />
        </StackPanel>

        <!-- 类型只读（模型由训练产生，创建后不可改） -->
        <StackPanel
            Margin="0,18,0,0"
            Visibility="{Binding IsEditingModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="类型" />
            <TextBlock
                Margin="0,8,0,0"
                FontWeight="SemiBold"
                Text="{Binding DraftModelTypeDisplay}" />
        </StackPanel>

        <!-- 编辑：类别 chips（卡片仅显示数量） -->
        <StackPanel
            Margin="0,18,0,0"
            Visibility="{Binding IsEditingModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogFieldLabelStyle}"
                    Text="类别" />
                <Border
                    HorizontalAlignment="Right"
                    Padding="8,3"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding EditingClassesCountText}" />
                </Border>
            </Grid>

            <Border
                Margin="0,8,0,0"
                Padding="12,12,4,4"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="10"
                Visibility="{Binding HasEditingClasses, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding EditingClasses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ClassChipStyle}">
                                <TextBlock
                                    Style="{StaticResource ClassChipTextStyle}"
                                    Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource DialogHintStyle}"
                Text="暂无类别"
                Visibility="{Binding HasEditingClasses, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- 备注 -->
        <TextBlock
            Margin="0,18,0,0"
            Style="{StaticResource DialogFieldLabelStyle}"
            Text="备注" />
        <ui:TextBox
            Margin="0,8,0,0"
            MinHeight="64"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="dv.dialog.model-note"
            PlaceholderText="可选"
            Text="{Binding DraftNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,0"
            Foreground="#EF4444"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
