<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.ModelEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    xmlns:converters="clr-namespace:DeepVisionSharp.Shell.Converters"
    MinWidth="480"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            </Style>

            <Style x:Key="DialogHintStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ClassChipStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusControl}" />
            </Style>

            <Style x:Key="ClassChipTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- 名称 -->
        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="名称" />
        <!-- 源 WPF-UI TextBox 的 Icon 无等价物：左侧叠 16px dvsui:Icon（编辑/新建两种几何由原 DataTrigger 驱动），输入框左侧内边距让出图标位 -->
        <Grid Margin="0,8,0,0">
            <TextBox
                Padding="28,0,8,0"
                AutomationProperties.AutomationId="dv.dialog.model-name"
                dvsui:IvPlaceholder.Text="模型名称"
                Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <dvsui:Icon
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="{DynamicResource IvText3Brush}"
                IsHitTestVisible="False"
                ViewSize="16">
                <dvsui:Icon.Style>
                    <!-- 元素级 Style 不设 Template，BasedOn 取 DeepVisionSharp.UI 的默认样式（Controls/Icon.xaml，随 DeepVisionSharpUITheme 一起 merge） -->
                    <Style TargetType="{x:Type dvsui:Icon}" BasedOn="{StaticResource {x:Type dvsui:Icon}}">
                        <Setter Property="Data" Value="{x:Static dvsui:IvIcons.Add}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingModel}" Value="True">
                                <Setter Property="Data" Value="{x:Static dvsui:IvIcons.Edit}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dvsui:Icon.Style>
            </dvsui:Icon>
        </Grid>

        <!-- 编辑：状态 -->
        <StackPanel
            Margin="0,18,0,0"
            Visibility="{Binding IsEditingModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="状态" />
            <TextBlock
                Margin="0,8,0,0"
                FontWeight="SemiBold"
                Text="{Binding EditingModelStatus}" />
        </StackPanel>

        <!-- 类型只读（模型由训练产生，创建后不可改） -->
        <StackPanel
            Margin="0,18,0,0"
            Visibility="{Binding IsEditingModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="类型" />
            <TextBlock
                Margin="0,8,0,0"
                FontWeight="SemiBold"
                Text="{Binding DraftModelTypeDisplay}" />
        </StackPanel>

        <!-- 编辑：类别 chips（卡片仅显示数量） -->
        <StackPanel
            Margin="0,18,0,0"
            Visibility="{Binding IsEditingModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogFieldLabelStyle}"
                    Text="类别" />
                <Border
                    HorizontalAlignment="Right"
                    Padding="8,3"
                    Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                    CornerRadius="{DynamicResource IvRadiusControl}">
                    <TextBlock
                        FontSize="{DynamicResource IvFontSizeSmall}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IvText2Brush}"
                        Text="{Binding EditingClassesCountText}" />
                </Border>
            </Grid>

            <Border
                Margin="0,8,0,0"
                Padding="12,12,4,4"
                Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
                CornerRadius="{DynamicResource IvRadiusControl}"
                Visibility="{Binding HasEditingClasses, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding EditingClasses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ClassChipStyle}">
                                <TextBlock
                                    Style="{StaticResource ClassChipTextStyle}"
                                    Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource DialogHintStyle}"
                Text="暂无类别"
                Visibility="{Binding HasEditingClasses, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- 备注 -->
        <TextBlock
            Margin="0,18,0,0"
            Style="{StaticResource DialogFieldLabelStyle}"
            Text="备注" />
        <TextBox
            Margin="0,8,0,0"
            MinHeight="64"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="dv.dialog.model-note"
            dvsui:IvPlaceholder.Text="可选"
            Text="{Binding DraftNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,0"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
