<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.SettingsDebugAccessDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="380"
    FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock
            FontSize="13"
            FontWeight="SemiBold"
            Text="维护密码" />
        <ui:PasswordBox
            x:Name="PasswordInput"
            Margin="0,8,0,0"
            Icon="{ui:SymbolIcon LockClosed24}"
            Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="输入密码"
            RevealButtonEnabled="True" />
        <TextBlock
            Margin="0,10,0,0"
            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
            Text="{Binding ErrorMessage}"
            Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
