<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.GalleryTargetSelectionDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    MinWidth="480"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock
            Margin="0,0,0,12"
            Foreground="{DynamicResource IvText2Brush}"
            Text="{Binding SummaryText}"
            TextWrapping="Wrap" />

        <TextBlock
            FontWeight="SemiBold"
            Text="目标图库" />
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <RadioButton
                Margin="0,0,16,0"
                Command="{Binding SelectNewTargetCommand}"
                Content="新建图库"
                GroupName="GalleryTargetMode"
                IsChecked="{Binding UseNewGallery, Mode=OneWay}" />
            <RadioButton
                Command="{Binding SelectExistingTargetCommand}"
                Content="已有图库"
                GroupName="GalleryTargetMode"
                IsChecked="{Binding UseExistingGallery, Mode=OneWay}" />
        </StackPanel>

        <!-- 源 WPF-UI TextBox 的 Icon 无等价物：左侧叠 16px dvsui:Icon，输入框左侧内边距让出图标位（8 + 16 + 4） -->
        <Grid
            Margin="0,12,0,0"
            Visibility="{Binding UseNewGallery, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBox
                Padding="28,0,8,0"
                dvsui:IvPlaceholder.Text="新图库名称"
                Text="{Binding NewGalleryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <dvsui:Icon
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Data="{x:Static dvsui:IvIcons.Images}"
                Foreground="{DynamicResource IvText3Brush}"
                IsHitTestVisible="False"
                ViewSize="16" />
        </Grid>

        <ComboBox
            Margin="0,12,0,0"
            DisplayMemberPath="DisplayText"
            ItemsSource="{Binding AvailableTargets}"
            SelectedValue="{Binding SelectedTargetGalleryId}"
            SelectedValuePath="Id"
            Visibility="{Binding UseExistingGallery, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <CheckBox
            Margin="0,12,0,0"
            Content="合并后删除为空的源图库"
            IsChecked="{Binding DeleteEmptySources}"
            Visibility="{Binding ShowDeleteEmptySourcesOption, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,0"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
