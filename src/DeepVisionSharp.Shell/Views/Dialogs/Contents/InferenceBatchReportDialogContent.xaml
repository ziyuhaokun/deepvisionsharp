<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.InferenceBatchReportDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="920"
    MaxWidth="1040"
    MaxHeight="780"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="HintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ChartFrameStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="成功率" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding SuccessRateText}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding SuccessCount, StringFormat={}{0} 成功}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="总耗时" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding TotalWallText}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding TotalCount, StringFormat=共 {0} 张}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="成功均耗时" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding AverageSuccessText}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding MinMaxSuccessText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="失败" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding FailedCount}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Charts 2×2 -->
            <Grid
                x:Name="ChartHost"
                Grid.Row="1"
                Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartFrameStyle}" Margin="0,0,8,8">
                    <Image
                        x:Name="ConfusionChartImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChartFrameStyle}" Margin="8,0,0,8">
                    <Image
                        x:Name="RateChartImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True" />
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartFrameStyle}" Margin="0,0,8,0">
                    <Image
                        x:Name="SuccessFailChartImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartFrameStyle}" Margin="8,0,0,0">
                    <Image
                        x:Name="LatencyChartImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True" />
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12,10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="分类评估" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding MissRateText, StringFormat=漏检率：{0}}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource HintStyle}"
                        Text="{Binding FalseAlarmRateText, StringFormat=误报率：{0}}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource HintStyle}"
                        Text="{Binding AccuracyText, StringFormat=准确率：{0}}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource HintStyle}"
                        Text="{Binding ConfusionText, StringFormat=OK/NG 混淆矩阵：{0}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="准确率统计全部类别；漏检、误报与混淆矩阵仅统计 OK/NG 子集，NG 为正类。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Original sample gallery -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock FontWeight="SemiBold" Text="原图样例" />
                <TextBlock
                    Margin="0,4,0,8"
                    Style="{StaticResource HintStyle}"
                    Text="OK / NG 命中 / 漏检 / 误报 原图（每类最多 4 张，需预计+推理标记）。副按钮可导出 HTML。"
                    TextWrapping="Wrap" />

                <TextBlock
                    Text="暂无可用原图样例（请为样本设置预计 OK/NG 后再推理）。"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOriginalSamples}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding OriginalSamples}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="148"
                                Margin="0,0,10,10"
                                Padding="0"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="ok">
                                                <Setter Property="BorderBrush" Value="#34C759" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="ng">
                                                <Setter Property="BorderBrush" Value="#FF3B30" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="miss">
                                                <Setter Property="BorderBrush" Value="#FF9F0A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="false_alarm">
                                                <Setter Property="BorderBrush" Value="#AF52DE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Border
                                        Height="110"
                                        Background="#111"
                                        CornerRadius="8,8,0,0"
                                        ClipToBounds="True">
                                        <Image
                                            Stretch="Uniform"
                                            Source="{Binding Thumbnail}"
                                            SnapsToDevicePixels="True" />
                                    </Border>
                                    <StackPanel Margin="8,6,8,8">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Verdict}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock
                Grid.Row="4"
                Margin="0,10,0,0"
                Style="{StaticResource HintStyle}"
                Text="主按钮「复制报告」写入剪贴板（不含图表/原图）；副按钮「导出 HTML」生成可归档报告；关闭不修改任何样本。"
                TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>
