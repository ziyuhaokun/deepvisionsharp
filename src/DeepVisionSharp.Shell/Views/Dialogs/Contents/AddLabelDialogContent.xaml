<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.AddLabelDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yu="http://schemas.yu-ui/xaml"
    MinWidth="420"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Visibility="{Binding IsLabelNameEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="类别名称" />
            <!-- 源 WPF-UI TextBox 的 Icon 无等价物：左侧叠 16px yu:Icon，输入框左侧内边距让出图标位（8 + 16 + 4） -->
            <Grid Margin="0,8,0,0">
                <TextBox
                    Padding="28,0,8,0"
                    AutomationProperties.AutomationId="dv.dialog.label-name"
                    yu:IvPlaceholder.Text="新类别名称"
                    Text="{Binding DraftLabelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <yu:Icon
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Data="{x:Static yu:IvIcons.Bookmark}"
                    Foreground="{DynamicResource IvText3Brush}"
                    IsHitTestVisible="False"
                    ViewSize="16" />
            </Grid>
        </StackPanel>

        <StackPanel Visibility="{Binding IsEditLabelColorMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="类别" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="{DynamicResource IvFontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource IvText1Brush}"
                Text="{Binding DraftLabelName}" />
        </StackPanel>

        <TextBlock
            Margin="0,16,0,0"
            Style="{StaticResource DialogFieldLabelStyle}"
            Text="类别颜色" />
        <ComboBox
            Margin="0,8,0,0"
            ItemsSource="{Binding PaletteColors}"
            SelectedItem="{Binding DraftLabelColor, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Background="{Binding}"
                            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource IvRadiusOverlay}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource IvFontSizeCaption}"
                            Foreground="{DynamicResource IvText1Brush}"
                            Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock
            Margin="0,12,0,0"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
