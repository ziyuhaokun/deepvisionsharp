<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.ProjectEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="460">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="项目名称" />
        <ui:TextBox
            Margin="0,8,0,6"
            AutomationProperties.AutomationId="dv.dialog.project-name"
            Icon="{ui:SymbolIcon Folder24}"
            PlaceholderText="输入项目名称"
            Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Margin="0,0,0,10"
            Foreground="#EF4444"
            Text="{Binding DraftNameFormatError}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDraftNameFormatError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="项目描述" />
        <ui:TextBox
            Margin="0,8,0,16"
            MinHeight="72"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="dv.dialog.project-description"
            PlaceholderText="简要描述项目用途（可选）"
            Text="{Binding DraftDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="项目类型" />
        <ComboBox
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="dv.dialog.project-type"
            DisplayMemberPath="Label"
            ItemsSource="{Binding SelectableProjectTypes}"
            IsEnabled="{Binding CanEditProjectType}"
            SelectedValue="{Binding DraftType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedValuePath="Value" />
        <TextBlock
            Margin="0,6,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding SelectedTypeDescription}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,0"
            Foreground="#EF4444"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
