<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.ProjectEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dvsui="http://schemas.deepvisionsharp.ui/xaml"
    MinWidth="460"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="项目名称" />
        <!-- 源 WPF-UI TextBox 的 Icon 无等价物：左侧叠 16px dvsui:Icon，输入框左侧内边距让出图标位（8 + 16 + 4） -->
        <Grid Margin="0,8,0,6">
            <TextBox
                Padding="28,0,8,0"
                AutomationProperties.AutomationId="dv.dialog.project-name"
                dvsui:IvPlaceholder.Text="输入项目名称"
                Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <dvsui:Icon
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Data="{x:Static dvsui:IvIcons.Folder}"
                Foreground="{DynamicResource IvText3Brush}"
                IsHitTestVisible="False"
                ViewSize="16" />
        </Grid>
        <TextBlock
            Margin="0,0,0,10"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding DraftNameFormatError}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDraftNameFormatError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="项目描述" />
        <TextBox
            Margin="0,8,0,16"
            MinHeight="72"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="dv.dialog.project-description"
            dvsui:IvPlaceholder.Text="简要描述项目用途（可选）"
            Text="{Binding DraftDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="项目类型" />
        <ComboBox
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="dv.dialog.project-type"
            DisplayMemberPath="Label"
            ItemsSource="{Binding SelectableProjectTypes}"
            IsEnabled="{Binding CanEditProjectType}"
            SelectedValue="{Binding DraftType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedValuePath="Value" />
        <TextBlock
            Margin="0,6,0,0"
            Foreground="{DynamicResource IvText2Brush}"
            Text="{Binding SelectedTypeDescription}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,0"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
