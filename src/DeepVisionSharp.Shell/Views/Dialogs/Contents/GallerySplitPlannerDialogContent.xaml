<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.GallerySplitPlannerDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="clr-namespace:DeepVisionSharp.Shell.Views.Dialogs.Contents.Sections"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="720"
    MinWidth="680"
    MaxHeight="560"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Dialogs/Contents/GallerySplitPlannerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sections:GallerySplitPlannerHeaderSection Grid.Row="0" />

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <sections:GallerySplitModeSection Grid.Column="0" />
            <sections:GallerySplitOptionsSection Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
