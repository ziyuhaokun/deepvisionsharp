<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.ConfirmDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="360"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/yu-ui;component/YuUiTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <TextBlock
        Text="{Binding Message}"
        TextWrapping="Wrap" />
</UserControl>
