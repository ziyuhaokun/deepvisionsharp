<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.GallerySamplePickerDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="520"
    MaxHeight="520"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
                <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            </Style>

            <Style x:Key="SamplePickerRowBorderStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusControl}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBrush}" />
                        <Setter Property="Background" Value="{DynamicResource IvAccentSubtleBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="{Binding GalleryName}" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource MutedTextStyle}"
                Text="{Binding SelectionSummary}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="10"
            Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusControl}">
            <Grid>
                <ScrollViewer
                    MaxHeight="300"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PageItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SamplePickerRowBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="{Binding FileName}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MutedTextStyle}"
                                            Text="{Binding AnnotatedText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="当前页暂无样本"
                    Visibility="{Binding HasNoPageItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding SelectAllOnPageCommand}"
                    Content="全选当前页"
                    FontSize="{DynamicResource IvFontSizeCaption}"
                    Padding="4,2"
                    Style="{StaticResource IvSubtleButtonStyle}" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding ClearPageSelectionCommand}"
                    Content="取消当前页"
                    FontSize="{DynamicResource IvFontSizeCaption}"
                    Padding="4,2"
                    Style="{StaticResource IvSubtleButtonStyle}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoToPreviousPageCommand}"
                    Content="上一页"
                    IsEnabled="{Binding CanGoToPreviousPage}" />
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{Binding PageText}" />
                <Button
                    Command="{Binding GoToNextPageCommand}"
                    Content="下一页"
                    IsEnabled="{Binding CanGoToNextPage}" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="{DynamicResource IvDangerBrush}"
            Text="{Binding DialogErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
