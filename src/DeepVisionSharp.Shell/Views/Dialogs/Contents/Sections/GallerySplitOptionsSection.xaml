<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.Sections.GallerySplitOptionsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Dialogs/Contents/GallerySplitPlannerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
            <ScrollViewer
                Grid.Column="2"
                MaxHeight="450"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding SelectedModeTitle}" />
                    <TextBlock
                        Margin="0,4,0,12"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding SelectedModeDescription}"
                        TextWrapping="Wrap" />

                    <Border
                        Style="{StaticResource OptionPanelStyle}"
                        Visibility="{Binding ShowRatioOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="移动比例" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:NumberBox
                                    MinWidth="200"
                                    Maximum="95"
                                    Minimum="5"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding MoveRatioPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="%" />
                            </Grid>
                            <Slider
                                Margin="0,10,0,0"
                                Maximum="95"
                                Minimum="5"
                                TickFrequency="5"
                                Value="{Binding MoveRatioPercent, Mode=TwoWay}" />

                            <TextBlock Margin="0,14,0,7" Style="{StaticResource DialogFieldLabelStyle}" Text="抽样方式" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Command="{Binding SelectRandomSamplingCommand}"
                                    Content="随机抽取"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    GroupName="SamplingMode"
                                    IsChecked="{Binding IsRandomSampling, Mode=OneWay}" />
                                <RadioButton
                                    Margin="18,0,0,0"
                                    Command="{Binding SelectFileOrderSamplingCommand}"
                                    Content="按文件名顺序"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    GroupName="SamplingMode"
                                    IsChecked="{Binding PreserveFileOrder, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Margin="0,12,0,0"
                                Visibility="{Binding IsRandomSampling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox
                                    Icon="{ui:SymbolIcon NumberSymbol24}"
                                    PlaceholderText="随机种子（可选）"
                                    Text="{Binding RandomSeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Style="{StaticResource ErrorTextStyle}"
                                    Text="随机种子必须是整数"
                                    Visibility="{Binding HasRandomSeedError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource OptionPanelStyle}"
                        Visibility="{Binding ShowCountOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="移动数量" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:NumberBox
                                    MinWidth="200"
                                    Maximum="{Binding MaxMoveCount}"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding MoveCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="张" />
                            </Grid>
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource MutedTextStyle}"
                                Text="{Binding MaxMoveCount, StringFormat=可输入 1～{0:N0} 张（源图库至少保留 1 张）}"
                                TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,7" Style="{StaticResource DialogFieldLabelStyle}" Text="抽样方式" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Command="{Binding SelectRandomSamplingCommand}"
                                    Content="随机抽取"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    GroupName="CountSamplingMode"
                                    IsChecked="{Binding IsRandomSampling, Mode=OneWay}" />
                                <RadioButton
                                    Margin="18,0,0,0"
                                    Command="{Binding SelectFileOrderSamplingCommand}"
                                    Content="按文件名顺序"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    GroupName="CountSamplingMode"
                                    IsChecked="{Binding PreserveFileOrder, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Margin="0,12,0,0"
                                Visibility="{Binding IsRandomSampling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox
                                    Icon="{ui:SymbolIcon NumberSymbol24}"
                                    PlaceholderText="随机种子（可选）"
                                    Text="{Binding RandomSeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Style="{StaticResource ErrorTextStyle}"
                                    Text="随机种子必须是整数"
                                    Visibility="{Binding HasRandomSeedError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource OptionPanelStyle}"
                        Visibility="{Binding ShowFileNamePrefixOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="文件名前缀" />
                            <ui:TextBox
                                Margin="0,8,0,0"
                                Icon="{ui:SymbolIcon DocumentText24}"
                                PlaceholderText="例如 batch_a_"
                                Text="{Binding FileNamePrefixText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource MutedTextStyle}"
                                Text="只移动文件名以该文本开头的样本。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource OptionPanelStyle}"
                        Visibility="{Binding ShowLabelOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="缺陷类别" />
                            <ComboBox
                                Margin="0,8,0,0"
                                ItemsSource="{Binding AvailableLabels}"
                                SelectedItem="{Binding SelectedLabel, Mode=TwoWay}"
                                Visibility="{Binding HasAvailableLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border
                                Margin="0,8,0,0"
                                Padding="10"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvailableLabels}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Text="当前图库暂无缺陷类别标注，请先完成标注或选择其他方式。"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource OptionPanelStyle}"
                        Visibility="{Binding ShowManualOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Symbol="CheckboxChecked24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MutedTextStyle}"
                                Text="下一步将打开样本选择器，可分页勾选需要移动的样本。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PreviewPanelStyle}">
                        <Grid>
                            <StackPanel Visibility="{Binding IsPreviewLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="正在计算预计结果…" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasPreviewMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Text="预计结果" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="移动" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding PreviewMoveSampleCount, StringFormat={}{0:N0} 张}" />
                                    </StackPanel>
                                    <ui:SymbolIcon
                                        Grid.Column="1"
                                        Margin="18,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Symbol="ArrowRight24" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="源图库保留" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding PreviewRemainingSampleCount, StringFormat={}{0:N0} 张}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,9,0,0"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="{Binding PreviewText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasPreviewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource ErrorTextStyle}"
                                    Text="无法生成有效结果" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Style="{StaticResource ErrorTextStyle}"
                                    Text="{Binding PreviewErrorMessage}" />
                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource MutedTextStyle}"
                                Text="{Binding PreviewText}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ShowManualOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource ErrorTextStyle}"
                        Text="{Binding DialogErrorMessage}"
                        Visibility="{Binding HasDialogErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
</UserControl>
