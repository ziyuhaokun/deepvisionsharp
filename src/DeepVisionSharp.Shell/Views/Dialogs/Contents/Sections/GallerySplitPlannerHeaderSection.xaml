<UserControl
    UseLayoutRounding="True"
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.Sections.GallerySplitPlannerHeaderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yu="http://schemas.yu-ui/xaml"
    FontFamily="{DynamicResource IvFontFamily}"
    FontSize="{DynamicResource IvFontSizeBody}"
    Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Dialogs/Contents/GallerySplitPlannerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Padding="14,12"
            Background="{DynamicResource IvSurfaceSubtleHoverBrush}"
            BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource IvRadiusControl}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="36"
                    Height="36"
                    Background="{DynamicResource IvAccentSubtleBrush}"
                    CornerRadius="{DynamicResource IvRadiusControl}">
                    <yu:Icon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{x:Static yu:IvIcons.Images}"
                        Foreground="{DynamicResource IvAccentBrush}"
                        ViewSize="20" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="{DynamicResource IvFontSizeBody}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IvText1Brush}"
                        Text="{Binding GalleryName}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding TotalSampleCount, StringFormat=源图库 · {0:N0} 张样本}" />
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Background="{DynamicResource IvControlFillBrush}"
                    CornerRadius="12">
                    <TextBlock
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding StepText}" />
                </Border>
            </Grid>
        </Border>
</UserControl>
