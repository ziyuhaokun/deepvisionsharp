<UserControl
    x:Class="DeepVisionSharp.Shell.Views.Dialogs.Contents.Sections.GallerySplitPlannerHeaderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeepVisionSharp;component/Views/Dialogs/Contents/GallerySplitPlannerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border
            Padding="14,12"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="36"
                    Height="36"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    CornerRadius="8">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Symbol="Album24" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding GalleryName}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding TotalSampleCount, StringFormat=源图库 · {0:N0} 张样本}" />
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="12">
                    <TextBlock
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding StepText}" />
                </Border>
            </Grid>
        </Border>
</UserControl>
