<UserControl
    x:Class="DeepVisionSharp.Shell.Controls.ImageLightboxOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Focusable="True"
    PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="#E6000000">
        <Canvas
            x:Name="Viewport"
            Background="Transparent"
            ClipToBounds="True"
            Cursor="SizeAll"
            MouseLeftButtonDown="OnViewportMouseLeftButtonDown"
            MouseLeftButtonUp="OnViewportMouseLeftButtonUp"
            MouseMove="OnViewportMouseMove"
            MouseWheel="OnViewportMouseWheel"
            SizeChanged="OnViewportSizeChanged">
            <Image
                x:Name="LightboxImage"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                Stretch="Fill">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <ui:Button
            Margin="0,16,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Appearance="Secondary"
            Click="OnCloseClick"
            Icon="{ui:SymbolIcon Dismiss24}"
            Padding="12,8"
            ToolTip="关闭 (Esc)" />

        <TextBlock
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            FontSize="12"
            Foreground="#CCFFFFFF"
            IsHitTestVisible="False"
            Text="滚轮缩放 · 拖动平移 · Esc 关闭" />
    </Grid>
</UserControl>
