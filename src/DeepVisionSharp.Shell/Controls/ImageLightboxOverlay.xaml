<UserControl
    x:Class="DeepVisionSharp.Shell.Controls.ImageLightboxOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yu="http://schemas.yu-ui/xaml"
    Focusable="True"
    PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/yu-ui;component/YuUiTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#E6000000">
        <Canvas
            x:Name="Viewport"
            Background="Transparent"
            ClipToBounds="True"
            Cursor="SizeAll"
            MouseLeftButtonDown="OnViewportMouseLeftButtonDown"
            MouseLeftButtonUp="OnViewportMouseLeftButtonUp"
            MouseMove="OnViewportMouseMove"
            MouseWheel="OnViewportMouseWheel"
            SizeChanged="OnViewportSizeChanged">
            <Image
                x:Name="LightboxImage"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                Stretch="Fill">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <Button
            Margin="0,16,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="OnCloseClick"
            Style="{StaticResource IvIconButtonStyle}"
            ToolTip="关闭 (Esc)">
            <yu:Icon Data="{x:Static yu:IvIcons.Close}" ViewSize="16" />
        </Button>

        <TextBlock
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            FontSize="12"
            Foreground="#CCFFFFFF"
            IsHitTestVisible="False"
            Text="滚轮缩放 · 拖动平移 · Esc 关闭" />
    </Grid>
</UserControl>
