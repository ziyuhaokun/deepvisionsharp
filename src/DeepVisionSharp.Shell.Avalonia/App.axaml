<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Tokens/Palette.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Tokens/Metrics.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Tokens/Typography.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Tokens/Motion.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Themes/Generic.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Themes/Forms.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/Common.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/Button.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/ButtonImplicit.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/TextInput.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/Selection.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/Switch.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/ProgressBar.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/Container.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/ScrollBar.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/Slider.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/List.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/ComboBox.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/TreeView.axaml" />
        <ResourceInclude Source="avares://DeepVisionSharp.UI.Avalonia/Styles/Menu.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DeepVisionSharp.UI.Avalonia/Themes/AppStyles.axaml" />
  </Application.Styles>

</Application>
