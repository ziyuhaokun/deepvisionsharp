<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:YuUI.Controls;assembly=yu-ui.avalonia"
             xmlns:ui="clr-namespace:YuUI;assembly=yu-ui.avalonia"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.Labeling.LabelingAiJudgeResultCard">

    <UserControl.Styles>
        <Style Selector="Border.toolSection">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        </Style>
        <Style Selector="Border.tone">
            <Setter Property="Background" Value="{DynamicResource IvText3Brush}" />
        </Style>
        <Style Selector="Border.tone.ok">
            <Setter Property="Background" Value="{DynamicResource IvSuccessBrush}" />
        </Style>
        <Style Selector="Border.tone.ng">
            <Setter Property="Background" Value="{DynamicResource IvDangerBrush}" />
        </Style>
        <Style Selector="Border.tone.warn">
            <Setter Property="Background" Value="{DynamicResource IvWarningBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding AiJudge.IsVisible}">
        <StackPanel Margin="12,10,12,12"
                    AutomationProperties.AutomationId="dv.labeling.ai-judge.result">
            <Border Classes="toolSection">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="AI 判定详情" />
                    <TextBlock Margin="0,7,0,0"
                               Classes="muted"
                               Text="点击左侧「判定当前图片」后，这里显示判定依据和最接近的标准图。"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !AiJudge.HasOutcome}" />

                    <StackPanel IsVisible="{Binding AiJudge.HasOutcome}">
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Border Padding="8,2"
                                    CornerRadius="4"
                                    Classes="tone"
                                    Classes.ok="{Binding AiJudge.ResultTone, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=ok}"
                                    Classes.ng="{Binding AiJudge.ResultTone, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=ng}"
                                    Classes.warn="{Binding AiJudge.ResultTone, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=warn}">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource IvTextOnAccentBrush}"
                                           Text="{Binding AiJudge.VerdictText}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Classes="muted"
                                       Text="{Binding AiJudge.ResultMetaText}" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0"
                                   Classes="body"
                                   Text="{Binding AiJudge.SummaryText}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding AiJudge.HasMessage}" />

                        <TextBlock Margin="0,10,0,0"
                                   Classes="body"
                                   FontWeight="SemiBold"
                                   Text="判定依据"
                                   IsVisible="{Binding AiJudge.HasEvidence}" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding AiJudge.Evidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" ColumnDefinitions="14,*">
                                        <TextBlock Classes="body" Text="•" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="body"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource IvWarningTextBrush}"
                                   Text="{Binding AiJudge.StaleReason}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding AiJudge.HasStaleReason}" />

                        <StackPanel Margin="0,10,0,0"
                                    IsVisible="{Binding AiJudge.HasClosestStandard}">
                            <TextBlock Classes="body"
                                       FontWeight="SemiBold"
                                       Text="最接近的标准" />
                            <Border Height="140"
                                    Margin="0,5,0,0"
                                    Background="{DynamicResource IvSurface2Brush}"
                                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="4">
                                <Grid>
                                    <Image RenderOptions.BitmapInterpolationMode="HighQuality"
                                           Source="{Binding AiJudge.ClosestStandardImage}"
                                           Stretch="Uniform" />
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding AiJudge.ClosestStandardImage, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                        <iv:Icon HorizontalAlignment="Center"
                                                 FontSize="22"
                                                 Foreground="{DynamicResource IvText3Brush}"
                                                 Data="{x:Static ui:IvIcons.Image}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource IvText3Brush}"
                                                   Text="标准图暂不可用" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       Classes="muted"
                                       Text="{Binding AiJudge.ClosestStandardText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Classes="muted"
                                   Text="{Binding AiJudge.ConfidenceText}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding AiJudge.HasConfidence}" />
                        <TextBlock Margin="0,4,0,0"
                                   Classes="muted"
                                   Text="{Binding AiJudge.UsageText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,0"
                       Classes="muted"
                       Text="AI 结论仅供参考：点「采纳判定」才会写入标注；判定失败或无法判定时保留原标注。"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>