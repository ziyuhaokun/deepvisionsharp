<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:DeepVisionSharp.UI.Avalonia.Controls;assembly=DeepVisionSharp.UI.Avalonia"
             xmlns:ui="clr-namespace:DeepVisionSharp.UI.Avalonia;assembly=DeepVisionSharp.UI.Avalonia"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.Labeling.LabelingEditActionsCard">

    <UserControl.Resources>
        <ControlTheme x:Key="EditToolButtonStyle" TargetType="Button"
                      BasedOn="{StaticResource IvSubtleButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
        </ControlTheme>
        <ControlTheme x:Key="WorkbenchButtonStyle" TargetType="Button"
                      BasedOn="{StaticResource IvButtonBaseStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.toolSection">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <Border Classes="toolSection">
        <StackPanel>
            <TextBlock Classes="sectionTitle" Text="编辑" />
            <WrapPanel Margin="0,6,0,0">
                <Panel Margin="0,0,4,0"
                       IsVisible="{Binding $parent[UserControl].ShowImport}">
                    <Button AutomationProperties.AutomationId="dv.labeling.import-images"
                            Command="{Binding Samples.ImportImagesCommand}"
                            IsEnabled="{Binding Samples.CanImportImages}"
                            Theme="{StaticResource EditToolButtonStyle}"
                            ToolTip.Tip="导入图像">
                        <iv:Icon VerticalAlignment="Center"
                                 FontSize="15"
                                 Data="{x:Static ui:IvIcons.ArrowUp}" />
                    </Button>
                </Panel>

                <Panel Margin="0,0,4,0"
                       IsVisible="{Binding $parent[UserControl].ShowMove}">
                    <Button Command="{Binding Samples.ShowMoveSamplesDialogCommand}"
                            IsEnabled="{Binding Samples.CanMoveSelectedSamples}"
                            Theme="{StaticResource EditToolButtonStyle}"
                            ToolTip.Tip="移动到其他图库（默认当前图；勾选后迁移勾选的样本）">
                        <iv:Icon VerticalAlignment="Center"
                                 FontSize="15"
                                 Data="{x:Static ui:IvIcons.Folder}" />
                    </Button>
                </Panel>

                <Panel Margin="0,0,4,0"
                       IsVisible="{Binding $parent[UserControl].ShowClear}">
                    <Button Command="{Binding Editor.ClearBoxesCommand}"
                            IsEnabled="{Binding Editor.HasBoxes}"
                            IsVisible="{Binding Workspace.UiPolicy.CanClearAllAnnotations}"
                            Theme="{StaticResource EditToolButtonStyle}"
                            ToolTip.Tip="清空当前样本标注">
                        <iv:Icon VerticalAlignment="Center"
                                 FontSize="15"
                                 Data="{x:Static ui:IvIcons.Delete}" />
                    </Button>
                </Panel>

                <Panel Margin="0,0,4,0"
                       IsVisible="{Binding $parent[UserControl].ShowAutoFit}">
                    <Button Click="OnAutoFitClick"
                            IsEnabled="{Binding Editor.IsNotBusy}"
                            IsVisible="{Binding Workspace.UiPolicy.CanUseAutoFit}"
                            Theme="{StaticResource EditToolButtonStyle}"
                            ToolTip.Tip="适应窗口：把这个样本缩放到正好铺满画布（100%）">
                        <iv:Icon VerticalAlignment="Center"
                                 FontSize="15"
                                 Data="{x:Static ui:IvIcons.Target}" />
                    </Button>
                </Panel>
            </WrapPanel>

            <Panel IsVisible="{Binding $parent[UserControl].ShowYoloInfer}">
                <Button Height="32"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding Inference.RunAutoInferenceCommand}"
                        IsEnabled="{Binding Inference.CanOpenInferenceDialog}"
                        IsVisible="{Binding Inference.IsVisible}"
                        Theme="{StaticResource WorkbenchButtonStyle}"
                        ToolTip.Tip="{Binding Inference.InferenceButtonToolTip}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <iv:Icon Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 FontSize="15"
                                 Data="{x:Static ui:IvIcons.Sparkles}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Text="{Binding Inference.InferenceActionLabel}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding Inference.ShowAutoInferenceDialogCommand}"
                                      Header="配置推理参数..." />
                            <MenuItem Command="{Binding Inference.RunInferenceDebugCommand}"
                                      Header="调试推理报告..." />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Panel>
        </StackPanel>
    </Border>
</UserControl>