<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:YuUI.Controls;assembly=yu-ui.avalonia"
             xmlns:ui="clr-namespace:YuUI;assembly=yu-ui.avalonia"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.Labeling.LabelingClassListCard">

    <UserControl.Resources>
        <ControlTheme x:Key="WorkbenchSubtleButtonStyle" TargetType="Button"
                      BasedOn="{StaticResource IvSubtleButtonStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="11" />
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>
        <Style Selector="Border.labelRow">
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.labelRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource IvStateHoverBrush}" />
        </Style>
        <Style Selector="Border.hotkeyBadge">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Styles>

    <StackPanel IsVisible="{Binding Workspace.ProjectProfile.SupportsClassLabels}">
        <Grid Margin="0,0,0,7" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Classes="sectionTitle"
                           Text="类别" />
                <Button Height="24"
                        MinHeight="0"
                        Margin="6,0,0,0"
                        Padding="7,0"
                        AutomationProperties.AutomationId="dv.labeling.label.add"
                        Command="{Binding Labels.ShowAddLabelDialogCommand}"
                        IsVisible="{Binding $parent[UserControl].ShowAddButton}"
                        Theme="{StaticResource WorkbenchSubtleButtonStyle}"
                        ToolTip.Tip="添加类别">
                    <StackPanel Orientation="Horizontal">
                        <iv:Icon VerticalAlignment="Center"
                                 FontSize="13"
                                 Data="{x:Static ui:IvIcons.Add}" />
                        <TextBlock Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="添加" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsVisible="{Binding Labels.ActiveLabelName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Background="{Binding Labels.ActiveLabelColor}"
                            CornerRadius="4" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="dv.labeling.label.active"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource IvText1Brush}"
                               Text="{Binding Labels.ActiveLabelName}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Margin="0,2,0,6"
                   Classes="muted"
                   Text="还没有类别，点「添加」创建第一个类别"
                   IsVisible="{Binding Labels.SelectedLabel, Converter={x:Static conv:ObjectConverters.IsNull}}" />

        <ScrollViewer MaxHeight="300"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl AutomationProperties.AutomationId="dv.labeling.labels"
                          ItemsSource="{Binding Labels.LabelOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="labelRow">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Button Width="24"
                                        Height="24"
                                        MinHeight="0"
                                        Padding="0"
                                        Command="{Binding $parent[UserControl].DataContext.Labels.ShowEditLabelColorDialogCommand}"
                                        CommandParameter="{Binding}"
                                        Theme="{StaticResource WorkbenchSubtleButtonStyle}"
                                        ToolTip.Tip="修改颜色">
                                    <Border Width="14"
                                            Height="14"
                                            Background="{Binding Color}"
                                            BorderBrush="{DynamicResource IvStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                </Button>
                                <TextBlock Grid.Column="1"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource IvText1Brush}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Classes="hotkeyBadge"
                                        IsVisible="{Binding HotkeyText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock MinWidth="12"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource IvText2Brush}"
                                               Text="{Binding HotkeyText}"
                                               TextAlignment="Center"
                                               ToolTip.Tip="{Binding HotkeyText, StringFormat=按 {0} 切换此类别}" />
                                </Border>
                                <Button Grid.Column="3"
                                        Width="24"
                                        Height="24"
                                        MinHeight="0"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        AutomationProperties.AutomationId="{Binding Name, StringFormat={}dv.labeling.label.select.{0}}"
                                        Command="{Binding $parent[UserControl].DataContext.Labels.SelectLabelCommand}"
                                        CommandParameter="{Binding}"
                                        Theme="{StaticResource IvIconButtonStyle}"
                                        ToolTip.Tip="选择类别；图像分类项目会立即写入当前整图分类">
                                    <iv:Icon VerticalAlignment="Center"
                                             FontSize="14"
                                             Data="{x:Static ui:IvIcons.Check}" />
                                </Button>
                                <Button Grid.Column="4"
                                        Width="24"
                                        Height="24"
                                        MinHeight="0"
                                        Margin="2,0,0,0"
                                        Padding="0"
                                        Command="{Binding $parent[UserControl].DataContext.Labels.DeleteLabelCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding $parent[UserControl].DataContext.Labels.CanManageLabels}"
                                        Theme="{StaticResource IvIconButtonStyle}"
                                        ToolTip.Tip="删除类别">
                                    <iv:Icon VerticalAlignment="Center"
                                             FontSize="14"
                                             Data="{x:Static ui:IvIcons.Delete}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>