<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:YuUI.Controls;assembly=yu-ui.avalonia"
             xmlns:ui="clr-namespace:YuUI;assembly=yu-ui.avalonia"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.Labeling.LabelingMaskReviewCard">

    <UserControl.Resources>
        <ControlTheme x:Key="WorkbenchButtonStyle" TargetType="Button"
                      BasedOn="{StaticResource IvButtonBaseStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.toolSection">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <Border Classes="toolSection"
            IsVisible="{Binding Workspace.ProjectProfile.SupportsMasks}">
        <StackPanel>
            <TextBlock Classes="sectionTitle" Text="分割标注" />
            <Button Height="34"
                    Margin="0,7,0,0"
                    Command="{Binding Editor.MarkReviewedBackgroundCommand}"
                    Theme="{StaticResource WorkbenchButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <iv:Icon Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             FontSize="15"
                             Data="{x:Static ui:IvIcons.Check}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{Binding $parent[Button].Foreground}"
                               Text="{Binding ReviewedBackgroundButtonText}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>