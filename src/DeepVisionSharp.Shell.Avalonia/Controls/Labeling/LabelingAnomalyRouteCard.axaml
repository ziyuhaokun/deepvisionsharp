<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:YuUI.Controls;assembly=yu-ui.avalonia"
             xmlns:ui="clr-namespace:YuUI;assembly=yu-ui.avalonia"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.Labeling.LabelingAnomalyRouteCard">

    <UserControl.Resources>
        <ControlTheme x:Key="WorkbenchButtonStyle" TargetType="Button"
                      BasedOn="{StaticResource IvButtonBaseStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.toolSection">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <Border Classes="toolSection"
            IsVisible="{Binding ShowAnomalySystemMoveTools}">
        <StackPanel>
            <TextBlock Classes="sectionTitle" Text="样本分流" />
            <WrapPanel Margin="0,7,0,0">
                <Button Margin="0,0,4,4"
                        AutomationProperties.AutomationId="dv.labeling.anomaly.move-train-good"
                        Command="{Binding Samples.MoveCurrentToTrainGoodCommand}"
                        IsEnabled="{Binding Samples.CanMoveCurrentToAnomalySystemGallery}"
                        Theme="{StaticResource WorkbenchButtonStyle}"
                        ToolTip.Tip="将当前图移到「训练」图库（TrainGood）">
                    <StackPanel Orientation="Horizontal">
                        <iv:Icon Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Data="{x:Static ui:IvIcons.Success}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{Binding $parent[Button].Foreground}"
                                   Text="训练OK" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,4,4"
                        AutomationProperties.AutomationId="dv.labeling.anomaly.move-test-good"
                        Command="{Binding Samples.MoveCurrentToTestGoodCommand}"
                        IsEnabled="{Binding Samples.CanMoveCurrentToAnomalySystemGallery}"
                        Theme="{StaticResource WorkbenchButtonStyle}"
                        ToolTip.Tip="将当前图移到「测试良品」图库（TestGood）">
                    <StackPanel Orientation="Horizontal">
                        <iv:Icon Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Data="{x:Static ui:IvIcons.Check}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{Binding $parent[Button].Foreground}"
                                   Text="测试OK" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,4,4"
                        AutomationProperties.AutomationId="dv.labeling.anomaly.move-test-defect"
                        Command="{Binding Samples.MoveCurrentToTestDefectCommand}"
                        IsEnabled="{Binding Samples.CanMoveCurrentToAnomalySystemGallery}"
                        Theme="{StaticResource IvDangerButtonStyle}"
                        ToolTip.Tip="将当前图移到「测试缺陷」图库（TestDefect）">
                    <StackPanel Orientation="Horizontal">
                        <iv:Icon Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Data="{x:Static ui:IvIcons.Error}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{Binding $parent[Button].Foreground}"
                                   Text="测试NG" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>