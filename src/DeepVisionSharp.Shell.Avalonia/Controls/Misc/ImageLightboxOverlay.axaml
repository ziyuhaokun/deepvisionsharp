<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:YuUI.Controls;assembly=yu-ui.avalonia"
             xmlns:ui="clr-namespace:YuUI;assembly=yu-ui.avalonia"
             xmlns:local="clr-namespace:DeepVisionSharp.Shell.Avalonia.Controls"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.ImageLightboxOverlay"
             Focusable="True">
    <Grid Background="#E6000000">
        <Canvas Name="Viewport"
                Background="Transparent"
                ClipToBounds="True"
                Cursor="SizeAll">
            <!-- 与 WPF 版一致：画布里的 Image 直接取本控件的 ImageSource（DataContext 是业务 VM，不能用裸 Binding）。 -->
            <Image Name="LightboxImage"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Source="{Binding $parent[local:ImageLightboxOverlay].ImageSource}"
                   Stretch="Fill" />
        </Canvas>

        <Button Width="36"
                Height="36"
                Margin="0,16,16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#66000000"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Foreground="White"
                Padding="0"
                Theme="{StaticResource IvIconButtonStyle}"
                ToolTip.Tip="关闭 (Esc)">
            <iv:Icon FontSize="16" Data="{x:Static ui:IvIcons.Close}" />
        </Button>

        <TextBlock Margin="0,0,0,20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   FontSize="12"
                   Foreground="#CCFFFFFF"
                   IsHitTestVisible="False"
                   Text="滚轮缩放 · 拖动平移 · Esc 关闭" />
    </Grid>
</UserControl>