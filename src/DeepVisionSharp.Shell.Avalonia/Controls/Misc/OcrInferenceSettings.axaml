<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.OcrInferenceSettings">
    <StackPanel IsVisible="{Binding ShowOcrParameters}">
        <TextBlock Margin="0,18,0,0" Theme="{StaticResource DialogFieldLabelStyle}" Text="识别方式" />
        <ComboBox Margin="0,8,0,0"
                  ItemsSource="{Binding OcrInferenceModeOptions}"
                  SelectedValue="{Binding SelectedOcrInferenceMode, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value}">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel IsVisible="{Binding ShowOcrDetectionParameters}">
            <TextBlock Margin="0,16,0,0" Theme="{StaticResource DialogFieldLabelStyle}" Text="文字检测模型" />
            <ComboBox Margin="0,8,0,0"
                      ItemsSource="{Binding OcrDetectorModels}"
                      SelectedItem="{Binding SelectedOcrDetectorModel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Margin="0,16,0,0" Theme="{StaticResource DialogFieldLabelStyle}" Text="文字检测设备" />
            <ComboBox Margin="0,8,0,0"
                      ItemsSource="{Binding OcrDetectorDeviceOptions}"
                      SelectedValue="{Binding OcrDetectorDevice, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Value}">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Margin="0,16,0,0" Theme="{StaticResource DialogFieldLabelStyle}" Text="文字检测阈值" />
            <Grid Margin="0,8,0,0" ColumnDefinitions="*,48">
                <Slider Minimum="0.1" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding OcrDetectionThreshold, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                           Text="{Binding OcrDetectionThreshold, StringFormat={}{0:F2}}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
