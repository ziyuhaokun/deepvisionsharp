<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Controls.ParamHelpButton"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <ToggleButton Name="HelpToggle"
                      Width="18" Height="18" MinWidth="18"
                      Padding="0" Margin="4,0,0,0"
                      VerticalAlignment="Center"
                      Cursor="Hand" Focusable="False"
                      Background="Transparent"
                      BorderBrush="{DynamicResource IvStrokeBrush}"
                      BorderThickness="1"
                      CornerRadius="9">
            <TextBlock FontSize="10" FontWeight="SemiBold" Text="?"
                       Foreground="{DynamicResource IvText2Brush}" />
        </ToggleButton>

        <Popup IsOpen="{Binding #HelpToggle.IsChecked, Mode=TwoWay}"
               PlacementTarget="{Binding #HelpToggle}"
               Placement="Bottom" HorizontalOffset="0" VerticalOffset="4">
            <Border Background="{DynamicResource IvPopupBrush}"
                    BorderBrush="{DynamicResource IvStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource IvRadiusControl}"
                    BoxShadow="{DynamicResource IvPopupShadow}"
                    Padding="12,10"
                    MaxWidth="280">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource IvText1Brush}" />
                    <TextBlock Text="{Binding HelpText, ElementName=Root}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource IvText2Brush}" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
