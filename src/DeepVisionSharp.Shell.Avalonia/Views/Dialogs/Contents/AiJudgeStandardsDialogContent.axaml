<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.AiJudgeStandardsDialogContent"
             MinWidth="660" MaxWidth="760"
             TextElement.Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp.Avalonia/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="StandardTileTemplate">
                <Border Width="150" Margin="0,0,8,8" Padding="6"
                        Background="{DynamicResource IvSurface3Brush}"
                        BorderBrush="{DynamicResource IvStrokeBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Border Height="96" Background="{DynamicResource IvControlFillBrush}"
                                ClipToBounds="True" CornerRadius="4">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource IvText3Brush}"
                                           Text="快照缺失" IsVisible="{Binding HasNoThumbnail}" />
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource IvText2Brush}"
                                   Text="{Binding SourceText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SourceText}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource IvText3Brush}"
                                   Text="{Binding DetailText}" />
                        <TextBox Margin="0,4,0,0" FontSize="12"
                                 Text="{Binding Note}"
                                 PlaceholderText="说明（可选）" />
                        <UniformGrid Margin="0,4,0,0" Columns="2">
                            <Button Margin="0,0,2,0" Padding="4,2" FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    Theme="{StaticResource IvSubtleButtonStyle}"
                                    Content="{Binding SwitchRoleText}"
                                    Command="{Binding $parent[UserControl].DataContext.SwitchRoleCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Margin="2,0,0,0" Padding="4,2" FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    Theme="{StaticResource IvDangerButtonStyle}"
                                    Content="移除"
                                    Command="{Binding $parent[UserControl].DataContext.RemoveCommand}"
                                    CommandParameter="{Binding}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Theme="{StaticResource DialogHintStyle}"
                   Text="标准集按项目保存，本项目所有图库共用。加入时保存的是图片副本，之后修改、移动或删除原样本都不影响标准；标准角色与样本自身的标注互不影响。每类最多 100 张；每次判定会发送全部标准图，张数越多越慢。" />

        <TextBlock Margin="0,14,0,0" Theme="{StaticResource DialogFieldLabelStyle}" Text="判定要点（可选）" />
        <TextBox MinHeight="52" Margin="0,6,0,0" AcceptsReturn="True"
                 Text="{Binding Guidance}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" Theme="{StaticResource DialogHintStyle}"
                   Text="随每次判定发给模型，例如「轻微色差不算缺陷；重点看边缘崩缺」。" />

        <ScrollViewer MaxHeight="500" Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="{Binding OkHeader}" />
                <TextBlock Margin="0,6,0,0" Theme="{StaticResource DialogHintStyle}"
                           Text="还没有 OK 标准：在标注页当前图片或缩略图右键「加入 OK 标准」。"
                           IsVisible="{Binding HasNoOkStandards}" />
                <ItemsControl Margin="0,6,0,0"
                              ItemTemplate="{StaticResource StandardTileTemplate}"
                              ItemsSource="{Binding OkStandards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Margin="0,10,0,0" Theme="{StaticResource DialogFieldLabelStyle}" Text="{Binding NgHeader}" />
                <TextBlock Margin="0,6,0,0" Theme="{StaticResource DialogHintStyle}"
                           Text="还没有 NG 标准：在标注页当前图片或缩略图右键「加入 NG 标准」。"
                           IsVisible="{Binding HasNoNgStandards}" />
                <ItemsControl Margin="0,6,0,0"
                              ItemTemplate="{StaticResource StandardTileTemplate}"
                              ItemsSource="{Binding NgStandards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Margin="0,10,0,0"
                   Foreground="{DynamicResource IvDangerTextBrush}"
                   Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding HasErrorMessage}" />
    </StackPanel>
</UserControl>
