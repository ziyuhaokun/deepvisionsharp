<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.GallerySamplePickerDialogContent"
             MinWidth="520"
             MaxHeight="520"
             Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="{Binding GalleryName}" />
            <TextBlock Margin="0,4,0,0" Theme="{StaticResource DialogHintStyle}" Text="{Binding SelectionSummary}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="10"
                Background="{DynamicResource IvSurface3Brush}"
                BorderBrush="{DynamicResource IvStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ScrollViewer MaxHeight="300"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PageItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="selectableRow" Classes.selected="{Binding IsSelected}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding FileName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Theme="{StaticResource DialogHintStyle}"
                                                   Text="{Binding AnnotatedText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Theme="{StaticResource DialogHintStyle}"
                           Text="当前页暂无样本"
                           IsVisible="{Binding HasNoPageItems}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SelectAllOnPageCommand}" Content="全选当前页" FontSize="12" Padding="4,2"
                        Theme="{StaticResource IvSubtleButtonStyle}" />
                <Button Margin="8,0,0,0" Command="{Binding ClearPageSelectionCommand}" Content="取消当前页" FontSize="12" Padding="4,2"
                        Theme="{StaticResource IvSubtleButtonStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding GoToPreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanGoToPreviousPage}"
                        Theme="{StaticResource IvSubtleButtonStyle}" />
                <TextBlock Margin="12,0" VerticalAlignment="Center"
                           Theme="{StaticResource DialogHintStyle}"
                           Text="{Binding PageText}" />
                <Button Command="{Binding GoToNextPageCommand}" Content="下一页" IsEnabled="{Binding CanGoToNextPage}"
                        Theme="{StaticResource IvSubtleButtonStyle}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0"
                   Foreground="{DynamicResource IvDangerTextBrush}"
                   Text="{Binding DialogErrorMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasDialogErrorMessage}" />
    </Grid>
</UserControl>
