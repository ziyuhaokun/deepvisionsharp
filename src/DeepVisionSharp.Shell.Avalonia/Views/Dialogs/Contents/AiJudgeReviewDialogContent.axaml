<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Avalonia.Controls"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.AiJudgeReviewDialogContent"
             Width="800"
             TextElement.Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Styles>
        <!-- 行容器只保留内容，去掉 ListBoxItem 的选中/悬停底色（对应 WPF 版 ItemContainerStyle 只剩 ContentPresenter） -->
        <Style Selector="ListBox.reviewList > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Border.classPill">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource IvPrimaryBrush}" />
        </Style>
        <Style Selector="Border.classPill.ok">
            <Setter Property="Background" Value="{DynamicResource IvSuccessBrush}" />
        </Style>
        <Style Selector="Border.classPill.ng">
            <Setter Property="Background" Value="{DynamicResource IvDangerBrush}" />
        </Style>
        <Style Selector="Border.classPill.warn">
            <Setter Property="Background" Value="{DynamicResource IvWarningBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp.Avalonia/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ReviewRowTemplate">
                <Border Margin="0,0,0,6"
                        Padding="8"
                        Background="{DynamicResource IvSurface3Brush}"
                        BorderBrush="{DynamicResource IvStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <CheckBox MinWidth="0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                        <Border Grid.Column="1" Width="88" Height="64" Margin="6,0,10,0"
                                Background="{DynamicResource IvControlFillBrush}"
                                ClipToBounds="True" CornerRadius="4">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource IvText1Brush}"
                                       Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FileName}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12"
                                       Foreground="{DynamicResource IvText1Brush}"
                                       Text="{Binding DetailText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding DetailText}" />
                            <TextBlock Margin="0,3,0,0" Theme="{StaticResource DialogHintStyle}"
                                       Text="{Binding MetaText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="10,0" VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Theme="{StaticResource DialogHintStyle}" Text="标注" />
                            <Border Margin="4,0,0,0" Classes="classPill">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource IvTextOnPrimaryBrush}"
                                           Text="{Binding CurrentText}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                       Theme="{StaticResource DialogHintStyle}" Text="AI" />
                            <Border Margin="4,0,0,0"
                                    Classes="classPill"
                                    Classes.ok="{Binding SuggestionTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ok}"
                                    Classes.ng="{Binding SuggestionTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ng}"
                                    Classes.warn="{Binding SuggestionTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=warn}">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource IvTextOnAccentBrush}"
                                           Text="{Binding SuggestionText}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Padding="10,4"
                                    Theme="{StaticResource IvPrimaryButtonStyle}"
                                    Content="采纳"
                                    ToolTip.Tip="把这张的标注改为 AI 结论"
                                    IsVisible="{Binding DiffersFromLabel}"
                                    Command="{Binding $parent[UserControl].DataContext.AdoptRowCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Margin="6,0,0,0" Padding="10,4"
                                    Theme="{StaticResource IvButtonBaseStyle}"
                                    Content="定位"
                                    ToolTip.Tip="关闭审阅并在标注页打开这张"
                                    Command="{Binding $parent[UserControl].DataContext.LocateCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Theme="{StaticResource DialogHintStyle}"
                   Text="{Binding GalleryName, StringFormat={}图库「{0}」的 AI 建议。采纳只修改所选样本的 OK/NG 标注；过期的建议（标准或模型已变）不会被采纳。}" />

        <Grid Margin="0,10,0,0" ColumnDefinitions="240,*,Auto,Auto">
            <ComboBox AutomationProperties.AutomationId="dv.labeling.ai-judge.review-filter"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Theme="{StaticResource DialogHintStyle}"
                       Text="{Binding CheckedCount, StringFormat={}已勾选 {0} 张}" />
            <Button Grid.Column="2" Padding="10,4" Content="勾选当前筛选"
                    Theme="{StaticResource IvSubtleButtonStyle}"
                    Command="{Binding CheckAllFilteredCommand}" />
            <Button Grid.Column="3" Margin="4,0,0,0" Padding="10,4" Content="清除勾选"
                    Theme="{StaticResource IvSubtleButtonStyle}"
                    Command="{Binding ClearChecksCommand}" />
        </Grid>

        <Grid Height="420" Margin="0,8,0,0">
            <ListBox Classes="reviewList"
                     AutomationProperties.AutomationId="dv.labeling.ai-judge.review-list"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemTemplate="{StaticResource ReviewRowTemplate}"
                     ItemsSource="{Binding Rows}" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Theme="{StaticResource DialogHintStyle}"
                       Text="当前筛选下没有样本。"
                       IsVisible="{Binding IsEmpty}" />
        </Grid>

        <Border Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource IvWarningSubtleBrush}"
                BorderBrush="{DynamicResource IvWarningBorderBrush}"
                BorderThickness="1" CornerRadius="6"
                IsVisible="{Binding HasPending}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Text="{Binding PendingText}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Margin="10,0,0,0"
                        AutomationProperties.AutomationId="dv.labeling.ai-judge.review-confirm"
                        Theme="{StaticResource IvPrimaryButtonStyle}"
                        Content="确认采纳"
                        Command="{Binding ConfirmAdoptCommand}" />
                <Button Grid.Column="2" Margin="6,0,0,0"
                        Theme="{StaticResource IvSubtleButtonStyle}"
                        Content="取消"
                        Command="{Binding CancelPendingCommand}" />
            </Grid>
        </Border>

        <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button AutomationProperties.AutomationId="dv.labeling.ai-judge.review-adopt-checked"
                    Theme="{StaticResource IvButtonBaseStyle}"
                    Content="采纳勾选"
                    Command="{Binding AdoptCheckedCommand}" />
            <Button Grid.Column="1" Margin="6,0,0,0"
                    AutomationProperties.AutomationId="dv.labeling.ai-judge.review-adopt-all"
                    Theme="{StaticResource IvPrimaryButtonStyle}"
                    Content="一键采纳当前筛选"
                    ToolTip.Tip="只采纳未过期、结论为 OK/NG 且与标注不一致的样本；执行前会先确认"
                    Command="{Binding AdoptFilteredCommand}" />
            <StackPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
                <controls:BusyRing Width="16" Height="16" IsVisible="{Binding IsBusy}" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding StatusText}" />
            </StackPanel>
            <Button Grid.Column="3"
                    AutomationProperties.AutomationId="dv.labeling.ai-judge.review-undo"
                    Theme="{StaticResource IvSubtleButtonStyle}"
                    Content="{Binding UndoText}"
                    ToolTip.Tip="按批次恢复上次采纳前的标注；采纳后又被修改过的样本不会被覆盖"
                    Command="{Binding UndoCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
