<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.AiJudgeBatchStartDialogContent"
             Width="520"
             TextElement.Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp.Avalonia/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Theme="{StaticResource DialogHintStyle}" Text="{Binding SummaryText}" />

        <TextBlock Margin="0,12,0,0"
                   Theme="{StaticResource DialogFieldLabelStyle}"
                   Text="判定范围" />
        <ComboBox Margin="0,6,0,0"
                  AutomationProperties.AutomationId="dv.labeling.ai-judge.batch-scope"
                  ItemsSource="{Binding ScopeOptions}"
                  SelectedItem="{Binding SelectedScope, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Margin="0,10,0,0" FontSize="13" Text="{Binding EstimateText}" TextWrapping="Wrap" />

        <Border Margin="0,12,0,0"
                Padding="10,8"
                Background="{DynamicResource IvWarningSubtleBrush}"
                BorderBrush="{DynamicResource IvWarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock FontSize="12" Text="{Binding StandardsText}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Margin="0,10,0,0" Theme="{StaticResource DialogHintStyle}" Text="{Binding NoteText}" />
    </StackPanel>
</UserControl>
