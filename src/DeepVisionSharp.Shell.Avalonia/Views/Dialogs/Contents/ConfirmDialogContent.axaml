<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.ConfirmDialogContent"
             MinWidth="360"
             MaxWidth="520"
             TextElement.Foreground="{DynamicResource IvText1Brush}">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
</UserControl>
