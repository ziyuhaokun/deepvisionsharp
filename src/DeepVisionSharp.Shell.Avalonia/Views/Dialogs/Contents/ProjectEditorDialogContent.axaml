<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.ProjectEditorDialogContent"
             MinWidth="460"
             MaxWidth="520"
             TextElement.Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="项目名称" />
        <TextBox Margin="0,8,0,6"
                 AutomationProperties.AutomationId="dv.dialog.project-name"
                 PlaceholderText="输入项目名称"
                 Text="{Binding DraftName, Mode=TwoWay}" />
        <TextBlock Margin="0,0,0,10"
                   Foreground="{DynamicResource IvDangerTextBrush}"
                   Text="{Binding DraftNameFormatError}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasDraftNameFormatError}" />

        <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="项目描述" />
        <TextBox Margin="0,8,0,16"
                 MinHeight="72"
                 AcceptsReturn="True"
                 AutomationProperties.AutomationId="dv.dialog.project-description"
                 PlaceholderText="简要描述项目用途（可选）"
                 Text="{Binding DraftDescription, Mode=TwoWay}" MaxLength="500"
                 TextWrapping="Wrap" />

        <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="项目类型" />
        <ComboBox Margin="0,8,0,0"
                  AutomationProperties.AutomationId="dv.dialog.project-type"
                  ItemsSource="{Binding SelectableProjectTypes}"
                  IsEnabled="{Binding CanEditProjectType}"
                  SelectedValue="{Binding DraftType, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Margin="0,6,0,0"
                   Foreground="{DynamicResource IvText2Brush}"
                   Text="{Binding SelectedTypeDescription}"
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,12,0,0"
                   Foreground="{DynamicResource IvDangerTextBrush}"
                   Text="{Binding DialogErrorMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasDialogErrorMessage}" />
    </StackPanel>
</UserControl>
