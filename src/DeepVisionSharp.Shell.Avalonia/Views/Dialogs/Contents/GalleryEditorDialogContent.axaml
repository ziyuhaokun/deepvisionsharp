<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.GalleryEditorDialogContent"
             MinWidth="460"
             MaxWidth="520"
             TextElement.Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp.Avalonia/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="图库名称" />
        <TextBox Margin="0,8,0,16"
                 AutomationProperties.AutomationId="dv.dialog.gallery-name"
                 IsReadOnly="{Binding IsEditingSystemGallery}"
                 PlaceholderText="输入图库名称"
                 Text="{Binding DraftName, Mode=TwoWay}" />

        <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="图库描述" />
        <TextBox Margin="0,8,0,0"
                 MinHeight="72"
                 AcceptsReturn="True"
                 AutomationProperties.AutomationId="dv.dialog.gallery-description"
                 PlaceholderText="简要描述图库用途（可选）"
                 Text="{Binding DraftDescription, Mode=TwoWay}"
                 TextWrapping="Wrap" />

        <TextBlock Margin="0,12,0,0"
                   Foreground="{DynamicResource IvDangerTextBrush}"
                   Text="{Binding DialogErrorMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasDialogErrorMessage}" />
    </StackPanel>
</UserControl>
