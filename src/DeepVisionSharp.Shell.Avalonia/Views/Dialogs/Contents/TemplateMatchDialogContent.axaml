<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:YuUI.Controls;assembly=yu-ui.avalonia"
             xmlns:ui="clr-namespace:YuUI;assembly=yu-ui.avalonia"
             xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Avalonia.Controls"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.TemplateMatchDialogContent"
             MinWidth="440"
             TextElement.Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp.Avalonia/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Margin="0,14,0,0" Padding="12"
                Background="{DynamicResource IvSurface3Brush}"
                CornerRadius="8"
                IsVisible="{Binding HasTemplate}">
            <Border Width="120" Height="120" HorizontalAlignment="Left"
                    Background="{DynamicResource IvSurface2Brush}"
                    BorderBrush="{DynamicResource IvStrokeBrush}"
                    BorderThickness="1" ClipToBounds="True" CornerRadius="6">
                <Image HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       Source="{Binding TemplatePreviewImage}" Stretch="Uniform" />
            </Border>
        </Border>

        <Border Margin="0,10,0,0" Padding="12"
                Background="{DynamicResource IvSurface3Brush}"
                CornerRadius="8"
                IsVisible="{Binding HasNoTemplate}">
            <StackPanel Orientation="Horizontal">
                <iv:Icon Margin="0,0,8,0" FontSize="16"
                         Foreground="{DynamicResource IvText2Brush}"
                         Data="{x:Static ui:IvIcons.Warning}" />
                <TextBlock VerticalAlignment="Center"
                           Theme="{StaticResource DialogHintStyle}"
                           Text="请先选中一个标注并点击「设为模板」" />
            </StackPanel>
        </Border>

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
            <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="匹配阈值" />
            <controls:ParamHelpButton
                Title="匹配阈值"
                HelpText="归一化互相关（NCC）匹配分数下限。值越大要求越相似；推荐 0.70–0.85。" />
        </StackPanel>
        <Grid Margin="0,8,0,0" ColumnDefinitions="*,48">
            <Slider IsSnapToTickEnabled="True" Maximum="0.95" Minimum="0.50" TickFrequency="0.01"
                    Value="{Binding TemplateMatchThreshold, Mode=TwoWay}" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding TemplateMatchThreshold, StringFormat={}{0:F2}}" />
        </Grid>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
            <TextBlock Theme="{StaticResource DialogFieldLabelStyle}" Text="NMS 重叠阈值" />
            <controls:ParamHelpButton
                Title="NMS 重叠阈值"
                HelpText="用于抑制高度重叠的匹配结果，分数较低者会被去掉。推荐范围 0.25–0.40。" />
        </StackPanel>
        <Grid Margin="0,8,0,0" ColumnDefinitions="*,48">
            <Slider IsSnapToTickEnabled="True" Maximum="0.90" Minimum="0.10" TickFrequency="0.05"
                    Value="{Binding TemplateMatchNms, Mode=TwoWay}" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding TemplateMatchNms, StringFormat={}{0:F2}}" />
        </Grid>

        <Border Margin="0,16,0,0" Padding="12"
                Background="{DynamicResource IvSurface3Brush}"
                CornerRadius="8"
                IsVisible="{Binding ShowTemplateMatchConfigWarning}">
            <StackPanel Orientation="Horizontal">
                <iv:Icon Margin="0,0,8,0" FontSize="16"
                         Foreground="{DynamicResource IvText2Brush}"
                         Data="{x:Static ui:IvIcons.Warning}" />
                <TextBlock VerticalAlignment="Center"
                           Theme="{StaticResource DialogHintStyle}"
                           Text="请检查参数范围，并确保已设置模板" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,12,0,0"
                   Foreground="{DynamicResource IvDangerTextBrush}"
                   Text="{Binding TemplateMatchDialogErrorMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasTemplateMatchDialogErrorMessage}" />
    </StackPanel>
</UserControl>
