<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:DeepVisionSharp.UI.Avalonia.Controls;assembly=DeepVisionSharp.UI.Avalonia"
             xmlns:ui="clr-namespace:DeepVisionSharp.UI.Avalonia;assembly=DeepVisionSharp.UI.Avalonia"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.Dialogs.Contents.StartTrainingConfirmDialogContent"
             Width="720"
             AutomationProperties.AutomationId="dv.training.confirm-start"
             Foreground="{DynamicResource IvText1Brush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeepVisionSharp.Avalonia/Views/Dialogs/DialogStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Theme="{StaticResource DialogHintStyle}" Text="{Binding Subtitle}" />

            <Border Margin="0,14,0,0" Padding="16,16,16,6"
                    Background="{DynamicResource IvSurface3Brush}"
                    BorderBrush="{DynamicResource IvStrokeBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10" ColumnDefinitions="88,*">
                                <TextBlock Theme="{StaticResource RowLabelStyle}" Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" Theme="{StaticResource RowValueStyle}" Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Margin="0,18,0,0" ColumnDefinitions="1.3*,*">
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Theme="{StaticResource MetricLabelStyle}" Text="预计耗时" />
                    <TextBlock Theme="{StaticResource MetricValueStyle}" Text="{Binding DurationValue}" />
                    <TextBlock Theme="{StaticResource MetricNoteStyle}" Text="{Binding DurationNote}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Theme="{StaticResource MetricLabelStyle}" Text="本机 GPU" />
                    <TextBlock Theme="{StaticResource MetricValueSecondaryStyle}" Text="{Binding GpuValue}" />
                    <TextBlock Theme="{StaticResource MetricNoteStyle}" Text="{Binding GpuNote}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,20,0,0" IsVisible="{Binding HasNotes}">
                <TextBlock Theme="{StaticResource SectionTitleStyle}" Text="启动前请注意" />
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*">
                                <iv:Icon Grid.Column="0" Margin="0,1,8,0" FontSize="14"
                                         Foreground="{DynamicResource IvWarningBrush}"
                                         Data="{x:Static ui:IvIcons.Warning}"
                                         IsVisible="{Binding IsWarning}" />
                                <iv:Icon Grid.Column="0" Margin="0,1,8,0" FontSize="14"
                                         Foreground="{DynamicResource IvText2Brush}"
                                         Data="{x:Static ui:IvIcons.Info}"
                                         IsVisible="{Binding IsInfo}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Theme="{StaticResource NoteTitleStyle}" Text="{Binding Title}" />
                                    <TextBlock Theme="{StaticResource NoteBodyStyle}" Text="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Margin="0,18,0,0" FontSize="11"
                       Text="{Binding StatusText}"
                       Classes="statusText"
                       Classes.warning="{Binding StatusIsWarning}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
