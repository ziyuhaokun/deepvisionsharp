<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iv="clr-namespace:DeepVisionSharp.UI.Avalonia.Controls;assembly=DeepVisionSharp.UI.Avalonia"
             xmlns:ui="clr-namespace:DeepVisionSharp.UI.Avalonia;assembly=DeepVisionSharp.UI.Avalonia"
             xmlns:dv="clr-namespace:DeepVisionSharp.Shell.Avalonia.Controls.Training"
             xmlns:controls="clr-namespace:DeepVisionSharp.Shell.Avalonia.Controls"
             xmlns:training="clr-namespace:DeepVisionSharp.Shell.Avalonia.Controls.Training"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:domain="using:DeepVisionSharp.Domain.Entities"
             x:Class="DeepVisionSharp.Shell.Avalonia.Views.TrainingPage">

    <UserControl.Resources>
        <ControlTheme x:Key="TrainingJobItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="JobRow" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Border Name="SelectionIndicator" Width="3" Margin="0,9,0,9"
                                    HorizontalAlignment="Left" CornerRadius="1.5"
                                    Background="{DynamicResource IvAccentBrush}" IsVisible="False" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover:not(:disabled) /template/ Border#JobRow">
                <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#JobRow">
                <Setter Property="Background" Value="{DynamicResource IvAccentSubtleBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#SelectionIndicator">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#JobRow">
                <Setter Property="BorderBrush" Value="{DynamicResource IvFocusBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.5" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.trainingTab">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>
        <Style Selector="Button.trainingTab.active">
            <Setter Property="Foreground" Value="{DynamicResource IvAccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBrush}" />
        </Style>
        <Style Selector="Border.emptyState">
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector="Border.jobChip">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource IvSurface3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.jobChip TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource IvMonoFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.trainingJobStatus">
            <Setter Property="Padding" Value="9,2.5" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource IvSurface3Brush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IvText2Brush}" />
        </Style>
        <Style Selector="Border.trainingJobStatus.preparing">
            <Setter Property="Background" Value="{DynamicResource IvWarningSubtleBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IvWarningTextBrush}" />
        </Style>
        <Style Selector="Border.trainingJobStatus.running">
            <Setter Property="Background" Value="{DynamicResource IvInfoSubtleBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IvAccentTextBrush}" />
        </Style>
        <Style Selector="Border.trainingJobStatus.succeeded">
            <Setter Property="Background" Value="{DynamicResource IvSuccessSubtleBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IvSuccessTextBrush}" />
        </Style>
        <Style Selector="Border.trainingJobStatus.failed">
            <Setter Property="Background" Value="{DynamicResource IvDangerSubtleBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IvDangerTextBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Name="PageRootDock" Margin="32,28" LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock FontFamily="{DynamicResource IvDisplayFontFamily}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource IvText1Brush}"
                           Text="训练" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="12.5"
                           Foreground="{DynamicResource IvText2Brush}"
                           Text="创建和监控训练任务，查看指标、日志与产物" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Height="34"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        Command="{Binding JobList.CreateJobCommand}"
                        IsEnabled="{Binding JobList.IsTrainingWorkflow}"
                        Theme="{StaticResource IvPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iv:Icon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Add}" />
                        <TextBlock VerticalAlignment="Center" Text="新建任务" />
                    </StackPanel>
                </Button>
                <Button Height="34"
                        Padding="13,0"
                        Command="{Binding JobList.LoadCommand}"
                        Theme="{StaticResource IvSubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iv:Icon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Refresh}" />
                        <TextBlock VerticalAlignment="Center" Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0" MinHeight="240" ClipToBounds="True">
            <Border Classes="emptyState" IsVisible="{Binding JobList.ShowProjectRequired}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iv:Icon HorizontalAlignment="Center" FontSize="30" Foreground="{DynamicResource IvText3Brush}" Data="{x:Static ui:IvIcons.Play}" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="未选择项目" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource IvText2Brush}" Text="请先在项目面板选择一个项目，再创建训练任务。" />
                </StackPanel>
            </Border>

            <Grid IsVisible="{Binding JobList.IsTrainingWorkflow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*" MinWidth="208" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Classes="card">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="14,12"
                                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource IvText1Brush}"
                                           Text="训练任务" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource IvText2Brush}"
                                           Text="{Binding JobList.JobCount, StringFormat='{}{0} 项'}" />
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" Margin="8"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 AutomationProperties.Name="训练任务"
                                 ItemsSource="{Binding JobList.Jobs}"
                                 SelectedItem="{Binding JobList.SelectedJob, Mode=TwoWay}"
                                 ItemContainerTheme="{StaticResource TrainingJobItemTheme}"
                                 IsVisible="{Binding !JobList.HasEmptyJobList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="JobRowContainer"
                                            Background="Transparent"
                                            Tag="{Binding $parent[UserControl].DataContext}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="重命名…"
                                                          Command="{Binding #JobRowContainer.Tag.RenameJobByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.Edit}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="复制任务"
                                                          Command="{Binding #JobRowContainer.Tag.DuplicateJobByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.Copy}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="保存为模型"
                                                          Command="{Binding #JobRowContainer.Tag.SaveAsModelByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.Save}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="停止训练"
                                                          Command="{Binding #JobRowContainer.Tag.StopJobByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.Close}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="查看日志"
                                                          Command="{Binding #JobRowContainer.Tag.ShowLogsByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.Document}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="打开输出目录"
                                                          Command="{Binding #JobRowContainer.Tag.OpenOutputFolderByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.FolderOpen}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="打开日志目录"
                                                          Command="{Binding #JobRowContainer.Tag.OpenLogFolderByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.Folder}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="删除任务" Classes="danger"
                                                          Command="{Binding #JobRowContainer.Tag.ConfirmDeleteJobByIdCommand}"
                                                          CommandParameter="{Binding #JobRowContainer.DataContext.Id}">
                                                    <MenuItem.Icon>
                                                        <iv:Icon FontSize="15" Data="{x:Static ui:IvIcons.Delete}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Spacing="6">
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource IvText1Brush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Name}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                            ToolTip.Tip="{Binding MetaText}">
                                                    <Border Classes="jobChip">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <iv:Icon FontSize="11" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource IvText3Brush}"
                                                                     Data="{x:Static ui:IvIcons.Clock}" />
                                                            <TextBlock Text="{Binding StartedText}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="jobChip" IsVisible="{Binding HasDuration}">
                                                        <TextBlock Text="{Binding DurationText}" />
                                                    </Border>
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="trainingJobStatus"
                                                        Classes.preparing="{Binding Status, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static domain:TrainingJobStatus.Preparing}}"
                                                        Classes.running="{Binding Status, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static domain:TrainingJobStatus.Running}}"
                                                        Classes.succeeded="{Binding Status, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static domain:TrainingJobStatus.Succeeded}}"
                                                        Classes.failed="{Binding Status, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static domain:TrainingJobStatus.Failed}}">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                               Text="{Binding StatusDisplay}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Margin="16" Spacing="6"
                                    VerticalAlignment="Center" IsHitTestVisible="False"
                                    IsVisible="{Binding JobList.HasEmptyJobList}">
                            <iv:Icon HorizontalAlignment="Center" FontSize="26"
                                     Foreground="{DynamicResource IvText3Brush}" Data="{x:Static ui:IvIcons.Documents}" />
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource IvText1Brush}"
                                       Text="暂无训练任务" TextAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource IvText2Brush}"
                                       Text="点击右上角的“新建任务”开始配置。" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

                <Border Grid.Column="2" Classes="card" IsVisible="{Binding JobList.ShowSelectJobPrompt}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iv:Icon HorizontalAlignment="Center" FontSize="30" Foreground="{DynamicResource IvText3Brush}" Data="{x:Static ui:IvIcons.ArrowRight}" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="请选择任务" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource IvText2Brush}" Text="在左侧选择一个任务，或新建训练任务。" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="card" IsVisible="{Binding JobList.ShowDetailPreparing}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:BusyRing Width="36" Height="36" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="正在加载任务配置…" />
                    </StackPanel>
                </Border>

                <Border x:Name="JobDetailCard" Grid.Column="2" Classes="card" IsVisible="{Binding JobList.ShowYoloJobDetail}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Border Grid.Row="0"
                                Padding="16,14,16,10"
                                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding Config.ModelName}" TextTrimming="CharacterEllipsis" />
                                        <Border Margin="10,0,0,0" Padding="8,3" VerticalAlignment="Center" Background="{DynamicResource IvAccentSubtleBrush}" CornerRadius="10">
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource IvAccentTextBrush}" Text="{Binding Config.SelectedJobStatusDisplay}" />
                                        </Border>
                                        <iv:Icon Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource IvText2Brush}" Data="{x:Static ui:IvIcons.Settings}" IsVisible="{Binding Config.IsJobLocked}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource IvText3Brush}" Text="{Binding JobList.SelectedJobMetaText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding JobList.DuplicateJobCommand}"
                                            IsEnabled="{Binding Config.CanDuplicateJob}"
                                            Theme="{StaticResource IvIconButtonStyle}"
                                            ToolTip.Tip="复制为新草稿任务">
                                        <iv:Icon VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Copy}" />
                                    </Button>
                                    <Button VerticalAlignment="Top"
                                            Command="{Binding ConfirmDeleteJobCommand}"
                                            IsEnabled="{Binding Config.CanDeleteJob}"
                                            Theme="{StaticResource IvIconButtonStyle}"
                                            ToolTip.Tip="{Binding Config.DeleteJobToolTip}">
                                        <iv:Icon VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Delete}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="16,0" ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding Monitor.IsSettingsMode}">
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsBasicSectionActive}" Command="{Binding Monitor.ShowBasicSectionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="基本配置" />
                                            <iv:Icon Margin="6,0,0,0" FontSize="13" Foreground="{DynamicResource IvSuccessBrush}" Data="{x:Static ui:IvIcons.Check}" IsVisible="{Binding Config.IsBasicConfigurationComplete}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsDatasetSectionActive}" Command="{Binding Monitor.ShowDatasetSectionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="数据集" />
                                            <iv:Icon Margin="6,0,0,0" FontSize="13" Foreground="{DynamicResource IvSuccessBrush}" Data="{x:Static ui:IvIcons.Check}" IsVisible="{Binding Config.IsDatasetConfigurationComplete}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsHyperparametersSectionActive}" Command="{Binding Monitor.ShowHyperparametersSectionCommand}" Content="超参数" IsVisible="{Binding Config.UsesNetworkInputSize}" />
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsAdvancedSectionActive}" Command="{Binding Monitor.ShowAdvancedSectionCommand}" Content="高级参数" IsVisible="{Binding Config.UsesNetworkInputSize}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" IsVisible="{Binding Monitor.IsRunMode}">
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsOverviewSectionActive}" Command="{Binding Monitor.ShowOverviewSectionCommand}" Content="概览" IsEnabled="{Binding Monitor.AreResultTabsEnabled}" />
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsConfigPreviewSectionActive}" Command="{Binding Monitor.ShowConfigPreviewSectionCommand}" Content="配置" IsEnabled="{Binding Monitor.AreResultTabsEnabled}" />
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsPreviewSectionActive}" Command="{Binding Monitor.ShowPreviewSectionCommand}" Content="预览" IsEnabled="{Binding Monitor.AreResultTabsEnabled}" />
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsMetricsSectionActive}" Command="{Binding Monitor.ShowMetricsSectionCommand}" Content="指标" IsEnabled="{Binding Monitor.AreResultTabsEnabled}" />
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsLogsSectionActive}" Command="{Binding Monitor.ShowLogsSectionCommand}" Content="日志" IsEnabled="{Binding Monitor.AreResultTabsEnabled}" />
                                    <Button Classes="trainingTab" Classes.active="{Binding Monitor.IsResourcesSectionActive}" Command="{Binding Monitor.ShowResourcesSectionCommand}" Content="资源" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                    <controls:BusyRing Width="16" Height="16" Margin="0,0,6,0" IsVisible="{Binding Monitor.IsRunning}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <training:TrainingSettingsPanel IsVisible="{Binding Monitor.IsSettingsMode}" VerticalAlignment="Stretch" />
                            <training:TrainingRunPanel IsVisible="{Binding Monitor.IsRunMode}" VerticalAlignment="Stretch" />
                        </Grid>

                        <Border Grid.Row="3"
                                MinHeight="56"
                                Padding="16,11"
                                BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource IvWarningBrush}"
                                               Text="{Binding Config.StartTrainingBlockReason}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding Config.HasStartTrainingBlockReason}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Height="34"
                                            Padding="14,0"
                                            Margin="0,0,8,0"
                                            Command="{Binding Config.StartTrainingCommand}"
                                            ToolTip.Tip="{Binding Config.StartTrainingToolTip}"
                                            IsVisible="{Binding Monitor.IsSettingsMode}"
                                            Theme="{StaticResource IvPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <iv:Icon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Play}" />
                                            <TextBlock VerticalAlignment="Center" Text="开始训练" />
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34"
                                            Padding="12,0"
                                            Margin="0,0,8,0"
                                            Command="{Binding Config.ResumeTrainingCommand}"
                                            ToolTip.Tip="{Binding Config.ResumeTrainingToolTip}"
                                            IsVisible="{Binding Config.CanResumeTraining}"
                                            Theme="{StaticResource IvPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <iv:Icon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Refresh}" />
                                            <TextBlock VerticalAlignment="Center" Text="继续训练" />
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34"
                                            Padding="12,0"
                                            Margin="0,0,8,0"
                                            Command="{Binding Config.StopTrainingCommand}"
                                            ToolTip.Tip="{Binding Config.StopTrainingToolTip}"
                                            Theme="{StaticResource IvSubtleButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <iv:Icon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Close}" />
                                            <TextBlock VerticalAlignment="Center" Text="停止" />
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34"
                                            Padding="12,0"
                                            Command="{Binding Config.SaveAsModelCommand}"
                                            ToolTip.Tip="{Binding Config.SaveAsModelToolTip}"
                                            Theme="{StaticResource IvSubtleButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <iv:Icon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Data="{x:Static ui:IvIcons.Save}" />
                                            <TextBlock VerticalAlignment="Center" Text="保存模型" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border ZIndex="10" Background="{DynamicResource IvOverlayBrush}" IsVisible="{Binding JobList.IsLoading}">
                <controls:BusyRing Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>