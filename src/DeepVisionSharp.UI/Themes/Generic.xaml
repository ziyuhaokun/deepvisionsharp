<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      DeepVisionSharp.UI 自定义控件的默认样式入口（由 AssemblyInfo 的 ThemeInfo 指向本程序集）。
      每个控件一个文件，键为 {x:Type dvsui:Xxx}，与 DefaultStyleKey 对应。
      源: InCube.UI.Avalonia/Themes/Generic.axaml + Themes/Forms.axaml
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DeepVisionSharp.UI;component/Controls/Icon.xaml" />
        <ResourceDictionary Source="/DeepVisionSharp.UI;component/Controls/NumericBox.xaml" />
        <ResourceDictionary Source="/DeepVisionSharp.UI;component/Controls/FormRow.xaml" />
        <ResourceDictionary Source="/DeepVisionSharp.UI;component/Controls/FormSection.xaml" />
        <ResourceDictionary Source="/DeepVisionSharp.UI;component/Controls/Dialog.xaml" />
        <ResourceDictionary Source="/DeepVisionSharp.UI;component/Controls/Window.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
