<!-- 源: Themes/AppStyles.axaml (84 行) | 转换: Classes 选择器 → keyed Style（Border/Ellipse/Rectangle/TextBlock 无 ControlTheme 可用）；:pointerover → Style.Triggers/IsMouseOver；translateY(-2px) → TranslateTransform（悬停终态 1:1，过渡动画降级见 IvModelCardStyle 注释） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      本文件是源 AppStyles.axaml 的唯一落点。源用 Classes 表达「可选装饰」（Border.badge /
      statusDot / statusSquare / modelCard / selectableRow / statusText），WPF 没有类叠加语义，
      因此每个类一个 keyed Style，组合态用 BasedOn 派生；页面里用 Style="{StaticResource IvXxxStyle}" 取用。

      本文件刻意不含任何 implicit <Style TargetType="TextBlock">：WPF 的 implicit 样式优先级高于
      属性继承，会给按钮/输入框里由字符串自动生成的 TextBlock 强行改字号和前景色，压掉控件级令牌。
      全局文字基线由页面/窗口根元素声明 FontFamily + FontSize + Foreground 走继承解决。
    -->

    <!-- 源 Border.badge：淡底 + 1px 细描边 + IvRadiusControl + 6,2 内边距 + 等宽 11px 次要前景色 -->
    <Style x:Key="IvBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusControl}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource IvMonoFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>

    <!-- 源 Ellipse.statusDot：8×8 状态圆点，默认成功色 -->
    <Style x:Key="IvStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource IvSuccessBrush}" />
    </Style>

    <!-- 源 Rectangle.statusSquare：7×7 状态方块，默认成功色 -->
    <Style x:Key="IvStatusSquareStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource IvSuccessBrush}" />
    </Style>

    <!--
      源 Border.modelCard：420×280 模型卡，悬停描边换 IvAccentBorderBrush 并上浮 2px。
      源用 TransformOperationsTransition(150ms, IvMotionEase) 做平滑上浮；WPF 里 Style setter 上的
      Freezable（TranslateTransform）会被冻结，冻结对象不能做动画，因此这里只复刻悬停终态（瞬时上浮 2px）。
      需要同一视觉再加过渡的页面：在自己标记上声明 <TranslateTransform/>，再按
      Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" 补 0 → -2 / -2 → 0 的 150ms 动画
      （本仓库 DashboardPageResources.xaml 的 ProjectCardStyle 就是这个写法）。
    -->
    <Style x:Key="IvModelCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Width" Value="420" />
        <Setter Property="MinHeight" Value="280" />
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBorderBrush}" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-2" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 源 Border.selectableRow：可选行，10,8 内边距 + 1px 描边 + 6 圆角 -->
    <Style x:Key="IvSelectableRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 源 Border.selectableRow.selected：选中态描边换 IvAccentBrush、底色换 IvAccentSubtleBrush（BasedOn 叠加） -->
    <Style x:Key="IvSelectableRowSelectedStyle"
           TargetType="Border"
           BasedOn="{StaticResource IvSelectableRowStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource IvAccentSubtleBrush}" />
    </Style>

    <!-- 源 TextBlock.statusText：次要前景色 -->
    <Style x:Key="IvStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>

    <!-- 源 TextBlock.statusText.warning：警告色（BasedOn 叠加） -->
    <Style x:Key="IvStatusTextWarningStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IvStatusTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource IvWarningBrush}" />
    </Style>

</ResourceDictionary>
