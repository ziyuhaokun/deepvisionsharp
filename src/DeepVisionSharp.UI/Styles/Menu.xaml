<!-- 源: Styles/Menu.axaml (47 行) | 转换: MenuItem 的 popup 内嵌模板 → WPF Role 分支 + PART_Popup；:selected 展开态 → IsSubmenuOpen；CornerRadius 落到模板 Border -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 菜单栏：透明底、零内边距 -->
    <Style x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        菜单项：28 高、10,0 内边距、2 圆角。
        顶级标题（Role=TopLevelHeader）弹出层向下，子菜单标题（Role=SubmenuHeader）向右并带箭头，
        展开态用 IsSubmenuOpen（源 IsExpanded 的 WPF 对应属性）压住悬停色。
    -->
    <Style x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource IvRadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock x:Name="GestureText"
                                           Grid.Column="2"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource IvText3Brush}"
                                           Text="{TemplateBinding InputGestureText}"
                                           Visibility="Collapsed" />
                                <Path x:Name="Arrow"
                                      Grid.Column="3"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Data="M 0,0 L 4,4 L 0,8"
                                      Stroke="{DynamicResource IvText3Brush}"
                                      StrokeThickness="1.2"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Right"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <!-- 弹出层外壳：IvPopupBrush 底 + 1px 描边 + IvRadiusControl 圆角 + IvPopupShadow 阴影；外留 4/8 边距给阴影落点 -->
                            <Border Background="{DynamicResource IvPopupBrush}"
                                    BorderBrush="{DynamicResource IvStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource IvRadiusControl}"
                                    Padding="4"
                                    Margin="4,4,8,8"
                                    Effect="{DynamicResource IvPopupShadow}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvSurfaceSubtlePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 右键菜单外壳：IvPopupBrush 底、1px 描边、2 圆角、4 内边距（源 CornerRadius/Padding 在 WPF 落到模板 Border 上） -->
    <Style x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource IvPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource IvRadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            Margin="4,4,8,8"
                            Effect="{DynamicResource IvPopupShadow}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 提示气泡：IvPopupBrush 底、1px 描边、2 圆角、8,4 内边距、12 号字，带 IvPopupShadow -->
    <Style x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource IvPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource IvRadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            Margin="4,4,8,8"
                            Effect="{DynamicResource IvPopupShadow}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
