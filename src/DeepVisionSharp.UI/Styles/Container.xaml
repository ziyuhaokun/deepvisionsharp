<!-- 源: Styles/Container.axaml (46 行) | 转换: ControlTheme TargetType=ContentControl → Style x:Key + ControlTemplate（CornerRadius 落在模板 Border 上，值与源逐字一致） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        卡片：表面色 + 1px 细描边 + 2 圆角 + IvCardPadding。
        源是 ContentControl 的 ControlTheme，WPF 保留 ContentControl（Control 自带 Padding/
        Background/BorderBrush/BorderThickness），只有 CornerRadius 不在 Control 上，
        因此和源一样写在模板的 Border 里，数值仍是 IvRadiusSmall。
    -->
    <Style x:Key="IvCardStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource IvCardPadding}" />
        <Setter Property="Focusable" Value="False" />
        <!-- Avalonia 的 TopLevel.LayoutRounding 默认 true，卡片高度会被取整到整像素；WPF 默认 false，
             行高 18.59 会让卡片落在 44.59 上，底边描边被摊成两条半透明行。打开版面取整对齐 Avalonia。 -->
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource IvRadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 提示卡：更淡的底、4 圆角、10,8 内边距 -->
    <Style x:Key="IvCalloutCardStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Focusable" Value="False" />
        <!-- 同 IvCardStyle：对齐 Avalonia 默认开启的版面取整 -->
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource IvRadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
