<!-- 源: Styles/ComboBox.axaml (112 行) | 转换: ControlTheme→隐式 Style, Popup Placement/Offset 原样, BoxShadow→Effect(DynamicResource IvPopupBoxShadow), controls:Icon→dvsui:Icon(FontSize→ViewSize), 占位文本走 dvsuiroot:IvPlaceholder.Text -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dvsui="clr-namespace:DeepVisionSharp.UI.Controls"
                    xmlns:dvsuiroot="clr-namespace:DeepVisionSharp.UI">

    <!-- 下拉框：三层外框 + 30 宽箭头 + 弹层（Bottom，-8/+4 偏移，5 内边距） -->
    <Style x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeight}" />
        <Setter Property="Padding" Value="14,0,32,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="FocusRing"
                                Margin="-1"
                                BorderBrush="{DynamicResource IvFocusRingBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource IvRadiusFocusRingPill}"
                                Opacity="0" />
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource IvRadiusButton}" />
                        <Border x:Name="HoverLayer"
                                Background="{DynamicResource IvStateHoverBrush}"
                                CornerRadius="{DynamicResource IvRadiusButton}"
                                Opacity="0" />
                        <ContentPresenter x:Name="SelectionBox"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" />
                        <!-- WPF 可编辑态必需部件（源 Avalonia 版无编辑态，此处只补齐部件，默认 Collapsed） -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{x:Null}"
                                 Margin="{TemplateBinding Padding}"
                                 Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{DynamicResource IvText1Brush}"
                                 VerticalContentAlignment="Center"
                                 FocusVisualStyle="{x:Null}"
                                 Visibility="Collapsed">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource IvText3Brush}"
                                   Text="{Binding Path=(dvsuiroot:IvPlaceholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                        <dvsui:Icon x:Name="Chevron"
                                 Width="30"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Data="{x:Static dvsuiroot:IvIcons.ChevronDown}"
                                 ViewSize="{DynamicResource IvFontSizeCaption}"
                                 Foreground="{DynamicResource IvText2Brush}"
                                 RenderTransformOrigin="0.5,0.5" />
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               HorizontalOffset="-8"
                               VerticalOffset="4"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               Focusable="False">
                            <Border Background="{DynamicResource IvPopupBrush}"
                                    BorderBrush="{DynamicResource IvStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource IvRadiusOverlay}"
                                    Padding="5"
                                    MinWidth="120"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{DynamicResource IvPopupBoxShadow}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 源 ^:pointerover /template/ Border#HoverLayer: Opacity=1 + DoubleTransition 0:0:0.120 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="ComboHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.120" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <!-- 源离开 :pointerover 时过渡随样式失效 → 瞬回 0；WPF 需显式停掉动画 -->
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ComboHoverIn" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- 源 ^:disabled（同时压掉悬停层，WPF 禁用元素仍会报 IsMouseOver） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0" />
                        </Trigger>
                        <!-- 源 Placeholder 的可见性：SelectionBoxItem 为 null 时显示 -->
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <!-- 源只覆盖 Border#Background 的底色，形状沿用 Avalonia 默认项模板；此处按 List 项的 1px 圆角对齐 -->
                    <Border x:Name="Background"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource IvRadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource IvAccentSubtleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
