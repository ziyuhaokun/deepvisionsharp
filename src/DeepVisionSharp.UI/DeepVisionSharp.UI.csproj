<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- DeepVisionSharp.UI：WPF 设计系统。视觉与令牌逐值移植自 deepvision 的 InCube.UI.Avalonia（Avalonia 12.1.5）。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>DeepVisionSharp.UI</AssemblyName>
    <RootNamespace>DeepVisionSharp.UI</RootNamespace>
    <PackageId>DeepVisionSharp.UI</PackageId>
    <Product>DeepVisionSharp.UI</Product>
    <Description>DeepVisionSharp.UI — WPF 设计系统（移植自 InCube.UI.Avalonia）</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
