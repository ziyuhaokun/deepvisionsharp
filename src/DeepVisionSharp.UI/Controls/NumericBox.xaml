<!-- 源: Themes/Forms.axaml (176 行) 的 NumericBox 段 | 转换: ControlTheme→Style(TargetType)；ColumnDefinitions/RowDefinitions 简写→ColumnDefinition 列表；伪类→Trigger；颜色一律 DynamicResource -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dvsui="clr-namespace:DeepVisionSharp.UI.Controls"
                    xmlns:dvsuiroot="clr-namespace:DeepVisionSharp.UI">

    <!--
      数字框：输入 + 单位 + 18 宽上下步进器。
      源里两个步进 Button 用局部值 Background=Transparent / BorderThickness=0 覆盖主题按钮；
      WPF 侧用自带的最小模板屏蔽系统按钮的 VSM 悬停/按下动画，否则会给步进器套上灰色按钮底。
    -->
    <Style x:Key="{x:Type dvsui:NumericBox}" TargetType="{x:Type dvsui:NumericBox}">
        <Setter Property="Background" Value="{DynamicResource IvInputBrush}" />
        <!-- 源值：BorderBrush=IvStrokeBrush（#D5D7DA）、Padding=10,0,2,0，逐值照抄，不换成 IvControlBorderBrush / IvInputPadding -->
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeight}" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="10,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dvsui:NumericBox}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource IvRadiusControl}" />

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PART_TextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Foreground="{TemplateBinding Foreground}" />

                            <TextBlock Grid.Column="1"
                                       Margin="6,0,6,0"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Unit}"
                                       FontSize="{DynamicResource IvFontSizeCaption}"
                                       Foreground="{DynamicResource IvText3Brush}" />

                            <Grid Grid.Column="2" Width="18" Margin="0,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button x:Name="PART_UpButton">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtlePressedBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="▲" FontSize="7" Foreground="{DynamicResource IvText2Brush}" />
                                </Button>

                                <Button x:Name="PART_DownButton" Grid.Row="1">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtlePressedBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="▼" FontSize="7" Foreground="{DynamicResource IvText2Brush}" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IvFocusRingBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
