<!-- 源: Controls/Icon.cs (87 行) | 转换: Render/MeasureOverride→ControlTemplate；24 画布固定尺寸 + Viewbox 等比缩放，Path 圆头描边 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dvsui="clr-namespace:DeepVisionSharp.UI.Controls"
                    xmlns:dvsuiroot="clr-namespace:DeepVisionSharp.UI">

    <!--
      源 Render 的绘制口径：scale = min(width, height) / ViewSize，然后以 ViewSize 为「画布」等比缩放并居中。
      WPF 用「Path 固定 24×24 不缩放 + Viewbox 等比缩放到 ViewSize」实现同一口径：
      几何坐标仍是 0..24，画笔粗细也随整体一起缩放（源里 PushTransform 同样会缩放 pen）。
    -->
    <Style x:Key="{x:Type dvsui:Icon}" TargetType="{x:Type dvsui:Icon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dvsui:Icon}">
                    <Grid>
                        <!-- 源 Render 首行 FillRectangle(Brushes.Transparent)：整块 ViewSize 区域可命中 -->
                        <Rectangle Fill="Transparent" />

                        <Viewbox x:Name="PART_Viewbox"
                                 Width="{TemplateBinding ViewSize}"
                                 Height="{TemplateBinding ViewSize}"
                                 Stretch="Uniform">
                            <Path x:Name="PART_Path"
                                  Width="{x:Static dvsuiroot:IvIcons.CanvasSize}"
                                  Height="{x:Static dvsuiroot:IvIcons.CanvasSize}"
                                  Stretch="None"
                                  Data="{TemplateBinding Data}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
