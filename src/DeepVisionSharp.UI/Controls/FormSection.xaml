<!-- 源: Themes/Forms.axaml (176 行) 的 FormSection 段 | 转换: ControlTheme→Style(x:Key={x:Type})；DockPanel 原样；属性样式 ^[HasHeader=False]→ControlTemplate.Triggers 隐藏标题带 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dvsui="clr-namespace:DeepVisionSharp.UI.Controls"
                    xmlns:dvsuiroot="clr-namespace:DeepVisionSharp.UI">

    <!--
      分组容器：32 高标题带（IvBandBrush，13 号半粗）+ 1px 描边主体；整块下外边距 16。
      源用 IsVisible=False 隐藏标题带，WPF 等价物是 Visibility=Collapsed（DockPanel 里同样彻底让位）。
    -->
    <Style x:Key="{x:Type dvsui:FormSection}" TargetType="{x:Type dvsui:FormSection}">
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dvsui:FormSection}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel>
                            <Border x:Name="HeaderBand"
                                    DockPanel.Dock="Top"
                                    MinHeight="32"
                                    Padding="14,0"
                                    Background="{DynamicResource IvBandBrush}"
                                    BorderBrush="{DynamicResource IvStrokeSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="{DynamicResource IvFontSizeBodySmall}"
                                                  TextElement.FontWeight="SemiBold" />
                            </Border>

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="HeaderBand" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
