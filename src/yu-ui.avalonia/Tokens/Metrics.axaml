<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="IvControlHeightCompact">24</x:Double>
    <x:Double x:Key="IvControlHeightSmall">24</x:Double>
    <x:Double x:Key="IvControlHeight">30</x:Double>
    <x:Double x:Key="IvIconButtonSize">28</x:Double>
    <x:Double x:Key="IvControlHeightLarge">32</x:Double>

    <CornerRadius x:Key="IvRadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="IvRadiusButton">2</CornerRadius>
    <CornerRadius x:Key="IvRadiusControl">2</CornerRadius>
    <CornerRadius x:Key="IvRadiusFocusRing">3</CornerRadius>
    <CornerRadius x:Key="IvRadiusFocusRingPill">3</CornerRadius>
    <CornerRadius x:Key="IvRadiusOverlay">4</CornerRadius>

    <Thickness x:Key="IvControlPadding">12,0,12,0</Thickness>
    <Thickness x:Key="IvInputPadding">8,0,8,0</Thickness>
    <Thickness x:Key="IvCardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="IvStrokeThickness">1</Thickness>

    <x:Double x:Key="IvSpace1">4</x:Double>
    <x:Double x:Key="IvSpace2">8</x:Double>
    <x:Double x:Key="IvSpace3">12</x:Double>
    <x:Double x:Key="IvSpace4">16</x:Double>
    <x:Double x:Key="IvSpace5">24</x:Double>
    <x:Double x:Key="IvSpace6">32</x:Double>


</ResourceDictionary>
