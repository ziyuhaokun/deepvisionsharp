<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Border / Ellipse / Rectangle 不是 TemplatedControl，Avalonia 里没有 Theme 可用，
        所以 WPF 的 keyed Style 在这里改成类选择器：用法 Class="badge" / "statusDot" / "statusSquare"。
    -->

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusControl}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource IvMonoFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>

    <Style Selector="Ellipse.statusDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource IvSuccessBrush}" />
    </Style>

    <Style Selector="Rectangle.statusSquare">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource IvSuccessBrush}" />
    </Style>

    <!-- 模型卡：420×280，悬停描边变强调色并上浮 2px -->
    <Style Selector="Border.modelCard">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Width" Value="420" />
        <Setter Property="MinHeight" Value="280" />
        <Setter Property="Background" Value="{DynamicResource IvSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                              Duration="0:0:0.150"
                                              Easing="{DynamicResource IvMotionEase}" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.modelCard:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBorderBrush}" />
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>


    <!-- 列表行选中态：WPF 的 DataTrigger 绑 IsSelected 改为此模式 -->
    <Style Selector="Border.selectableRow">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.selectableRow.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource IvAccentSubtleBrush}" />
    </Style>

    <Style Selector="TextBlock.statusText">
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>

    <Style Selector="TextBlock.statusText.warning">
        <Setter Property="Foreground" Value="{DynamicResource IvWarningBrush}" />
    </Style>

</Styles>
