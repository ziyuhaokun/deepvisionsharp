<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:YuUI.Controls"
                    xmlns:ui="clr-namespace:YuUI">

    <!-- 复选框：16×16 方框，选中层淡入 + 对勾 0.5→1 缩放，按下整体 0.88 缩放 -->
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="Background" Value="{DynamicResource IvInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeStrongBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeightSmall}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent" ColumnDefinitions="Auto,*">
                    <Grid Name="BoxRoot" Width="16" Height="16"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RenderTransformOrigin="50%,50%">
                        <Border Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource IvRadiusSmall}" />
                        <Border Name="CheckedLayer"
                                Background="{DynamicResource IvAccentBrush}"
                                BorderBrush="{DynamicResource IvAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource IvRadiusSmall}"
                                Opacity="0">
                            <controls:Icon Name="Check"
                                           Data="{x:Static ui:IvIcons.Check}"
                                           FontSize="{DynamicResource IvFontSizeBodySmall}"
                                           Foreground="{DynamicResource IvTextOnAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="50%,50%"
                                           RenderTransform="scale(0.5)" />
                        </Border>
                        <Border Name="IndeterminateLayer"
                                Background="{DynamicResource IvAccentBrush}"
                                BorderBrush="{DynamicResource IvAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource IvRadiusSmall}"
                                IsVisible="False">
                            <Rectangle Name="Dash"
                                       Width="8"
                                       Height="2"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{DynamicResource IvTextOnAccentBrush}" />
                        </Border>
                    </Grid>
                    <ContentPresenter Name="Content"
                                      Grid.Column="1"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource IvSurface3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvText3Brush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#CheckedLayer">
            <Setter Property="Background" Value="{DynamicResource IvAccentHoverBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#IndeterminateLayer">
            <Setter Property="Background" Value="{DynamicResource IvAccentHoverBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#CheckedLayer">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.120" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:checked /template/ controls|Icon#Check">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                  Duration="0:0:0.200"
                                                  Easing="{DynamicResource IvMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:checked /template/ Border#IndeterminateLayer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pressed /template/ Grid#BoxRoot">
            <Setter Property="RenderTransform" Value="scale(0.88)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.060" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#CheckedLayer">
            <Setter Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#Dash">
            <Setter Property="Fill" Value="{DynamicResource IvTextDisabledBrush}" />
        </Style>
    </ControlTheme>

    <!-- 单选：16×16 圆环，选中层淡入 + 内点 0→1 缩放 -->
    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="Background" Value="{DynamicResource IvInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeStrongBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeightSmall}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent" ColumnDefinitions="Auto,*">
                    <Grid Name="BoxRoot" Width="16" Height="16"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RenderTransformOrigin="50%,50%">
                        <Ellipse Name="Ring"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="1" />
                        <Ellipse Name="CheckedRing"
                                 Fill="{DynamicResource IvAccentBrush}"
                                 Opacity="0" />
                        <Ellipse Name="Dot"
                                 Width="6"
                                 Height="6"
                                 Fill="{DynamicResource IvTextOnAccentBrush}"
                                 RenderTransformOrigin="50%,50%"
                                 RenderTransform="scale(0)" />
                    </Grid>
                    <ContentPresenter Name="Content"
                                      Grid.Column="1"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Ellipse#Ring">
            <Setter Property="Fill" Value="{DynamicResource IvSurface3Brush}" />
            <Setter Property="Stroke" Value="{DynamicResource IvText3Brush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#CheckedRing">
            <Setter Property="Fill" Value="{DynamicResource IvAccentHoverBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#CheckedRing">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.120" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Dot">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                  Duration="0:0:0.200"
                                                  Easing="{DynamicResource IvMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pressed /template/ Grid#BoxRoot">
            <Setter Property="RenderTransform" Value="scale(0.88)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.060" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#Ring">
            <Setter Property="Fill" Value="{DynamicResource IvSurfaceDisabledBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource IvStrokeBrush}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
