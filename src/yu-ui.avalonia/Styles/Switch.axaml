<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 开关：36×18 轨道 + 14×14 方块滑块，选中时滑块右移 18、强调层淡入 -->
    <ControlTheme x:Key="IvSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeightSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="Root" Background="Transparent" ColumnDefinitions="*,Auto">
                    <ContentPresenter Name="Content"
                                      Margin="0,0,12,0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <Grid Grid.Column="1" Width="36" Height="18"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <Border Name="Track"
                                CornerRadius="2"
                                Background="{DynamicResource IvSwitchTrackBrush}"
                                BorderBrush="{DynamicResource IvControlBorderBrush}"
                                BorderThickness="1" />
                        <Border Name="TrackOn"
                                CornerRadius="2"
                                Background="{DynamicResource IvAccentBrush}"
                                BorderBrush="{DynamicResource IvAccentBorderBrush}"
                                BorderThickness="1"
                                Opacity="0" />
                        <Border Name="Knob"
                                Width="14"
                                Height="14"
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                CornerRadius="1"
                                Background="{DynamicResource IvThumbBrush}"
                                RenderTransform="translateX(0px)" />
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#TrackOn">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.120" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:checked /template/ Border#Knob">
            <Setter Property="RenderTransform" Value="translateX(18px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                  Duration="0:0:0.140"
                                                  Easing="{DynamicResource IvMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Track">
            <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderHoverBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:disabled /template/ Grid#Root">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
