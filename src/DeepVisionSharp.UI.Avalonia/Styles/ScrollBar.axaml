<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 滚动条滑块：常态 4px，悬停 8px 并加深；无箭头按钮 -->
    <ControlTheme x:Key="IvScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Border Name="Bd"
                            Width="4"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource IvStrokeStrongBrush}"
                            CornerRadius="1" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource IvText3Brush}" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.120"
                                      Easing="{DynamicResource IvMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource IvText2Brush}" />
        </Style>
    </ControlTheme>

    <!-- 轨道两侧的翻页按钮：Track 会自己接管 IsVisible，模板里写 IsVisible=False 无效，
         不给模板就会套默认按钮样式画出一块圆角灰块。这里只留透明命中区，保留「点轨道翻页」。 -->
    <ControlTheme x:Key="IvScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="2">
                    <Track Name="PART_Track"
                           Orientation="{TemplateBinding Orientation}"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.Thumb>
                            <Thumb Theme="{StaticResource IvScrollBarThumbStyle}" />
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Theme="{StaticResource IvScrollBarPageButtonStyle}" />
                        </Track.IncreaseButton>
                        <Track.DecreaseButton>
                            <RepeatButton Theme="{StaticResource IvScrollBarPageButtonStyle}" />
                        </Track.DecreaseButton>
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- Avalonia 的竖向 Track 默认 Minimum 在底部；不反转的话滑块方向与滚动方向相反（偏移 0 时滑块在最下面）。Fluent 模板同样给竖向 Track 设了 IsDirectionReversed。 -->
        <Style Selector="^:vertical /template/ Track#PART_Track">
            <Setter Property="IsDirectionReversed" Value="True" />
        </Style>
        <Style Selector="^:horizontal">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="12" />
            <Setter Property="MinHeight" Value="12" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
