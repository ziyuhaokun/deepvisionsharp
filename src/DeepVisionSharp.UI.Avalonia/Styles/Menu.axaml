<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
        <Thickness x:Key="MenuFlyoutPresenterThemePadding">5</Thickness>
        <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
    </Styles.Resources>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource IvPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource IvStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
    </Style>

    <!-- Keep Fluent's menu templates, including submenu and keyboard navigation. -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource IvPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource IvStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusMenu}" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem:not(:separator)">
        <Setter Property="Margin" Value="4,2" />
    </Style>

    <Style Selector="MenuItem:not(:separator)">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeightLarge}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="{DynamicResource IvRadiusOverlay}" />
    </Style>

    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
    </Style>
    <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
        <Setter Property="Fill" Value="{DynamicResource IvText2Brush}" />
    </Style>
    <Style Selector="MenuItem:selected:not(:disabled) /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource IvStateHoverBrush}" />
    </Style>
    <Style Selector="MenuItem:pressed:not(:disabled) /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource IvStatePressedBrush}" />
    </Style>
    <Style Selector="MenuItem:selected:not(:disabled) /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
    </Style>
    <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
    </Style>
    <Style Selector="MenuItem.danger:not(:disabled)">
        <Setter Property="Foreground" Value="{DynamicResource IvDangerTextBrush}" />
    </Style>
    <Style Selector="MenuItem.danger:not(:disabled) /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource IvDangerTextBrush}" />
    </Style>
    <Style Selector="MenuItem.danger:selected:not(:disabled) /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource IvDangerSubtleBrush}" />
    </Style>

    <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator, MenuItem Separator">
        <Setter Property="Background" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="5,4" />
    </Style>

</Styles>
