<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DeepVisionSharp.UI.Avalonia.Controls"
                    xmlns:ui="clr-namespace:DeepVisionSharp.UI.Avalonia">

    <!-- 窗口按钮：40×32，悬停 120ms 淡入、离开 150ms 淡出（与 WPF 版一致） -->
    <ControlTheme x:Key="IvCaptionButtonTheme" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Border Name="Bg" Background="{DynamicResource IvStateHoverBrush}" Opacity="0" />
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Bg">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.120" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource IvSurfaceSelectedBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="IvCaptionCloseButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource IvCaptionButtonTheme}">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Border Name="Bg" Background="{DynamicResource IvDangerBrush}" Opacity="0" />
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource IvDangerPressedBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:ThemedWindow}" TargetType="controls:ThemedWindow">
        <Setter Property="Background" Value="{DynamicResource IvBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root" Background="{TemplateBinding Background}">
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <StackPanel Name="CaptionButtons"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Name="PART_MinimizeButton" Theme="{StaticResource IvCaptionButtonTheme}">
                                <controls:Icon Data="{x:Static ui:IvIcons.WindowMinimize}"
                                               FontSize="12"
                                               Foreground="{Binding $parent[Button].Foreground}" />
                            </Button>
                            <Button Name="PART_MaximizeButton" Theme="{StaticResource IvCaptionButtonTheme}">
                                <controls:Icon Data="{x:Static ui:IvIcons.WindowMaximize}"
                                               FontSize="12"
                                               Foreground="{Binding $parent[Button].Foreground}" />
                            </Button>
                            <Button Name="PART_CloseButton" Theme="{StaticResource IvCaptionCloseButtonTheme}">
                                <controls:Icon Data="{x:Static ui:IvIcons.Close}"
                                               FontSize="12"
                                               Foreground="{Binding $parent[Button].Foreground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
