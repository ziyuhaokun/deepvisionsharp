<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      yu-ui 样式入口（含隐式样式，会改变按钮/输入框等原生控件的默认外观）。
      只给已迁移的页面或探针页 merge，不要在未迁移的页面上启用。
      源: InCube.UI.Avalonia/Styles/*.axaml + Themes/*.axaml
    -->
    <ResourceDictionary.MergedDictionaries>
        <!-- 基础与效果 -->
        <ResourceDictionary Source="/yu-ui;component/Styles/Common.xaml" />

        <!-- 输入与操作 -->
        <ResourceDictionary Source="/yu-ui;component/Styles/Button.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/ButtonImplicit.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/TextInput.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/Selection.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/ComboBox.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/Switch.xaml" />

        <!-- 容器 / 列表 / 滚动 / 指示器 -->
        <ResourceDictionary Source="/yu-ui;component/Styles/Container.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/List.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/TreeView.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/Menu.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/ScrollBar.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/ProgressBar.xaml" />
        <ResourceDictionary Source="/yu-ui;component/Styles/Slider.xaml" />

        <!-- 全局文字与排版 -->
        <ResourceDictionary Source="/yu-ui;component/Themes/AppStyles.xaml" />

        <!-- 自绘控件默认样式（ThemedWindow / Dialog / FormRow / FormSection / Icon / NumericBox） -->
        <ResourceDictionary Source="/yu-ui;component/Themes/Generic.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
