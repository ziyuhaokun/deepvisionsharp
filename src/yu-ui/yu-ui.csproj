<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- yu-ui：WPF 设计系统。视觉与令牌逐值移植自 deepvision 的 InCube.UI.Avalonia（Avalonia 12.1.5）。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>yu-ui</AssemblyName>
    <RootNamespace>YuUI</RootNamespace>
    <PackageId>yu-ui</PackageId>
    <Product>yu-ui</Product>
    <Description>yu-ui — WPF 设计系统（移植自 InCube.UI.Avalonia）</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
