<!-- 源: Themes/Generic.axaml (96 行) | 转换: ControlTheme→Style(x:Key)；按钮伪类 :pointerover→ControlTemplate.Triggers，:pressed→Bg 的 DataTrigger；Transitions(120ms 淡入/150ms 淡出)→EnterActions/ExitActions 的 DoubleAnimation -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:yu="clr-namespace:YuUI.Controls"
                    xmlns:yuroot="clr-namespace:YuUI">

    <!--
      窗口按钮：40×32，悬停 120ms 淡入、离开 150ms 淡出（与源 Transitions 一致）。
      源用 :pointerover 与 :pressed 两个伪类；WPF 的 IsMouseOver 在禁用态也会为 true，
      所以悬停用 MultiTrigger 加 IsEnabled=True，等价于 Avalonia「禁用时伪类不生效」。

      写法约定：被触发器覆盖的属性，默认值一律写在元素自己的 Style 里。
      WPF 优先级是 本地值 > 模板触发器 > Style Setter，默认值若写成元素属性，触发器就再也盖不上去。
      底色切换放在 Bg 自己的 Style 里用 DataTrigger 读 IsPressed：
      这样 Setter 的 Property 一定解析到 Border.Background，不受模板 TargetType（Button）影响。
    -->
    <Style x:Key="IvCaptionButtonTheme" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource IvStateHoverBrush}" />
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource IvSurfaceSelectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Setters>
                                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
                            </MultiTrigger.Setters>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="CaptionHoverFadeIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.120" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard x:Name="CaptionHoverFadeOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.150" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      关闭按钮：同形状（40×32、同一套淡入淡出），底色换成关闭专用令牌。
      注意：源 Generic.axaml 这里用的是 IvDangerBrush / IvDangerPressedBrush、悬停文字写死 White；
      本移植按父代理既定方向改用 IvCaptionCloseHoverBrush / IvCaptionClosePressedBrush / IvCaptionCloseTextBrush
      （三者在 Light 与 Dark 都是 #C75050 / #A13A3A / #FFFFFF）。
    -->
    <Style x:Key="IvCaptionCloseButtonTheme" TargetType="{x:Type Button}" BasedOn="{StaticResource IvCaptionButtonTheme}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource IvCaptionCloseHoverBrush}" />
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource IvCaptionClosePressedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Setters>
                                <Setter Property="Foreground" Value="{DynamicResource IvCaptionCloseTextBrush}" />
                            </MultiTrigger.Setters>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="CaptionCloseFadeIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.120" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard x:Name="CaptionCloseFadeOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.150" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      窗口：源模板是「根 Border(IvBackgroundBrush) + 内容铺满 + 右上角按钮组覆盖」，
      配合 Avalonia 的 WindowDecorations.BorderOnly（标题栏交给应用自己画）。
      WPF 侧按既定契约为自绘标题栏：标题栏高 CaptionHeight(52)，左图标 + 标题、右侧三个按钮，
      内容区在标题栏下方；按钮 40×32、图标 12 与源一致。
    -->
    <Style x:Key="{x:Type yu:ThemedWindow}" TargetType="{x:Type yu:ThemedWindow}">
        <Setter Property="Background" Value="{DynamicResource IvBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type yu:ThemedWindow}">
                    <Border x:Name="PART_Root" Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Grid x:Name="PART_TitleBar"
                                  DockPanel.Dock="Top"
                                  Height="{TemplateBinding CaptionHeight}"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image x:Name="CaptionIcon"
                                       Width="16"
                                       Height="16"
                                       Margin="14,0,8,0"
                                       VerticalAlignment="Center"
                                       Source="{TemplateBinding Icon}" />

                                <TextBlock x:Name="CaptionTitle"
                                           Grid.Column="1"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Title}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBodySmall}" />
                                            <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <Button x:Name="PART_MinimizeButton" Style="{StaticResource IvCaptionButtonTheme}">
                                        <yu:Icon Data="{x:Static yuroot:IvIcons.WindowMinimize}"
                                                 ViewSize="12"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    </Button>

                                    <Button x:Name="PART_MaximizeButton" Style="{StaticResource IvCaptionButtonTheme}">
                                        <Grid Width="12" Height="12">
                                            <yu:Icon x:Name="MaximizeGlyph"
                                                     Data="{x:Static yuroot:IvIcons.WindowMaximize}"
                                                     ViewSize="12"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                            <yu:Icon x:Name="RestoreGlyph"
                                                     Data="{x:Static yuroot:IvIcons.WindowRestore}"
                                                     ViewSize="12"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                <yu:Icon.Style>
                                                    <Style TargetType="{x:Type yu:Icon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Style>
                                                </yu:Icon.Style>
                                            </yu:Icon>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="PART_CloseButton" Style="{StaticResource IvCaptionCloseButtonTheme}">
                                        <yu:Icon Data="{x:Static yuroot:IvIcons.Close}"
                                                 ViewSize="12"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 内容区要有 AdornerDecorator：自定义 Window 模板里没有它，校验/焦点 adorners 就无处渲染 -->
                            <AdornerDecorator>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 最大化/还原图标切换：源由代码换 Data，WPF 侧用两个图标切可见性 -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaximizeGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- 是否活动窗口：源靠系统标题栏表现，自绘标题栏用文字色差 + 图标压暗替代 -->
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="CaptionTitle" Property="Foreground" Value="{DynamicResource IvText3Brush}" />
                            <Setter TargetName="CaptionIcon" Property="Opacity" Value="0.6" />
                        </Trigger>

                        <!-- 没设置 Icon / Title 时不占位 -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="CaptionIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="CaptionTitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
