<!-- 源: Themes/Forms.axaml (176 行) 的 FormRow 段 | 转换: ControlTheme→Style(x:Key={x:Type})；Grid ColumnDefinitions 简写→ColumnDefinition；TemplateBinding 原样；颜色一律 DynamicResource -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:yu="clr-namespace:YuUI.Controls"
                    xmlns:yuroot="clr-namespace:YuUI">

    <!--
      表单行：40 高、14,6 内边距、上缘分隔线，左标题 + 说明、右内容。
      数值全部照抄源（40 / 14,6 / 16 / 2 / 1），源里这些就是硬编码常量，没有对应令牌。
    -->
    <Style x:Key="{x:Type yu:FormRow}" TargetType="{x:Type yu:FormRow}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type yu:FormRow}">
                    <Grid Background="Transparent">
                        <Rectangle Height="1"
                                   VerticalAlignment="Top"
                                   Fill="{DynamicResource IvStrokeSubtleBrush}" />

                        <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <ContentPresenter Content="{TemplateBinding Header}" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{TemplateBinding Description}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource IvFontSizeCaption}"
                                           Foreground="{DynamicResource IvText2Brush}" />
                            </StackPanel>

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
