<!-- 源: Themes/Forms.axaml (176 行) 的 Dialog 段 | 转换: ControlTheme→Style(x:Key={x:Type})；BoxShadow→Effect(DropShadowEffect 令牌)；IsVisible→Visibility；ScrollViewer 原样 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:yu="clr-namespace:YuUI.Controls"
                    xmlns:yuroot="clr-namespace:YuUI">

    <!--
      对话框：遮罩 + 居中卡片。卡片尺寸/内边距/圆角/阴影/标题字号全部照抄源
      （MinWidth 420、Padding 24,20,24,18、IvRadiusOverlay、IvPopupShadow、22 号 Info 图标、15 号半粗标题）。
      源里宿主用 IsVisible="False" 起手，WPF 对应写法是 Visibility="Collapsed"，这里设为默认值，
      ShowAsync/Hide 会覆盖它（与源的 IsVisible 直接赋值等价）。
    -->
    <Style x:Key="{x:Type yu:Dialog}" TargetType="{x:Type yu:Dialog}">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type yu:Dialog}">
                    <Grid>
                        <Border Background="{DynamicResource IvOverlayBrush}" />

                        <Grid Margin="16">
                            <Border MinWidth="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource IvSurface2Brush}"
                                    BorderBrush="{DynamicResource IvStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource IvRadiusOverlay}"
                                    Effect="{DynamicResource IvPopupShadow}"
                                    Padding="24,20,24,18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel>
                                        <yu:Icon DockPanel.Dock="Left"
                                                 Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Data="{x:Static yuroot:IvIcons.Info}"
                                                 ViewSize="22"
                                                 Foreground="{DynamicResource IvAccentBrush}" />
                                        <TextBlock x:Name="PART_TitleText"
                                                   Text="{TemplateBinding Title}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{DynamicResource IvDisplayFontFamily}"
                                                   FontSize="{DynamicResource IvFontSizeSubtitle}"
                                                   FontWeight="SemiBold" />
                                    </DockPanel>

                                    <ScrollViewer Grid.Row="1"
                                                  Margin="0,10,0,0"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ContentPresenter x:Name="PART_ContentPresenter"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          TextElement.Foreground="{DynamicResource IvText2Brush}" />
                                    </ScrollViewer>

                                    <ContentPresenter x:Name="PART_FooterPresenter"
                                                      Grid.Row="2"
                                                      Margin="0,16,0,0"
                                                      HorizontalAlignment="Right"
                                                      Content="{TemplateBinding Footer}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
