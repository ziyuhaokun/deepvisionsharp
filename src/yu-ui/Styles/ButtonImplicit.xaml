<!-- 源: Styles/ButtonImplicit.axaml (65 行) | 转换: ControlTheme x:Key={x:Type Button}/{x:Type ToggleButton}→无 x:Key 的隐式 Style, BasedOn 需同字典可见故 merge Button.xaml, 伪类→Trigger, 禁用态用 MultiTrigger 排除 WPF 在禁用元素上仍报 IsMouseOver 的差异 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WPF 的 StaticResource 不跨同级 merge 的字典，隐式 Button 样式要 BasedOn IvButtonBaseStyle，故本文件自带一次 merge -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/yu-ui;component/Styles/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Button" BasedOn="{StaticResource IvButtonBaseStyle}" />

    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource IvControlPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource IvRadiusButton}" />
                        <Border x:Name="HoverLayer"
                                Background="{DynamicResource IvStateHoverBrush}"
                                CornerRadius="{DynamicResource IvRadiusButton}"
                                Opacity="0" />
                        <Border x:Name="PressLayer"
                                Background="{DynamicResource IvStatePressedBrush}"
                                CornerRadius="{DynamicResource IvRadiusButton}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 源 ^:pointerover 的 HoverLayer 无 Transitions，直接置 1 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0" />
                            <Setter TargetName="PressLayer" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderHoverBrush}" />
            </MultiTrigger>
            <!-- 源顺序：:checked 在 :pointerover 之后、:disabled 之前，同名属性后写的覆盖先写的 -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource IvAccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvAccentTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
