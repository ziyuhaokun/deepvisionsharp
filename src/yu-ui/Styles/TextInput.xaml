<!-- 源: Styles/TextInput.axaml (109 行) | 转换: ControlTheme→隐式 Style(x:Key={x:Type TextBox}), TextPresenter→PART_ContentHost(ScrollViewer, Padding 由 TextBox 自身下发给宿主), PlaceholderText→yuroot:IvPlaceholder.Text, Transitions→Storyboard(时长/缓动照抄源) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:yu="clr-namespace:YuUI.Controls"
                    xmlns:yuroot="clr-namespace:YuUI">

    <!-- 输入框：底框 + 焦点描边 + 外扩焦点环；占位文本用 yuroot:IvPlaceholder.Text -->
    <Style x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource IvInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource IvInputPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource IvAccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                        <Border x:Name="FocusRing"
                                Margin="-1"
                                BorderBrush="{DynamicResource IvFocusRingBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource IvRadiusFocusRing}"
                                Opacity="0" />
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource IvRadiusControl}" />
                        <Border x:Name="FocusBorder"
                                BorderBrush="{DynamicResource IvFocusBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource IvRadiusControl}"
                                Opacity="0" />
                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   Padding="2,0,0,0"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{DynamicResource IvText3Brush}"
                                   Text="{Binding Path=(yuroot:IvPlaceholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                        <!-- 源 TextPresenter 的 Margin=TemplateBinding Padding；WPF 由 TextBox 把 Padding 下发给宿主，宿主不再加 Margin -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 源 ^:focus /template/ Border#FocusBorder: Opacity=1 + DoubleTransition 0:0:0.120 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FocusIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.120" />
                                        <!-- 源 ^:focus /template/ Border#FocusRing: Opacity=1 + DoubleTransition 0:0:0.150 缓动 -->
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.150">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!-- 源失焦时过渡随状态失效 → 瞬回 0；WPF 需显式停掉动画 -->
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FocusIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 源 Placeholder 的可见性：Text 为空时显示 -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeStrongBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
            </Trigger>
            <!-- 源顺序：:read-only 在 :disabled 之后，同属性后者覆盖前者 -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource IvSurfaceSubtleHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 日志框：等宽、只读、整块背景 -->
    <Style x:Key="IvLogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource IvMonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeCaption}" />
        <Setter Property="Background" Value="{DynamicResource IvBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeSubtleBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

</ResourceDictionary>
