<!-- 源: Styles/ScrollBar.axaml (67 行) | 转换: Track 结构落到模板，纵/横各一个 ControlTemplate；:pointerover 的 4→8 过渡用 0.12s Storyboard -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        滚动条滑块：常态 4px，悬停 8px 并加深；无箭头按钮。
        源只有一个（纵向语义的）滑块主题：Border.Width=4 + 水平居中。为满足横向滚动条，
        横向滑块镜像成 Height=4 + 垂直居中（照抄宽度会得到一个 4x8 的小方块）。
        源 :pressed 在 WPF 的 Thumb 上对应 IsDragging（Thumb 没有 IsPressed）。
    -->
    <Style x:Key="IvScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Bd"
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource IvStrokeStrongBrush}"
                                CornerRadius="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 源 Width 的 DoubleTransition 带 Easing=IvMotionEase（CubicEaseOut） -->
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="Width"
                                                         To="8"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvText3Brush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvText2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 横向滑块：镜像自纵向滑块（Height=4 垂直居中，悬停 8） -->
    <Style x:Key="IvScrollBarThumbHorizontalStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Bd"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource IvStrokeStrongBrush}"
                                CornerRadius="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 横向滑块同样是 0.12s + CubicEaseOut（源纵向过渡的镜像） -->
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="Height"
                                                         To="8"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvText3Brush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IvText2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纵向滚动条：12 宽、内留 2 边距、透明底、无箭头（上下空白区用透明 RepeatButton 保留翻页命中） -->
    <ControlTemplate x:Key="IvVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}" Padding="2">
            <Track x:Name="PART_Track"
                   Orientation="Vertical"
                   IsDirectionReversed="True"
                   Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Opacity="0"
                                  Focusable="False"
                                  IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource IvScrollBarThumbStyle}" Focusable="False" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Opacity="0"
                                  Focusable="False"
                                  IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <!-- 横向滚动条：12 高，宽度回到自动 -->
    <ControlTemplate x:Key="IvHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}" Padding="2">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal"
                   IsDirectionReversed="False"
                   Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  Opacity="0"
                                  Focusable="False"
                                  IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource IvScrollBarThumbHorizontalStyle}" Focusable="False" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  Opacity="0"
                                  Focusable="False"
                                  IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template" Value="{StaticResource IvVerticalScrollBarTemplate}" />
        <Style.Triggers>
            <!-- 源 ^:horizontal：Width=NaN → 自动，MinWidth=0，Height/MinHeight=12 -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource IvHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
