<!-- 源: Styles/Button.axaml (134 行) | 转换: ControlTheme→Style(x:Key)+BasedOn, 伪类→ControlTemplate/Style.Triggers, Transitions→Storyboard(时长照抄源字面值), 禁用态用 MultiTrigger 排除 WPF 在禁用元素上仍报 IsMouseOver 的差异 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 按钮底模：填充层 + 悬停层 + 按下层，圆角令牌 IvRadiusButton -->
    <Style x:Key="IvButtonBaseStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource IvControlPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 源的按钮没有焦点虚线框；显式清空 WPF 默认 FocusVisualStyle -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource IvRadiusButton}" />
                        <Border x:Name="HoverLayer"
                                Background="{DynamicResource IvStateHoverBrush}"
                                CornerRadius="{DynamicResource IvRadiusButton}"
                                Opacity="0" />
                        <Border x:Name="PressLayer"
                                Background="{DynamicResource IvStatePressedBrush}"
                                CornerRadius="{DynamicResource IvRadiusButton}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 源 ^:pointerover 的 HoverLayer: Opacity=1 + DoubleTransition 0:0:0.100 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="HoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.100" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <!-- 源离开 :pointerover 时过渡随样式一起失效→瞬回 0；WPF 需显式停掉动画才能落回基础值 -->
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="HoverIn" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- 源 ^:pressed 无 Transitions，直接置 1 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- 禁用时把两层压回 0（WPF 禁用元素仍会报 IsMouseOver） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="DisabledReset">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="DisabledReset" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource IvControlBorderHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource IvSurfaceDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvStrokeBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvTextDisabledBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IvPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource IvButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource IvPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvTextOnPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource IvPrimaryHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvPrimaryHoverBrush}" />
            </MultiTrigger>
            <!-- 源 ^:pressed → PrimaryPressed（禁用态下 IsPressed 不会成立） -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource IvPrimaryPressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvPrimaryPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="FontWeight" Value="Normal" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IvDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource IvButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource IvControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IvDangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IvDangerTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource IvDangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource IvDangerBorderBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="FontWeight" Value="Normal" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IvSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource IvButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IvIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IvSubtleButtonStyle}">
        <Setter Property="Width" Value="{DynamicResource IvIconButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource IvIconButtonSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{DynamicResource IvIconSize}" />
        <Setter Property="Foreground" Value="{DynamicResource IvText2Brush}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IvDangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IvIconButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource IvDangerBrush}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource IvDangerSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource IvDangerBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
