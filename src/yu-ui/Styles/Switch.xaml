<!-- 源: Styles/Switch.axaml (76 行) | 转换: ControlTheme(x:Key)→Style, ColumnDefinitions→Grid.ColumnDefinitions, RenderTransform translateX→TranslateTransform.X 的 Storyboard(时长/缓动照抄源) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 开关：36×18 轨道 + 14×14 方块滑块，选中时滑块右移 18、强调层淡入 -->
    <Style x:Key="IvSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource IvText1Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource IvFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource IvFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource IvControlHeightSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Content"
                                          Margin="0,0,12,0"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Grid Grid.Column="1"
                              Width="36"
                              Height="18"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border x:Name="Track"
                                    CornerRadius="2"
                                    Background="{DynamicResource IvSwitchTrackBrush}"
                                    BorderBrush="{DynamicResource IvControlBorderBrush}"
                                    BorderThickness="1" />
                            <Border x:Name="TrackOn"
                                    CornerRadius="2"
                                    Background="{DynamicResource IvAccentBrush}"
                                    BorderBrush="{DynamicResource IvAccentBorderBrush}"
                                    BorderThickness="1"
                                    Opacity="0" />
                            <Border x:Name="Knob"
                                    Width="14"
                                    Height="14"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="1"
                                    Background="{DynamicResource IvThumbBrush}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 源 ^:checked：TrackOn 淡入 0:0:0.120 + Knob translateX(18px) 0:0:0.140 缓动。
                             WPF 的 ControlTemplate Trigger Setter 只能命中模板里的 FrameworkElement，
                             命不中 TranslateTransform 这种 Freezable，所以滑块位移改成 Margin 动画：
                             源 margin 2 + translateX 18 = 目标 margin 左值 20，几何结果完全等价。 -->
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 静态终态用 Setter 定死：动画只在过渡期间接管，
                                 否则离屏渲染/首帧/低刷新场合会停在 Opacity=0、Knob 未位移的“关”样。 -->
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SwitchOn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.120" />
                                        <ThicknessAnimation Storyboard.TargetName="Knob"
                                                            Storyboard.TargetProperty="Margin"
                                                            To="20,0,0,0"
                                                            Duration="0:0:0.140">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!-- 源取消选中时过渡随状态失效 → 瞬回原位；WPF 需显式停掉动画 -->
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SwitchOn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource IvControlBorderHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
