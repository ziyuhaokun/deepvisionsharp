<ui:FluentWindow
    x:Class="RuntimePackage.SetupHost.SetupShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RuntimePackage.SetupHost"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="安装向导"
    Width="920"
    Height="600"
    MinWidth="840"
    MinHeight="540"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="SetupLogItemTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="{DynamicResource SystemAccentColorPrimaryBrush}" />

                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    LineHeight="18"
                    Text="{Binding}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding WindowTitle}"
            ShowMaximize="False" />

        <!-- Main content: Left sidebar + Right page area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Branding -->
            <Border
                Grid.Column="0"
                Padding="28,44,28,32"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel
                    VerticalAlignment="Top"
                    Visibility="{Binding IsSidebarBrandingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Logo -->
                    <Border
                        Width="216"
                        Height="84"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Left"
                        CornerRadius="18"
                        Background="#101215"
                        BorderBrush="#1E252C"
                        BorderThickness="1"
                        Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="12">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding LogoImage}"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <!-- Product name -->
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding ProductTitle}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding VersionSummary}" />

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding Publisher}" />

                    <!-- Step indicator -->
                    <StackPanel Margin="0,40,0,0">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding StepsTitle}" />

                        <StackPanel Margin="0,16,0,0">
                            <!-- Welcome / Uninstall confirmation -->
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="8" Height="8"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Welcome">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="UninstallConfirm">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="License">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Options">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Installing">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Uninstalling">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Complete">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="13" Text="{Binding FirstStepText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Welcome">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="UninstallConfirm">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- License -->
                            <StackPanel
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding IsInstallMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Ellipse
                                    Width="8" Height="8"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="License">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Options">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Installing">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Complete">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="13" Text="许可协议">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="License">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Options -->
                            <StackPanel
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding IsInstallMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Ellipse
                                    Width="8" Height="8"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Options">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Installing">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Complete">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="13" Text="安装选项">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Options">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Installing / Uninstalling -->
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Ellipse
                                    Width="8" Height="8"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Installing">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Uninstalling">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Complete">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="13" Text="{Binding ActionStepText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Installing">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Uninstalling">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Complete -->
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Ellipse
                                    Width="8" Height="8"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Complete">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="13" Text="完成">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Complete">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Content: Page Area with DataTrigger-based switching -->
            <Border
                Grid.Column="1"
                Padding="40,32"
                Background="{DynamicResource ApplicationBackgroundBrush}">
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <!-- Default: Preparing -->
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding PreparationTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding PreparationText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Preparing Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Preparing">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="30"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding PreparationTitle}" />

                                                    <TextBlock
                                                        Margin="0,16,0,0"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding PreparationText}"
                                                        TextWrapping="Wrap" />

                                                    <ProgressBar
                                                        Margin="0,28,0,0"
                                                        Height="6"
                                                        IsIndeterminate="{Binding IsPreparationRunning}"
                                                        Visibility="{Binding IsPreparationRunning, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <Border
                                                        Margin="0,28,0,0"
                                                        Padding="12"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        MaxHeight="150"
                                                        Visibility="{Binding PreparationFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ScrollViewer
                                                            local:ScrollViewerBehavior.AutoScrollToBottom="True"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl
                                                                ItemTemplate="{StaticResource SetupLogItemTemplate}"
                                                                ItemsSource="{Binding Logs}" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Welcome Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Welcome">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        FontSize="34"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding ProductTitle, StringFormat=欢迎安装 {0}}" />

                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Margin="0,24,0,0"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding WelcomeText}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Uninstall Confirmation Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="UninstallConfirm">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="30"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding ProductTitle, StringFormat=卸载 {0}}" />

                                                    <TextBlock
                                                        Margin="0,18,0,0"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding UninstallSummary}"
                                                        TextWrapping="Wrap" />

                                                    <Border
                                                        Margin="0,26,0,0"
                                                        Padding="16"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Text="卸载位置" />
                                                            <TextBlock
                                                                Margin="0,8,0,0"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding InstallDirectory}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- License Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="License">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="许可协议" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
                                                        <TextBlock FontSize="13" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding LicenseText}" />
                                                    </ScrollViewer>
                                                    <CheckBox Grid.Row="2" Content="我已阅读并接受许可协议"
                                                              IsChecked="{Binding LicenseAccepted}" />
                                                </Grid>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Options Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Options">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="安装选项" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                                    <!-- Install directory -->
                                                    <TextBlock Margin="0,24,0,8" FontSize="14" FontWeight="Medium" Text="安装目录"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ui:Button Grid.Column="2" Content="浏览" Appearance="Secondary"
                                                                   Command="{Binding BrowseCommand}" />
                                                    </Grid>

                                                    <!-- Disk space -->
                                                    <TextBlock Margin="0,8,0,0" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding DiskSpaceInfo}" />

                                                    <!-- Shortcuts -->
                                                    <TextBlock Margin="0,24,0,8" FontSize="14" FontWeight="Medium" Text="快捷方式"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <CheckBox Margin="0,4,0,0" Content="创建开始菜单快捷方式"
                                                              IsChecked="{Binding CreateStartMenuShortcut}" />
                                                    <CheckBox Margin="0,8,0,0" Content="创建桌面快捷方式"
                                                              IsChecked="{Binding CreateDesktopShortcut}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Installing Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Installing">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="正在安装" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Margin="0,16,0,0" FontSize="14"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding ProgressText}" />
                                                    <ProgressBar Margin="0,24,0,0" Height="6" Value="{Binding InstallProgress, Mode=OneWay}" Maximum="100" />

                                                    <!-- Log area -->
                                                    <Border Margin="0,24,0,0" Padding="16" CornerRadius="6"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            MaxHeight="200">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="安装详情" />

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    Text="{Binding InstallProgress, StringFormat={}{0}%}" />
                                                            </Grid>

                                                            <Border
                                                                Grid.Row="1"
                                                                Height="1"
                                                                Margin="0,10,0,10"
                                                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                                            <ScrollViewer
                                                                Grid.Row="2"
                                                                local:ScrollViewerBehavior.AutoScrollToBottom="True"
                                                                HorizontalScrollBarVisibility="Disabled"
                                                                VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl
                                                                    ItemTemplate="{StaticResource SetupLogItemTemplate}"
                                                                    ItemsSource="{Binding Logs}" />
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Uninstalling Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Uninstalling">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="正在卸载" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Margin="0,16,0,0" FontSize="14"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding ProgressText}" />
                                                    <ProgressBar Margin="0,24,0,0" Height="6" Value="{Binding InstallProgress, Mode=OneWay}" Maximum="100" />

                                                    <Border Margin="0,24,0,0" Padding="16" CornerRadius="6"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            MaxHeight="200">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="卸载详情" />

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    Text="{Binding InstallProgress, StringFormat={}{0}%}" />
                                                            </Grid>

                                                            <Border
                                                                Grid.Row="1"
                                                                Height="1"
                                                                Margin="0,10,0,10"
                                                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                                            <ScrollViewer
                                                                Grid.Row="2"
                                                                local:ScrollViewerBehavior.AutoScrollToBottom="True"
                                                                HorizontalScrollBarVisibility="Disabled"
                                                                VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl
                                                                    ItemTemplate="{StaticResource SetupLogItemTemplate}"
                                                                    ItemsSource="{Binding Logs}" />
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Complete Page -->
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Complete">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <!-- Success -->
                                                    <StackPanel Visibility="{Binding IsInstallSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding CompleteTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding CompleteMessage}" />
                                                        <StackPanel Visibility="{Binding ShowPostInstallActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <CheckBox Margin="0,24,0,0" Content="安装完成后启动程序"
                                                                      IsChecked="{Binding LaunchOnComplete}" />
                                                            <CheckBox Margin="0,8,0,0" Content="打开安装目录"
                                                                      IsChecked="{Binding OpenInstallDirectory}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Failure -->
                                                    <StackPanel Visibility="{Binding IsInstallFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding CompleteTitle}" Foreground="#E74856" />
                                                        <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding CompleteMessage}" />
                                                        <Border Margin="0,16,0,0" Padding="12" CornerRadius="6"
                                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       Text="{Binding FailureDetail}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.Content>
                        <Binding />
                    </ContentControl.Content>
                </ContentControl>
            </Border>

            <!-- Preparing overlay hides product-specific content until the package is trusted. -->
            <Border
                Grid.ColumnSpan="2"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Visibility="{Binding IsPreparationOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding PreparationOverlayTitle}" />

                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding PreparationText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <ProgressBar
                        Margin="0,28,0,0"
                        Height="6"
                        IsIndeterminate="{Binding IsPreparationRunning}" />

                    <Border
                        Margin="0,28,0,0"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        MaxHeight="150"
                        Visibility="{Binding PreparationFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer
                            local:ScrollViewerBehavior.AutoScrollToBottom="True"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                ItemTemplate="{StaticResource SetupLogItemTemplate}"
                                ItemsSource="{Binding Logs}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Navigation Bar -->
        <Border
            Grid.Row="2"
            Padding="320,16,32,16"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <ui:Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Appearance="Secondary"
                    Content="返回"
                    Command="{Binding BackCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Next button (Welcome, License pages) -->
                <ui:Button
                    Grid.Column="1"
                    MinWidth="110"
                    Appearance="Primary"
                    Content="{Binding NextButtonText}"
                    Command="{Binding NextCommand}"
                    Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Finish button (Complete page) -->
                <ui:Button
                    Grid.Column="1"
                    MinWidth="110"
                    Appearance="Primary"
                    Content="完成"
                    Command="{Binding FinishCommand}"
                    Visibility="{Binding IsFinishVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Cancel / Close button -->
                <ui:Button
                    Grid.Column="3"
                    MinWidth="90"
                    Appearance="Secondary"
                    Content="{Binding CloseButtonText}"
                    Command="{Binding CloseCommand}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding IsPreparationOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- ContentDialog host -->
        <ui:ContentDialogHost
            x:Name="RootContentDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
