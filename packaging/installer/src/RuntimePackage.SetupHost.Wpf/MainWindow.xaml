<Window
    x:Class="RuntimePackage.SetupHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="安装向导"
    Width="760"
    Height="560"
    MinWidth="680"
    MinHeight="500"
    WindowStartupLocation="CenterScreen">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,20" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ProductTitle}" />
                    <TextBlock Margin="0,6,0,0" Foreground="#475569" Text="{Binding PublisherText}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,5" VerticalAlignment="Center" Background="#DBEAFE" CornerRadius="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding StatusText}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Text="安装位置" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox MinHeight="34" Padding="8,6" Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" MinWidth="84" Padding="14,7" Click="OnBrowseInstallDirectory" Content="浏览" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Text="安装选项" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <CheckBox Margin="0,0,24,0" Content="创建开始菜单快捷方式" IsChecked="{Binding CreateStartMenuShortcut}" />
                        <CheckBox Content="创建桌面快捷方式" IsChecked="{Binding CreateDesktopShortcut}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Padding="18" Background="#0B1220" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#E2E8F0" Text="安装日志" />
                    <ListBox
                        Grid.Row="2"
                        Background="#0B1220"
                        BorderBrush="#1E293B"
                        Foreground="#D1FAE5"
                        ItemsSource="{Binding Logs}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="24,16" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" MinWidth="96" Padding="16,8" Click="OnClose" Content="关闭" />
                <Button Grid.Column="3" MinWidth="120" Padding="18,8" Background="#2563EB" BorderBrush="#2563EB" Click="OnInstall" Content="安装" Foreground="#FFFFFF" IsEnabled="{Binding CanInstall}" />
            </Grid>
        </Border>
    </Grid>
</Window>
